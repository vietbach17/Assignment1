@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tổng quan Giảng viên";
    ViewBag.ActiveMenu = "LecturerHome";

    var lecturerDocs = ViewBag.LecturerDocuments as List<DocumentDto> ?? new List<DocumentDto>();
    var recentDocs = ViewBag.LecturerRecentDocs as List<DocumentDto> ?? new List<DocumentDto>();
    var lecturerSubjects = ViewBag.LecturerSubjects as List<SubjectDto> ?? new List<SubjectDto>();
    int totalDocs = ViewBag.LecturerTotalDocs ?? 0;
    int indexedDocs = ViewBag.LecturerIndexedDocs ?? 0;
    int subjectCount = ViewBag.LecturerSubjectCount ?? 0;

    string StatusBadge(DocumentStatus s) => s switch
    {
        DocumentStatus.Indexed => "badge-green",
        DocumentStatus.Pending => "badge-yellow",
        _ => "badge-red"
    };
    string FileBadge(string ft) => ft switch
    {
        "pdf" => "badge-red",
        "docx" => "badge-blue",
        "pptx" => "badge-yellow",
        _ => "badge-gray"
    };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">KHÔNG GIAN GIẢNG VIÊN</div>
            <h1 class="page-title">Tổng quan</h1>
            <p class="page-subtitle">Theo dõi tài liệu và môn học bạn phụ trách.</p>
        </div>
        <a asp-action="Upload" asp-controller="Document" class="brutal-btn btn-pink"><i class="fa-solid fa-upload"></i> Tải tài liệu mới</a>
    </div>

    <!-- Stats -->
    <div class="stat-grid">
        <a asp-action="Index" asp-controller="Subjects" class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Môn phụ trách</span>
                <div class="stat-icon" style="background:var(--green); color:var(--white);"><i class="fa-solid fa-book"></i></div>
            </div>
            <div class="stat-value">@subjectCount</div>
            <div class="page-subtitle">môn học được giao</div>
        </a>
        <a asp-action="Index" asp-controller="Document" class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Tổng tài liệu</span>
                <div class="stat-icon" style="background:var(--yellow);"><i class="fa-solid fa-file-lines"></i></div>
            </div>
            <div class="stat-value">@totalDocs</div>
            <div class="page-subtitle">file đã upload</div>
        </a>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Đã Indexed</span>
                <div class="stat-icon" style="background:var(--blue); color:var(--white);"><i class="fa-solid fa-circle-check"></i></div>
            </div>
            <div class="stat-value text-green">@indexedDocs</div>
            <div class="page-subtitle">@(totalDocs > 0 ? $"{(int)Math.Round(indexedDocs * 100.0 / totalDocs)}% tổng số" : "chưa có tài liệu")</div>
        </div>
    </div>

    <!-- Recent docs -->
    <div class="brutal-card pad0" style="margin-bottom:25px;">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
            <h3 class="card-title">Tài liệu gần đây</h3>
            <a asp-action="Index" asp-controller="Document" class="brutal-btn sm">Xem tất cả</a>
        </div>
        <div style="padding:15px 20px;">
            @if (!recentDocs.Any())
            {
                <div style="padding:32px; text-align:center;">
                    <i class="fa-regular fa-folder-open" style="font-size:34px; color:#ccc;"></i>
                    <p class="text-muted" style="margin-top:10px; font-weight:800;">Bạn chưa upload tài liệu nào.</p>
                    <a asp-action="Upload" asp-controller="Document" class="brutal-btn btn-pink sm" style="margin-top:10px;"><i class="fa-solid fa-upload"></i> Tải lên ngay</a>
                </div>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:10px;">
                    @foreach (var doc in recentDocs)
                    {
                        <a asp-action="Details" asp-controller="Document" asp-route-id="@doc.Id"
                           style="display:flex; align-items:center; justify-content:space-between; padding:12px; border:2px solid var(--black); text-decoration:none; color:var(--black); background:var(--white);">
                            <div style="display:flex; align-items:center; gap:12px; min-width:0;">
                                <span class="badge @FileBadge(doc.FileType)">@doc.FileType.ToUpper()</span>
                                <div style="min-width:0;">
                                    <div style="font-weight:900;">@doc.Title</div>
                                    <div class="page-subtitle">@doc.FileSizeDisplay · @doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                            <span class="badge @StatusBadge(doc.Status)">@doc.Status</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:25px;">
        <!-- Subjects -->
        <div class="brutal-card pad0">
            <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
                <h3 class="card-title"><i class="fa-solid fa-book text-green"></i> Môn học phụ trách</h3>
                <span class="badge badge-green">@subjectCount môn</span>
            </div>
            @if (!lecturerSubjects.Any())
            {
                <div style="padding:32px; text-align:center;">
                    <i class="fa-solid fa-book-open" style="font-size:34px; color:#ccc;"></i>
                    <p class="text-muted" style="margin-top:10px; font-weight:800;">Chưa được phân công môn học nào.</p>
                </div>
            }
            else
            {
                <div style="padding:12px 20px;">
                    @foreach (var subject in lecturerSubjects)
                    {
                        int docCount = lecturerDocs.Count(d => d.SubjectId == subject.Id);
                        <a asp-action="Details" asp-controller="Subjects" asp-route-id="@subject.Id"
                           style="display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px dashed #ccc; text-decoration:none; color:var(--black);">
                            <div>
                                <div style="font-weight:900;">@subject.SubjectCode</div>
                                <div class="page-subtitle">@subject.SubjectName</div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-weight:900;">@docCount</div>
                                <div class="page-subtitle">tài liệu</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <!-- All docs -->
        <div class="brutal-card pad0">
            <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
                <h3 class="card-title"><i class="fa-solid fa-file-lines text-pink"></i> Tất cả tài liệu</h3>
                <a asp-action="Index" asp-controller="Document" class="brutal-btn sm">Quản lý</a>
            </div>
            @if (!lecturerDocs.Any())
            {
                <div style="padding:32px; text-align:center;">
                    <i class="fa-regular fa-folder-open" style="font-size:34px; color:#ccc;"></i>
                    <p class="text-muted" style="margin-top:10px; font-weight:800;">Chưa có tài liệu nào.</p>
                </div>
            }
            else
            {
                <div style="max-height:340px; overflow-y:auto; padding:15px 20px;">
                    <table class="brutal-table">
                        <thead>
                            <tr><th>Tiêu đề</th><th>Môn</th><th>Trạng thái</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in lecturerDocs.OrderByDescending(d => d.UploadedDate))
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span class="badge @FileBadge(doc.FileType)">@doc.FileType.ToUpper()</span>
                                            <span style="font-weight:900;">@doc.Title</span>
                                        </div>
                                        <div class="page-subtitle" style="margin-top:2px;">@doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td>@doc.SubjectCode</td>
                                    <td><span class="badge @StatusBadge(doc.Status)">@doc.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
