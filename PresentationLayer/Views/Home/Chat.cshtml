@{
    ViewData["Title"] = "AI Chat Helper";
}

<style>
    /* Full Screen Override */
    main {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        height: calc(100vh - 73px);
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
    }
    footer { display: none !important; }

    /* Theme Variables */
    :root {
        --bg-main: #131316;
        --bg-panel: #1c1c21;
        --bg-input: #27272f;
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
        --accent: #5b4ff0;
        --accent-hover: #4a3ee0;
        --border-color: #2e2e36;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
    }

    .quirkle-layout {
        display: grid;
        grid-template-columns: 260px 1fr 280px;
        height: 100%;
        width: 100%;
        background-color: var(--bg-main);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* Left Sidebar */
    .left-sidebar {
        background-color: var(--bg-panel);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        gap: 0.75rem;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1rem;
        padding: 0 0.5rem;
        color: white;
    }
    .brand-icon {
        width: 28px;
        height: 28px;
        background-color: var(--accent);
        border-radius: 8px;
        display: grid;
        place-items: center;
    }

    .nav-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        width: 100%;
        text-align: left;
    }
    .nav-btn:hover {
        background-color: rgba(255,255,255,0.05);
        color: var(--text-main);
    }
    .nav-btn.active {
        background-color: rgba(255,255,255,0.05);
        color: var(--text-main);
        border: 1px solid var(--border-color);
    }
    .nav-badge {
        margin-left: auto;
        font-size: 0.7rem;
        background: var(--bg-input);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        color: var(--text-muted);
    }

    .pro-card {
        margin-top: auto;
        background: linear-gradient(145deg, #2a2a35 0%, #4c3cc2 100%);
        border-radius: 12px;
        padding: 1.25rem;
        position: relative;
        overflow: hidden;
        color: white;
    }
    .pro-card h4 { margin: 0 0 0.5rem 0; font-size: 1.1rem; }
    .pro-card p { margin: 0 0 1rem 0; font-size: 0.85rem; color: rgba(255,255,255,0.8); line-height: 1.4; }
    .pro-card .price { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; }
    .pro-card button {
        width: 100%;
        padding: 0.75rem;
        background: white;
        color: black;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    /* Main Area */
    .main-area {
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        background-color: var(--bg-main);
    }

    .main-header {
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-main);
    }
    .main-header h2 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
        color: white;
    }
    .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .search-box {
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
    }
    .search-box input {
        background: transparent;
        border: none;
        color: white;
        outline: none;
        font-size: 0.85rem;
        width: 150px;
    }
    .icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        display: grid;
        place-items: center;
        cursor: pointer;
    }
    .icon-btn:hover { background: rgba(255,255,255,0.1); color: white; }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .message { display: flex; gap: 1rem; max-width: 85%; }
    .message-sent { align-self: flex-end; flex-direction: row-reverse; }
    .message-received { align-self: flex-start; width: 100%; }

    .message-bubble {
        padding: 1.25rem;
        border-radius: 12px;
        background-color: var(--bg-panel);
        border: 1px solid var(--border-color);
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text-main);
    }
    .message-sent .message-bubble {
        background-color: var(--bg-input);
    }

    /* Code block styling matching image */
    .code-block {
        background: #18181b;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1rem;
        border: 1px solid var(--border-color);
    }
    .code-header {
        display: flex;
        justify-content: space-between;
        background: #1f1f24;
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border-color);
    }
    .code-tabs { display: flex; gap: 1rem; }
    .code-tab { cursor: pointer; padding: 0.25rem 0.5rem; border-radius: 4px; }
    .code-tab.active { color: var(--accent); background: rgba(91, 79, 240, 0.15); font-weight: 500; }
    .code-content {
        padding: 1rem;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.85rem;
        line-height: 1.6;
        overflow-x: auto;
    }
    .code-line { display: flex; gap: 1rem; }
    .line-num { color: #52525b; user-select: none; width: 1.5rem; text-align: right; }
    .code-text { color: #e4e4e7; }
    .keyword { color: #2dd4bf; }
    .string { color: #fdba74; }
    .function { color: #93c5fd; }

    /* Input Area */
    .input-container {
        padding: 1rem 2rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .regen-btn {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .regen-btn:hover { background: var(--accent-hover); }

    .input-box {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .input-box input {
        flex: 1;
        background: transparent;
        border: none;
        color: white;
        padding: 0.5rem 0.5rem 0.5rem 1rem;
        outline: none;
        font-size: 0.95rem;
    }
    .send-btn {
        width: 36px;
        height: 36px;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        display: grid;
        place-items: center;
        cursor: pointer;
    }
    .send-btn:hover { background: var(--accent-hover); }
    .input-footer {
        font-size: 0.75rem;
        color: #52525b;
        text-align: center;
    }

    /* Right Sidebar */
    .right-sidebar {
        background-color: var(--bg-panel);
        border-left: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
    }
    .history-header h3 { font-size: 1.05rem; margin: 0; color: white; font-weight: 600; }
    .history-count { font-size: 0.75rem; color: var(--text-muted); background: var(--bg-input); padding: 0.25rem 0.6rem; border-radius: 12px; }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        overflow-y: auto;
        flex: 1;
    }

    .history-item {
        padding: 0.85rem;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        gap: 0.75rem;
        border: 1px solid transparent;
    }
    .history-item:hover { background: rgba(255,255,255,0.03); }
    .history-item.active { background: var(--bg-input); border: 1px solid var(--border-color); }
    
    .history-icon {
        width: 18px;
        height: 18px;
        border: 1.5px solid var(--text-muted);
        border-radius: 4px;
        margin-top: 0.1rem;
        flex-shrink: 0;
    }
    .history-content h4 { margin: 0 0 0.35rem 0; font-size: 0.9rem; color: white; }
    .history-content p { margin: 0; font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }

    .clear-history {
        margin-top: 1rem;
        padding: 0.85rem;
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.2s;
    }
    .clear-history:hover { background: rgba(255,255,255,0.05); color: white; }

    @@media (max-width: 992px) {
        .quirkle-layout {
            grid-template-columns: 1fr;
        }
        .left-sidebar, .right-sidebar {
            display: none !important;
        }
        main {
            height: 100vh !important;
        }
    }
</style>

