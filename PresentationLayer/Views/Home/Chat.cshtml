@{
    ViewData["Title"] = "Không gian trò chuyện trực tuyến";
}

<div class="chat-container">
    <div class="welcome-banner glass-card">
        <div class="banner-text">
            <h1>💬 Kênh Thảo Luận Học Viên (Student Workspace)</h1>
            <p>Xin chào Học viên! Đây là kênh thảo luận nhóm và trao đổi trực tiếp với giảng viên và trợ lý học tập AI.</p>
        </div>
        <span class="banner-badge role-badge role-student">Học Tập</span>
    </div>

    <div class="chat-workspace">
        <!-- Sidebar - Channels / Active Users -->
        <div class="glass-card chat-sidebar">
            <h3 class="sidebar-title">👥 Đang trực tuyến (Online)</h3>
            <ul class="user-list">
                <li class="user-item">
                    <span class="avatar avatar-bot">🤖</span>
                    <div class="user-details">
                        <span class="user-name">Trợ lý Học tập AI</span>
                        <span class="user-status online">Đang hoạt động</span>
                    </div>
                </li>
                <li class="user-item">
                    <span class="avatar">👨‍🏫</span>
                    <div class="user-details">
                        <span class="user-name">Giảng viên phụ trách</span>
                        <span class="user-status offline">Ngoại tuyến</span>
                    </div>
                </li>
                <li class="user-item active">
                    <span class="avatar">👤</span>
                    <div class="user-details">
                        <span class="user-name">Bạn (@User.Identity?.Name)</span>
                        <span class="user-status online">Đang kết nối</span>
                    </div>
                </li>
            </ul>
        </div>

        <!-- Chat Main Area -->
        <div class="glass-card chat-main">
            <!-- Messages List -->
            <div class="chat-messages" id="chatMessages">
                <!-- System Log -->
                <div class="system-message">
                    <span>Phiên kết nối bảo mật bằng mã hóa Cookie đã được thiết lập thành công.</span>
                </div>

                <!-- Message 1: AI Bot -->
                <div class="message message-received">
                    <span class="message-avatar">🤖</span>
                    <div class="message-bubble">
                        <p>Chào mừng <strong>@User.Identity?.Name</strong> đã đăng nhập thành công với vai trò <strong>Student</strong>!</p>
                        <p>Tôi là Trợ lý Học tập AI. Bạn có câu hỏi nào về nội dung bài học hoặc kiến trúc ASP.NET Core MVC 3-Layers không?</p>
                        <span class="message-time">Vừa xong</span>
                    </div>
                </div>

                <!-- Message 2: Student User -->
                <div class="message message-sent">
                    <div class="message-bubble">
                        <p>Chào Trợ lý! Cho mình hỏi hệ thống xác thực Cookie này hoạt động như thế nào vậy?</p>
                        <span class="message-time">Vừa xong</span>
                    </div>
                </div>

                <!-- Message 3: AI Bot Reply -->
                <div class="message message-received">
                    <span class="message-avatar">🤖</span>
                    <div class="message-bubble">
                        <p>Hệ thống hoạt động theo quy trình cực kỳ chặt chẽ:</p>
                        <ol style="margin-left: 1.25rem; margin-top: 0.25rem; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.25rem;">
                            <li>Bạn gửi thông tin đăng nhập lên <strong>AuthController</strong>.</li>
                            <li><strong>AuthService</strong> so khớp mật khẩu băm bằng <strong>BCrypt</strong> thông qua <strong>UserRepository</strong>.</li>
                            <li>Nếu hợp lệ, <strong>AuthController</strong> tạo ra danh sách <strong>Claims</strong> (bao gồm tên và quyền hạn của bạn).</li>
                            <li>Hệ thống ASP.NET Core MVC mã hóa thông tin đó thành <strong>Cookie bảo mật</strong> và lưu trữ ở trình duyệt.</li>
                            <li>Ở các request tiếp theo, Cookie được tự động gửi kèm và middleware sẽ tự phân quyền truy cập.</li>
                        </ol>
                        <span class="message-time">Vừa xong</span>
                    </div>
                </div>
            </div>

            <!-- Message Input Form -->
            <div class="chat-input-area">
                <input type="text" placeholder="Nhập tin nhắn thảo luận của bạn tại đây..." id="messageInput" onkeypress="handleKeyPress(event)" />
                <button class="btn-primary" onclick="sendMessage()">Gửi tin ➜</button>
            </div>
        </div>
    </div>
</div>

<script>
        function sendMessage() 
        {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if (text === '') return;

            // GỌI LÊN BACKEND KIỂM TRA QUYỀN VÀ TRỪ LƯỢT HỎI TRƯỚC
            fetch('/Home/VerifyAndDeductQuestion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                }
            })
            .then(response => response.json())
            .then(data => {
                const chatMessages = document.getElementById('chatMessages');

                if (data.success === false) {
                    // Nếu hết lượt hỏi, in thông báo lỗi màu đỏ của hệ thống vào khung chat
                    const errDiv = document.createElement('div');
                    errDiv.className = 'system-message';
                    errDiv.innerHTML = `<span style="color: #fca5a5; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2)">⚠️ ${data.message} <a href="/Subscription" style="color: #60a5fa; text-decoration: underline;">Nâng cấp gói ngay</a></span>`;
                    chatMessages.appendChild(errDiv);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                    return; // Chặn không cho gửi tin nhắn đi
                }

                // --- NẾU HỢP LỆ VÀ TRỪ ĐIỂM THÀNH CÔNG -> HIỂN THỊ TIN NHẮN USER ---
                const sentDiv = document.createElement('div');
                sentDiv.className = 'message message-sent';
                sentDiv.innerHTML = `
                    <div class="message-bubble">
                        <p>${escapeHtml(text)}</p>
                        <span class="message-time">Vừa xong (Lượt hỏi còn lại: ${data.remaining >= 9999 ? '∞' : data.remaining})</span>
                    </div>
                `;
                chatMessages.appendChild(sentDiv);

                input.value = '';
                chatMessages.scrollTop = chatMessages.scrollHeight;

                // Phản hồi giả lập của Bot (Giai đoạn Assignment 2 sẽ đổi đoạn này thành gọi API AI RAG thật)
                setTimeout(() => {
                    const replyDiv = document.createElement('div');
                    replyDiv.className = 'message message-received';
                    replyDiv.innerHTML = `
                        <span class="message-avatar">🤖</span>
                        <div class="message-bubble">
                            <p>Cảm ơn bạn đã đặt câu hỏi! Hệ thống đã ghi nhận và tự động trừ 1 câu hỏi vào Postgres Database thành công.</p>
                            <span class="message-time">Vừa xong</span>
                        </div>
                    `;
                    chatMessages.appendChild(replyDiv);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }, 1000);
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }

    function handleKeyPress(event) {
        if (event.key === 'Enter') {
            sendMessage();
        }
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .welcome-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2.5rem;
        background: linear-gradient(135deg, rgba(22, 30, 49, 0.7) 0%, rgba(16, 185, 129, 0.1) 100%);
    }

    .banner-text h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .banner-text p {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .banner-badge {
        font-size: 0.9rem;
        padding: 0.4rem 1rem;
    }

    /* Chat Workspace */
    .chat-workspace {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2rem;
        height: 550px;
    }

    @@media (max-width: 768px) {
        .chat-workspace {
            grid-template-columns: 1fr;
            height: auto;
        }
    }

    /* Sidebar */
    .chat-sidebar {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        height: 100%;
        overflow-y: auto;
    }

    .sidebar-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #ffffff;
    }

    .user-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        list-style: none;
    }

    .user-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        transition: var(--transition-smooth);
        cursor: pointer;
    }

    .user-item:hover {
        background-color: rgba(255, 255, 255, 0.04);
    }

    .user-item.active {
        background-color: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        border: 1px solid var(--border-color);
    }

    .avatar-bot {
        background-color: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.2);
    }

    .user-details {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .user-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: #ffffff;
    }

    .user-status {
        font-size: 0.75rem;
    }

    .user-status.online {
        color: #34d399;
    }

    .user-status.offline {
        color: var(--text-secondary);
    }

    /* Chat Main Area */
    .chat-main {
        padding: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .chat-messages {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        background-color: rgba(0, 0, 0, 0.15);
    }

    .system-message {
        text-align: center;
        margin: 0.5rem 0;
    }

    .system-message span {
        background-color: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color);
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .message {
        display: flex;
        gap: 1rem;
        max-width: 80%;
    }

    .message-received {
        align-self: flex-start;
    }

    .message-sent {
        align-self: flex-end;
        justify-content: flex-end;
    }

    .message-avatar {
        font-size: 1.5rem;
    }

    .message-bubble {
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-color);
        padding: 1rem;
        border-radius: 16px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .message-sent .message-bubble {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%);
        border-color: rgba(168, 85, 247, 0.3);
        border-bottom-right-radius: 4px;
        color: #ffffff;
    }

    .message-received .message-bubble {
        border-bottom-left-radius: 4px;
    }

    .message-bubble p {
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .message-time {
        font-size: 0.7rem;
        color: var(--text-secondary);
        align-self: flex-end;
    }

    /* Input Area */
    .chat-input-area {
        padding: 1.25rem 2rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        gap: 1rem;
        align-items: center;
        background-color: var(--bg-secondary);
    }

    .chat-input-area input {
        flex: 1;
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-color);
        color: #ffffff;
        padding: 0.85rem 1.25rem;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: inherit;
        transition: var(--transition-smooth);
    }

    .chat-input-area input:focus {
        outline: none;
        border-color: var(--accent-emerald);
        background-color: rgba(255, 255, 255, 0.06);
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
    }
</style>
