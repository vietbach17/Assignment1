<div class="breadcrumb">
    <a asp-action="Subjects">Môn học</a>
    <span class="breadcrumb-separator">›</span>
    <span>@ViewBag.SubjectName</span>
</div>

<div class="subject-header">
    <div class="subject-code-badge">@ViewBag.SubjectCode</div>
    <h1 class="subject-title">@ViewBag.SubjectName</h1>
    @if (!string.IsNullOrEmpty(ViewBag.SubjectDescription))
    {
        <p class="subject-desc">@ViewBag.SubjectDescription</p>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.Any())
{
    <div class="chapters-list">
        @foreach (var chapter in Model.OrderBy(c => c.ChapterNumber))
        {
            <div class="chapter-item">
                <div class="chapter-info">
                    <div class="chapter-number">Chapter @chapter.ChapterNumber</div>
                    <h3 class="chapter-title">@chapter.ChapterTitle</h3>
                    @if (!string.IsNullOrEmpty(chapter.Description))
                    {
                        <p class="chapter-desc">@chapter.Description</p>
                    }
                </div>
                <a asp-action="Documents" asp-route-chapterId="@chapter.Id" class="btn-view-documents">
                    Xem tài liệu →
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
