@using BussinessLayer.DTOs
@model IEnumerable<BussinessLayer.DTOs.DocumentDto>
@{
    Layout = null;
    ViewBag.ActiveMenu = "Docs";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách Tài liệu - EduManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800;900&display=swap');
        
        :root {
            --pink: #eb2f64; --yellow: #f4cf45; --green: #5cb85c; 
            --blue: #4fa8db; --black: #000; --white: #fff; --bg: #f4f4f6;
            --border: 3px solid var(--black);
            --shadow: 4px 4px 0px 0px var(--black);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        
        body {
            background-color: var(--bg);
            display: flex; min-height: 100vh; color: var(--black);
            background-image: radial-gradient(#d1d1d1 2px, transparent 2px);
        }

        /* Tùy chỉnh thanh Sidebar */
        .sidebar {
            width: 260px; background: var(--white); border-right: var(--border);
            padding: 30px 20px; display: flex; flex-direction: column; gap: 15px;
            position: sticky; top: 0; height: 100vh;
        }
        .logo { color: var(--pink); font-size: 22px; font-weight: 900; margin-bottom: 20px; }
        .nav-item {
            padding: 12px 15px; font-weight: 800; color: var(--black);
            text-decoration: none; display: flex; align-items: center; gap: 12px;
            border: 3px solid transparent; transition: 0.1s;
        }
        .nav-item.active {
            background: var(--pink); color: var(--white);
            border-color: var(--black); box-shadow: var(--shadow);
        }
        .nav-item:not(.active):hover { border-color: var(--black); transform: translate(-2px, -2px); box-shadow: var(--shadow); }

        /* USER PROFILE NEO-BRUTALISM */
        .user-profile {
            margin-top: auto; 
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            background-color: var(--white);
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
        }
        .avatar-box {
            width: 36px; height: 36px; background-color: var(--pink); 
            border: 2px solid var(--black); display: flex; align-items: center; justify-content: center;
            color: var(--white); font-size: 14px; flex-shrink: 0;
        }
        .user-info { display: flex; flex-direction: column; overflow: hidden; }
        .user-info .username { font-weight: 800; font-size: 12px; color: var(--black); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
        .user-info .role { font-weight: 700; font-size: 10px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

        /* Vùng nội dung chính */
        .main-content { flex: 1; padding: 40px; }
        
        .title-page { font-size: 28px; font-weight: 900; margin-bottom: 20px; text-transform: uppercase; }
        .badge { border: 2px solid var(--black); padding: 5px 15px; font-size: 14px; font-weight: 800; background: var(--yellow); }

        /* Document Item Neo-Brutalism */
        .doc-item {
            background: var(--white); border: var(--border); box-shadow: 6px 6px 0px 0px var(--black); 
            padding: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;
            transition: all 0.1s;
        }
        .doc-item:hover {
            transform: translate(-2px, -2px);
            box-shadow: 8px 8px 0px 0px var(--black);
        }

        .doc-icon {
            width: 50px; height: 50px; border: var(--border); display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;
        }
        .icon-pdf { background-color: #ffcccb; color: #d32f2f; }
        .icon-docx { background-color: #bbdefb; color: #1976d2; }
        .icon-pptx { background-color: #ffccbc; color: #e64a19; }
        .icon-default { background-color: #f5f5f5; color: #616161; }

        .doc-info { flex: 1; margin-left: 20px; }
        .doc-title { font-weight: 900; font-size: 16px; margin-bottom: 5px; color: var(--black); }
        .doc-meta { font-size: 13px; font-weight: 700; color: #444; display: flex; gap: 10px; flex-wrap: wrap; }
        .doc-meta span { background: #e0e0e0; padding: 3px 8px; border: 1px solid var(--black); border-radius: 4px; }
        
        .doc-actions { display: flex; gap: 10px; }
        
        .btn-action {
            border: 2px solid var(--black); font-weight: 800; cursor: pointer; box-shadow: 2px 2px 0px 0px var(--black); 
            padding: 8px 15px; text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--black);
            transition: 0.1s;
        }
        .btn-action:active { transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--black); }
        .btn-view { background-color: var(--blue); color: var(--white); }
        .btn-download { background-color: var(--green); color: var(--black); }

    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo"><i class="fa-solid fa-graduation-cap"></i> EduManager</div>
        <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Overview" ? "active" : "")"><i class="fa-solid fa-border-all"></i> TỔNG QUAN</a>
        <a asp-controller="StudentDocument" asp-action="Subjects" class="nav-item @(ViewBag.ActiveMenu == "Subjects" ? "active" : "")"><i class="fa-solid fa-book-open"></i> MÔN HỌC</a>
        <a asp-controller="StudentDocument" asp-action="Documents"  class="nav-item @(ViewBag.ActiveMenu == "Docs" ? "active" : "")"><i class="fa-regular fa-file-lines"></i> TÀI LIỆU</a>
        <a asp-controller="Home" asp-action="Chat"  class="nav-item @(ViewBag.ActiveMenu == "AI" ? "active" : "")"><i class="fa-solid fa-robot"></i> CHAT AI</a>
        <a asp-controller="Subscription" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Subscription" ? "active" : "")"><i class="fa-solid fa-crown"></i> GÓI HỘI VIÊN</a>
        
        <div class="user-profile">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="avatar-box">
                    <i class="fa-solid fa-user"></i> 
                </div>
                <div class="user-info">
                    <div class="username">@User.Identity.Name</div>
                    <div class="role">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
            }
        </div>
        <a asp-controller="Auth" asp-action="Logout" class="nav-item" style="border:dashed 2px var(--black);">Log out</a>      
    </div>
    
    <div class="main-content">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #000; padding-bottom: 15px; margin-bottom: 30px;">
            <h1 class="title-page" style="margin: 0;">DANH SÁCH TÀI LIỆU <i class="fa-solid fa-folder-open" style="color: #666;"></i></h1>
            @if (ViewBag.ChapterTitle != null)
            {
                <span class="badge">CHƯƠNG: @ViewBag.ChapterTitle</span>
            }
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background: #ffcccb; border: var(--border); box-shadow: 4px 4px 0px 0px var(--black); padding: 15px; font-weight: 800; margin-bottom: 25px; color: #d32f2f;">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div style="text-align: center; padding: 60px; background: var(--white); border: var(--border); box-shadow: 6px 6px 0px 0px var(--black);">
                <i class="fa-regular fa-folder-open" style="font-size: 60px; margin-bottom: 20px; color: var(--pink);"></i>
                <h3 style="font-weight: 900; font-size: 22px;">Chưa có tài liệu nào</h3>
                <p style="font-weight: 700; color: #555; margin-top: 10px;">Hiện tại chương này chưa có tài liệu nào được tải lên.</p>
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 5px;">
                @foreach (var doc in Model)
                {
                    <div class="doc-item">
                        <div style="display: flex; align-items: center; flex: 1;">
                            @if (doc.FileType == "pdf")
                            {
                                <div class="doc-icon icon-pdf"><i class="fa-solid fa-file-pdf"></i></div>
                            }
                            else if (doc.FileType == "docx")
                            {
                                <div class="doc-icon icon-docx"><i class="fa-solid fa-file-word"></i></div>
                            }
                            else if (doc.FileType == "pptx")
                            {
                                <div class="doc-icon icon-pptx"><i class="fa-solid fa-file-powerpoint"></i></div>
                            }
                            else
                            {
                                <div class="doc-icon icon-default"><i class="fa-solid fa-file"></i></div>
                            }

                            <div class="doc-info">
                                <h4 class="doc-title">@doc.Title</h4>
                                <div class="doc-meta">
                                    <span>Môn: @doc.SubjectCode</span>
                                    @if (!string.IsNullOrEmpty(doc.ChapterTitle))
                                    {
                                        <span>@doc.ChapterTitle</span>
                                    }
                                    <span>@doc.FileSizeDisplay</span>
                                    <span>@doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    
                                    @switch (doc.Status)
                                    {
                                    case DocumentStatus.Pending:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">🟡 Pending</span>
                                        break;
                                    case DocumentStatus.Indexed:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">🟢 Indexed</span>
                                        break;
                                    case DocumentStatus.Failed:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">🔴 Failed</span>
                                        break;
                                    }
                                    
                                    
                                </div>
                            </div>
                        </div>

                        <div class="doc-actions">
                            <a asp-action="ViewDocument" asp-controller="StudentDocument" asp-route-id="@doc.Id" class="btn-action btn-view">
                                <i class="fa-solid fa-eye"></i> Chi tiết
                            </a>
                            <a asp-action="Download" asp-controller="StudentDocument" asp-route-id="@doc.Id" class="btn-action btn-download">
                                <i class="fa-solid fa-download"></i> Tải về
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</body>
</html>
