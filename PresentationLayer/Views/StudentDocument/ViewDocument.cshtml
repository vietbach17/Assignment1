@model BussinessLayer.DTOs.DocumentDto
@{
    ViewData["Title"] = $"Xem tài liệu - {Model.Title}";
    var fileUrl = ViewBag.FileUrl as string;
    var fileType = ViewBag.FileType as string ?? Model.FileType;
    ViewBag.ActiveMenu = "Docs";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - EduManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800;900&display=swap');
        
        :root {
            --pink: #eb2f64; --yellow: #f4cf45; --green: #5cb85c; 
            --blue: #4fa8db; --black: #000; --white: #fff; --bg: #f4f4f6;
            --border: 3px solid var(--black);
            --shadow: 4px 4px 0px 0px var(--black);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        
        body {
            background-color: var(--bg);
            display: flex; min-height: 100vh; color: var(--black);
            background-image: radial-gradient(#d1d1d1 2px, transparent 2px);
        }

        /* Sidebar */
        .sidebar {
            width: 260px; background: var(--white); border-right: var(--border);
            padding: 30px 20px; display: flex; flex-direction: column; gap: 15px;
            position: sticky; top: 0; height: 100vh;
        }
        .logo { color: var(--pink); font-size: 22px; font-weight: 900; margin-bottom: 20px; }
        .nav-item {
            padding: 12px 15px; font-weight: 800; color: var(--black);
            text-decoration: none; display: flex; align-items: center; gap: 12px;
            border: 3px solid transparent; transition: 0.1s;
        }
        .nav-item.active {
            background: var(--pink); color: var(--white);
            border-color: var(--black); box-shadow: var(--shadow);
        }
        .nav-item:not(.active):hover { border-color: var(--black); transform: translate(-2px, -2px); box-shadow: var(--shadow); }

        /* Main Content */
        .main-content { flex: 1; padding: 40px; }
        .title-page { font-size: 28px; font-weight: 900; margin-bottom: 20px; text-transform: uppercase; }
        .brutal-box { background: var(--white); border: var(--border); box-shadow: 6px 6px 0px 0px var(--black); padding: 25px; }
        .brutal-btn { border: 2px solid var(--black); font-weight: 800; cursor: pointer; box-shadow: 2px 2px 0px 0px var(--black); padding: 10px 20px; text-decoration: none; display: inline-block; }
        .brutal-btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--black); }
        .brutal-btn.primary { background: var(--pink); color: var(--white); }
        .brutal-btn.secondary { background: var(--white); color: var(--black); }

        /* User Profile */
        .user-profile {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            background-color: var(--white);
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
        }
        .avatar-box {
            width: 36px; height: 36px; background-color: var(--pink);
            border: 2px solid var(--black); display: flex; align-items: center; justify-content: center;
            color: var(--white); font-size: 14px; flex-shrink: 0;
        }
        .user-info { display: flex; flex-direction: column; }
        .user-info .username { font-weight: 800; font-size: 12px; color: var(--black); }
        .user-info .role { font-weight: 700; font-size: 10px; color: #666; text-transform: uppercase; margin-top: 2px; }

        /* Document Viewer */
        .doc-header-box {
            background: var(--white);
            border: var(--border);
            box-shadow: var(--shadow);
            padding: 20px;
            margin-bottom: 20px;
        }

        .doc-title { font-size: 20px; font-weight: 900; margin-bottom: 12px; }
        .doc-meta { display: flex; gap: 20px; margin-bottom: 15px; flex-wrap: wrap; }
        .meta-item { display: flex; flex-direction: column; gap: 4px; }
        .meta-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #666; }
        .meta-value { font-size: 13px; font-weight: 700; }

        .file-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .file-badge.pdf { background: #ffb3b3; color: #c00; border: 1px solid #000; }
        .file-badge.docx { background: #b3d9ff; color: #003d99; border: 1px solid #000; }
        .file-badge.pptx { background: #ffd9b3; color: #996600; border: 1px solid #000; }

        .doc-actions { display: flex; gap: 12px; margin-top: 15px; }

        .viewer-box {
            background: var(--white);
            border: var(--border);
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            height: calc(100vh - 300px);
            min-height: 500px;
        }

        .viewer-iframe {
            flex: 1;
            border: none;
            background: white;
        }

        .viewer-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 10;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(0, 0, 0, 0.1);
            border-top-color: var(--pink);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @@keyframes spin { to { transform: rotate(360deg); } }

        .breadcrumb { 
            font-size: 12px; 
            color: #666; 
            margin-bottom: 15px; 
            font-weight: 700;
        }
        .breadcrumb a { color: var(--blue); text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }

        .no-preview {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 15px;
            color: #666;
            background: #f9f9f9;
        }

        .no-preview-icon { font-size: 48px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo"><i class="fa-solid fa-graduation-cap"></i> EduManager</div>
        <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Overview" ? "active" : "")"><i class="fa-solid fa-border-all"></i> TỔNG QUAN</a>
        <a asp-controller="StudentDocument" asp-action="Subjects" class="nav-item @(ViewBag.ActiveMenu == "Subjects" ? "active" : "")"><i class="fa-solid fa-book-open"></i> MÔN HỌC</a>
        <a asp-controller="StudentDocument" asp-action="Documents" class="nav-item @(ViewBag.ActiveMenu == "Docs" ? "active" : "")"><i class="fa-regular fa-file-lines"></i> TÀI LIỆU</a>
        <a asp-controller="Home" asp-action="Chat" class="nav-item @(ViewBag.ActiveMenu == "AI" ? "active" : "")"><i class="fa-solid fa-robot"></i> CHAT AI</a>
        <a asp-controller="Subscription" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Subscription" ? "active" : "")"><i class="fa-solid fa-crown"></i> GÓI HỘI VIÊN</a>

        <div style="margin-top:auto;">
            <div class="brutal-box" style="display:flex;align-items:center;gap:12px;padding:10px;">
                <div class="avatar-box">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="user-info">
                    <div class="username">@User.Identity?.Name</div>
                    <div class="role">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
            </div>
            <a asp-controller="Auth" asp-action="Logout" class="nav-item" style="border:dashed 2px var(--black);margin-top:10px">Log out</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="title-page">XEM TÀI LIỆU <i class="fa-solid fa-file" style="color: #666;"></i></h1>

        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a asp-action="Subjects">Môn học</a> › 
            <a asp-action="Chapters" asp-route-id="@Model.SubjectId">@Model.SubjectName</a>
            @if (Model.ChapterId.HasValue)
            {
                <span>› <a asp-action="Documents" asp-route-chapterId="@Model.ChapterId">@Model.ChapterTitle</a></span>
            }
            <span>› @Model.Title</span>
        </div>

        <!-- Document Header Box -->
        <div class="doc-header-box">
            <div class="doc-title">📄 @Model.Title</div>
            
            <div class="doc-meta">
                <div class="meta-item">
                    <div class="meta-label">Loại File</div>
                    <div><span class="file-badge @fileType?.ToLower()">@fileType?.ToUpper()</span></div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Kích Thước</div>
                    <div class="meta-value">@((Model.FileSize / 1024.0 / 1024.0).ToString("F2")) MB</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Ngày Upload</div>
                    <div class="meta-value">@Model.UploadedDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Môn Học</div>
                    <div class="meta-value">[@Model.SubjectCode] @Model.SubjectName</div>
                </div>
            </div>

            <div class="doc-actions">
                <!-- Download Button -->
                <a asp-action="Download" asp-route-id="@Model.Id" class="brutal-btn primary">
                    ⬇ Tải xuống
                </a>
                
                <!-- Back Button -->
                @if (Model.ChapterId.HasValue)
                {
                    <a asp-action="Documents" asp-route-chapterId="@Model.ChapterId" class="brutal-btn secondary">
                        ← Quay lại Tài Liệu
                    </a>
                }
                else
                {
                    <a asp-action="SubjectDocuments" asp-route-subjectId="@Model.SubjectId" class="brutal-btn secondary">
                        ← Quay lại Tài Liệu
                    </a>
                }
            </div>
        </div>

        <!-- Document Viewer -->
        <div class="viewer-box">
            <div class="viewer-loading" id="loadingIndicator">
                <div class="loading-spinner"></div>
                <p style="color: #666; font-weight: 700;">Đang tải tài liệu...</p>
            </div>

            @if ((fileType ?? Model.FileType)?.ToLower() == "pdf")
            {
                <iframe id="documentFrame" class="viewer-iframe" 
                    src="@Url.Action("PreviewFile", "StudentDocument", new { id = Model.Id })" 
                    onload="hideLoading()"></iframe>
            }
            else if ((fileType ?? Model.FileType)?.ToLower() == "docx" || (fileType ?? Model.FileType)?.ToLower() == "pptx")
            {
                var fullUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{fileUrl}";
                var viewerUrl = $"https://view.officeapps.live.com/op/embed.aspx?src={Uri.EscapeDataString(fullUrl)}";
                <iframe id="documentFrame" class="viewer-iframe" 
                    src="@viewerUrl" 
                    onload="hideLoading()"></iframe>
            }
            else
            {
                <div class="no-preview">
                    <div class="no-preview-icon">🚫</div>
                    <div style="font-weight: 700;">Không thể xem trước loại file này</div>
                    <p style="font-size: 13px; text-align: center;">Vui lòng tải về để xem trên máy tính</p>
                    <a asp-action="Download" asp-route-id="@Model.Id" class="brutal-btn primary" style="margin-top: 10px;">
                        ⬇ Tải xuống
                    </a>
                </div>
            }
        </div>
    </div>

    <script>
        function hideLoading() {
            const loadingIndicator = document.getElementById('loadingIndicator');
            if (loadingIndicator) {
                loadingIndicator.style.display = 'none';
            }
        }
        // Hide loading after 10 seconds if iframe doesn't load
        setTimeout(hideLoading, 10000);
    </script>
</body>
</html>

