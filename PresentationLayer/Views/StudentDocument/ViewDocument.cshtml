@model BussinessLayer.DTOs.DocumentDto

@{
    ViewData["Title"] = Model.Title;
}

<style>
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-size: 0.9rem;
        color: var(--text-secondary);
        flex-wrap: wrap;
    }

    .breadcrumb a {
        color: var(--accent-blue);
        text-decoration: none;
        transition: var(--transition-smooth);
    }

    .breadcrumb a:hover {
        color: #ffffff;
    }

    .breadcrumb-separator {
        color: var(--text-secondary);
    }

    .document-detail-container {
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2.5rem;
    }

    .document-header {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
    }

    .document-icon-large {
        font-size: 5rem;
        flex-shrink: 0;
    }

    .document-header-info {
        flex: 1;
    }

    .document-title-large {
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 1rem;
        line-height: 1.3;
    }

    .document-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .meta-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .meta-value {
        font-size: 1rem;
        color: #ffffff;
        font-weight: 500;
    }

    .file-type-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .file-type-pdf {
        background-color: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .file-type-docx {
        background-color: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .file-type-pptx {
        background-color: rgba(249, 115, 22, 0.15);
        color: #fdba74;
        border: 1px solid rgba(249, 115, 22, 0.3);
    }

    .status-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        background-color: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .document-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-download-large {
        background: linear-gradient(135deg, var(--accent-emerald) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        padding: 0.9rem 2rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-download-large:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
    }

    .btn-back {
        background-color: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        padding: 0.9rem 2rem;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: var(--transition-smooth);
        border: 1px solid var(--border-color);
    }

    .btn-back:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .document-info-section {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color);
    }

    .info-section-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .info-row {
        display: flex;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        flex: 0 0 200px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .info-value {
        flex: 1;
        color: #ffffff;
    }
</style>

<div class="breadcrumb">
    <a asp-action="Subjects">Môn học</a>
    <span class="breadcrumb-separator">›</span>
    <a asp-action="Chapters" asp-route-subjectId="@Model.SubjectId">@Model.SubjectName</a>
    @if (Model.ChapterId.HasValue)
    {
        <span class="breadcrumb-separator">›</span>
        <a asp-action="Documents" asp-route-chapterId="@Model.ChapterId">@Model.ChapterTitle</a>
    }
    <span class="breadcrumb-separator">›</span>
    <span>@Model.Title</span>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="document-detail-container">
    <div class="document-header">
        <div class="document-icon-large">
            @(Model.FileType switch
            {
                "pdf" => "📕",
                "docx" => "📘",
                "pptx" => "📙",
                _ => "📄"
            })
        </div>
        <div class="document-header-info">
            <h1 class="document-title-large">@Model.Title</h1>
            <div class="document-meta-grid">
                <div class="meta-item">
                    <span class="meta-label">Loại file</span>
                    <span class="meta-value">
                        <span class="file-type-badge file-type-@Model.FileType">@Model.FileType.ToUpper()</span>
                    </span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Kích thước</span>
                    <span class="meta-value">@((Model.FileSize / 1024.0 / 1024.0).ToString("F2")) MB</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Trạng thái</span>
                    <span class="meta-value">
                        <span class="status-badge">@Model.Status</span>
                    </span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Ngày upload</span>
                    <span class="meta-value">@Model.UploadedDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="document-info-section">
        <h2 class="info-section-title">Thông tin chi tiết</h2>
        <div class="info-row">
            <span class="info-label">Môn học:</span>
            <span class="info-value">[@Model.SubjectCode] @Model.SubjectName</span>
        </div>
        @if (Model.ChapterId.HasValue)
        {
            <div class="info-row">
                <span class="info-label">Chapter:</span>
                <span class="info-value">@Model.ChapterTitle</span>
            </div>
        }
        <div class="info-row">
            <span class="info-label">Tên file gốc:</span>
            <span class="info-value">@Model.FileName</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.UploadedByUsername))
        {
            <div class="info-row">
                <span class="info-label">Người upload:</span>
                <span class="info-value">@Model.UploadedByUsername</span>
            </div>
        }
    </div>

    <div class="document-actions">
        <a asp-action="ViewFile" asp-route-id="@Model.Id" class="btn-download-large" style="background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-blue) 100%);">
            👁 Xem trực tuyến
        </a>
        <a asp-action="Download" asp-route-id="@Model.Id" class="btn-download-large">
            ⬇ Tải xuống tài liệu
        </a>
        @if (Model.ChapterId.HasValue)
        {
            <a asp-action="Documents" asp-route-chapterId="@Model.ChapterId" class="btn-back">
                ← Quay lại danh sách
            </a>
        }
        else
        {
            <a asp-action="SubjectDocuments" asp-route-subjectId="@Model.SubjectId" class="btn-back">
                ← Quay lại danh sách
            </a>
        }
    </div>
</div>
