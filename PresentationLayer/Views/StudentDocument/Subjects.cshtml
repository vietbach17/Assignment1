@* @model IEnumerable<BussinessLayer.DTOs.SubjectDto>

@{
    ViewData["Title"] = "Danh sách môn học";
}


<style>
    .page-header {
        margin-bottom: 2.5rem;
        text-align: center;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    .subjects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .subject-card {
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2rem;
        transition: var(--transition-smooth);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .subject-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-blue) 100%);
        transform: scaleX(0);
        transition: var(--transition-smooth);
    }

    .subject-card:hover {
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-4px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    }

    .subject-card:hover::before {
        transform: scaleX(1);
    }

    .subject-code {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent-blue);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .subject-name {
        font-size: 1.4rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 1rem;
    }

    .subject-description {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .subject-actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-view-chapters, .btn-view-all-docs {
        flex: 1;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: var(--transition-smooth);
    }

    .btn-view-chapters {
        background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        border: none;
    }

    .btn-view-chapters:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .btn-view-all-docs {
        background-color: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border-color);
    }

    .btn-view-all-docs:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-secondary);
    }

    .empty-state-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.3;
    }
</style>

<div class="page-header">
    <h1 class="page-title">📚 Tài liệu học tập</h1>
    <p class="page-subtitle">Chọn môn học để xem tài liệu và bài giảng</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.Any())
{
    <div class="subjects-grid">
        @foreach (var subject in Model)
        {
            <div class="subject-card">
                <div class="subject-code">@subject.SubjectCode</div>
                <h3 class="subject-name">@subject.SubjectName</h3>
                @if (!string.IsNullOrEmpty(subject.Description))
                {
                    <p class="subject-description">@subject.Description</p>
                }
                <div class="subject-actions">
                    <a asp-action="Chapters" asp-route-subjectId="@subject.Id" class="btn-view-chapters">
                        Xem Chapters
                    </a>
                    <a asp-action="SubjectDocuments" asp-route-subjectId="@subject.Id" class="btn-view-all-docs">
                        Tất cả tài liệu
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">📭</div>
        <h3>Chưa có môn học nào</h3>
        <p>Hiện tại chưa có môn học nào được tạo trong hệ thống.</p>
    </div>
} *@
@{

    ViewBag.ActiveMenu = "Subjects";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - EduManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/brutal.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap');
        
        :root {
            --pink: #eb2f64; --yellow: #f4cf45; --green: #5cb85c; 
            --blue: #4fa8db; --black: #000; --white: #fff; --bg: #f4f4f6;
            --border: 3px solid var(--black);
            --shadow: 4px 4px 0px 0px var(--black);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Be Vietnam Pro', sans-serif; }
        
        body {
            background-color: var(--bg);
            display: flex; min-height: 100vh; color: var(--black);
            background-image: radial-gradient(#d1d1d1 2px, transparent 2px);
          
        }

        /* Tùy chỉnh thanh Sidebar */
        .sidebar {
            width: 260px; background: var(--white); border-right: var(--border);
            padding: 30px 20px; display: flex; flex-direction: column; gap: 15px;
            position: sticky; top: 0; height: 100vh;
        }
        .logo { color: var(--pink); font-size: 22px; font-weight: 900; margin-bottom: 20px; }
        .nav-item {
            padding: 12px 15px; font-weight: 800; color: var(--black);
            text-decoration: none; display: flex; align-items: center; gap: 12px;
            border: 3px solid transparent; transition: 0.1s;
        }
        .nav-item.active {
            background: var(--pink); color: var(--white);
            border-color: var(--black); box-shadow: var(--shadow);
        }
        .nav-item:not(.active):hover { border-color: var(--black); transform: translate(-2px, -2px); box-shadow: var(--shadow); }

        /* Vùng nội dung chính */
        .main-content { flex: 1; padding: 40px; }
        
        /* Các class tiện ích dùng chung (Utility Classes) */
        .title-page { font-size: 28px; font-weight: 900; margin-bottom: 20px; text-transform: uppercase; }
        .brutal-box { background: var(--white); border: var(--border); box-shadow: 6px 6px 0px 0px var(--black); padding: 25px; }
        .brutal-btn { border: 2px solid var(--black); font-weight: 800; cursor: pointer; box-shadow: 2px 2px 0px 0px var(--black); padding: 8px 15px; }
        .brutal-btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--black); }
        .badge { border: 2px solid var(--black); padding: 3px 10px; font-size: 12px; font-weight: 800; background: var(--yellow); }
    /* Thêm thuộc tính này để đẩy phần tử con cuối cùng xuống đáy */
.sidebar {
    display: flex;
    flex-direction: column;
}

/* ========================================================
   STYLE KHỐI USER PROFILE (NEO-BRUTALISM BOX)
   ======================================================== */
.user-profile {
    margin-top: auto; /* Tuyệt chiêu đẩy khối này xuống đáy sidebar */
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background-color: var(--white);
    border: 3px solid var(--black);
    box-shadow: 4px 4px 0px 0px var(--black); /* Đổ bóng phẳng đặc trưng */
}

/* Khung Avatar vuông vắn, viền dày */
.avatar-box {
    width: 36px;
    height: 36px;
    background-color: var(--pink); /* Đổi màu nền avatar theo ý thích */
    border: 2px solid var(--black);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-size: 14px;
    flex-shrink: 0; /* Giữ ảnh không bị bóp méo */
}

.avatar-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Cụm thông tin Text */
.user-info {
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Cắt chữ nếu tên quá dài */
}

.user-info .username {
    font-weight: 800;
    font-size: 12px;
    color: var(--black);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.user-info .role {
    font-weight: 700;
    font-size: 10px;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 2px;
}
        </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo"><i class="fa-solid fa-graduation-cap"></i> EduManager</div>
        <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Overview" ? "active" : "")"><i class="fa-solid fa-border-all"></i> TỔNG QUAN</a>
        <a asp-controller="StudentDocument" asp-action="Subjects" class="nav-item @(ViewBag.ActiveMenu == "Subjects" ? "active" : "")"><i class="fa-solid fa-book-open"></i> MÔN HỌC</a>
        <a asp-controller="StudentDocument" asp-action="Documents"  class="nav-item @(ViewBag.ActiveMenu == "Docs" ? "active" : "")"><i class="fa-regular fa-file-lines"></i> TÀI LIỆU</a>
        <a asp-controller="Home" asp-action="Chat"  class="nav-item @(ViewBag.ActiveMenu == "AI" ? "active" : "")"><i class="fa-solid fa-robot"></i> CHAT AI</a>
       <a asp-controller="Subscription" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Subscription" ? "active" : "")"><i class="fa-solid fa-crown"></i> GÓI HỘI VIÊN</a>
        
                <div class="user-profile">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                    var roleClass = "role-student";
                    if (User.IsInRole("Admin")) roleClass = "role-admin";
                    else if (User.IsInRole("Lecturer")) roleClass = "role-lecturer";
                    <div class="avatar-box">
                        <i class="fa-solid fa-user"></i> 
                    </div>

                    <div class="user-info">
                        <div class="username">@User.Identity.Name</div>
                        <div class="role">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>

                    </div>
                    
                     }
     </div>
     <a asp-controller="Auth" asp-action="Logout"  class="nav-item" style="border:dashed 2px var(--black);">Log out</a>      
    </div>
    
    
    <div class="main-content">
       <h1 class="title-page">DANH SÁCH MÔN HỌC CHI TIẾT <i class="fa-solid fa-book" style="color: #666;"></i></h1>

<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
    @foreach(var subject in Model)
    {
        <a asp-action="Chapters" asp-controller="StudentDocument" asp-route-id=@subject.Id class="brutal-box" style="background: #fdf5f5; padding: 20px; cursor: pointer;">
            <div style="display: flex; justify-content: space-between; font-weight: 900; font-size: 15px; margin-bottom: 40px;">
                {@subject.SubjectName} <div style="width: 10px; height: 10px; background: #000;"></div>
            </div>
            <div style="width: 100%; height: 12px; background: #fff; border: 2px solid #000;">
                <div style="width: 60%; height: 100%; background: #7ab38e; border-right: 2px solid #000;"></div>
            </div>
        </a>
    }
   
</div>
    </div>
</body>
</html>
