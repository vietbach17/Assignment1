@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

    // Xác định mục menu đang active. View có thể override bằng ViewBag.ActiveMenu.
    string active = ViewBag.ActiveMenu as string ?? "";
    if (string.IsNullOrEmpty(active))
    {
        if (controller == "Admin" && action == "Dashboard") active = "AdminDashboard";
        else if (controller == "Admin" && (action == "Users" || action == "UserDetails")) active = "AdminUsers";
        else if (controller == "Admin" && action == "SubscriptionPlans") active = "AdminPlans";
        else if (controller == "Admin" && action == "Notify") active = "AdminNotify";
        else if (controller == "Admin" && action == "ChunkSettings") active = "AdminChunkSettings";
        else if (controller == "Home") active = "LecturerHome";
        else if (controller == "Subjects" && action == "MySubjects") active = "MySubjects";
        else if (controller == "Subjects") active = "Subjects";
        else if (controller == "Document") active = "Document";
        else if (controller == "Chapters") active = "Chapters";
    }
    string IsActive(string key) => active == key ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - EduQuest</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/brutal.css" asp-append-version="true" />
    <style>
        /* @@import moved to brutal.css */
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash-body">
    <!-- MOBILE TOPBAR -->
    <div class="mobile-topbar">
        <div class="logo" style="margin:0; font-size:18px;"><i class="fa-solid fa-graduation-cap"></i> EduQuest</div>
        <button id="menuToggleButton" onclick="toggleSidebarMenu()" style="background:none; border:none; font-size:24px; cursor:pointer; color:var(--black);"><i class="fa-solid fa-bars"></i></button>
    </div>
    <div id="sidebarOverlay" onclick="toggleSidebarMenu()" style="position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:9998;"></div>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header-mobile">
            <div class="logo" style="margin:0; font-size:18px;"><i class="fa-solid fa-graduation-cap"></i> EduQuest</div>
            <button onclick="toggleSidebarMenu()" style="background:none; border:none; font-size:20px; cursor:pointer; color:var(--black);"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="logo"><i class="fa-solid fa-graduation-cap"></i> EduQuest</div>

        @if (userRole == "Admin")
        {
            <div class="menu-label">QUẢN TRỊ VIÊN</div>
            <a asp-controller="Admin" asp-action="Dashboard" class="nav-item @IsActive("AdminDashboard")"><i class="fa-solid fa-chart-pie"></i> DASHBOARD</a>
            <a asp-controller="Admin" asp-action="Users" class="nav-item @IsActive("AdminUsers")"><i class="fa-solid fa-users-gear"></i> QL NGƯỜI DÙNG</a>
            <a asp-controller="Subjects" asp-action="Index" class="nav-item @IsActive("Subjects")"><i class="fa-solid fa-book-open-reader"></i> QL MÔN HỌC</a>
            <a asp-controller="Document" asp-action="Index" class="nav-item @IsActive("Document")"><i class="fa-regular fa-file-lines"></i> QL TÀI LIỆU</a>
            <a asp-controller="Admin" asp-action="SubscriptionPlans" class="nav-item @IsActive("AdminPlans")"><i class="fa-solid fa-tags"></i> GÓI SUBSCRIPTION</a>
            <a asp-controller="Admin" asp-action="Notify" class="nav-item @IsActive("AdminNotify")"><i class="fa-solid fa-bell"></i> GỬI THÔNG BÁO</a>
            <a asp-controller="Admin" asp-action="ChunkSettings" class="nav-item @IsActive("AdminChunkSettings")"><i class="fa-solid fa-cogs"></i> AI CHUNKING</a>
        }
        else if (userRole == "Lecturer")
        {
            <div class="menu-label">GIẢNG VIÊN</div>
            <a asp-controller="Home" asp-action="Index" class="nav-item @IsActive("LecturerHome")"><i class="fa-solid fa-border-all"></i> TỔNG QUAN</a>
            <a asp-controller="Subjects" asp-action="MySubjects" class="nav-item @IsActive("MySubjects")"><i class="fa-solid fa-book-bookmark"></i> MÔN PHỤ TRÁCH</a>
            <a asp-controller="Subjects" asp-action="Index" class="nav-item @IsActive("Subjects")"><i class="fa-solid fa-book-open"></i> TẤT CẢ MÔN HỌC</a>
            <a asp-controller="Document" asp-action="Index" class="nav-item @IsActive("Document")"><i class="fa-regular fa-file-lines"></i> TÀI LIỆU</a>
        }

        <a asp-controller="Auth" asp-action="Profile" class="user-profile">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="avatar-box"><i class="fa-solid fa-user"></i></div>
                <div class="user-info">
                    <div class="username">@User.Identity.Name</div>
                    <div class="role">@userRole</div>
                </div>
            }
        </a>
        <a asp-controller="Auth" asp-action="Logout" class="nav-item" style="border:dashed 2px var(--black); justify-content:center;">
            <i class="fa-solid fa-right-from-bracket"></i> ĐĂNG XUẤT
        </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-wrapper">
        @RenderBody()
    </div>

    <!-- GLOBAL CONFIRM MODAL -->
    <div id="brutalConfirmModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:99999; justify-content:center; align-items:center; backdrop-filter:blur(2px);">
        <div style="background:var(--white); border:4px solid var(--black); box-shadow:8px 8px 0px var(--black); width:400px; max-width:90%; text-align:center; display:flex; flex-direction:column;">
            <div style="background:var(--yellow); padding:15px; border-bottom:4px solid var(--black);">
                <h3 style="margin:0; font-weight:900; font-size:20px; text-transform:uppercase; color:var(--black);"><i class="fa-solid fa-triangle-exclamation"></i> XÁC NHẬN</h3>
            </div>
            <div style="padding:30px 20px;"><p id="brutalConfirmMessage" style="font-weight:800; font-size:16px; margin:0; line-height:1.5;"></p></div>
            <div style="padding:20px; border-top:4px solid var(--black); background:var(--bg); display:flex; justify-content:center; gap:15px;">
                <button type="button" onclick="__brutalConfirmNo()" class="brutal-btn" style="background:#ccc;">HỦY BỎ</button>
                <button type="button" onclick="__brutalConfirmYes()" class="brutal-btn btn-pink">XÁC NHẬN</button>
            </div>
        </div>
    </div>

    <!-- GLOBAL ALERT MODAL -->
    <div id="brutalAlertModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:99999; justify-content:center; align-items:center; backdrop-filter:blur(2px);">
        <div style="background:var(--white); border:4px solid var(--black); box-shadow:8px 8px 0px var(--black); width:400px; max-width:90%; text-align:center; display:flex; flex-direction:column;">
            <div style="background:var(--pink); padding:15px; border-bottom:4px solid var(--black);">
                <h3 style="margin:0; font-weight:900; font-size:20px; text-transform:uppercase; color:var(--white);"><i class="fa-solid fa-circle-info"></i> THÔNG BÁO</h3>
            </div>
            <div style="padding:30px 20px;"><p id="brutalAlertMessage" style="font-weight:800; font-size:16px; margin:0; line-height:1.5;"></p></div>
            <div style="padding:20px; border-top:4px solid var(--black); background:var(--bg); display:flex; justify-content:center;">
                <button type="button" onclick="document.getElementById('brutalAlertModal').style.display='none'" class="brutal-btn btn-dark">ĐÓNG</button>
            </div>
        </div>
    </div>

    <script>
        window.__brutalConfirmCallback = null;
        function brutalConfirm(message, callback) {
            document.getElementById('brutalConfirmMessage').innerText = message;
            document.getElementById('brutalConfirmModal').style.display = 'flex';
            window.__brutalConfirmCallback = callback;
        }
        function __brutalConfirmYes() {
            document.getElementById('brutalConfirmModal').style.display = 'none';
            if (window.__brutalConfirmCallback) { window.__brutalConfirmCallback(); window.__brutalConfirmCallback = null; }
        }
        function __brutalConfirmNo() {
            document.getElementById('brutalConfirmModal').style.display = 'none';
            window.__brutalConfirmCallback = null;
        }
        function brutalAlert(message) {
            document.getElementById('brutalAlertMessage').innerText = message;
            document.getElementById('brutalAlertModal').style.display = 'flex';
        }
        function toggleSidebarMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const icon = document.querySelector('#menuToggleButton i');
            sidebar.classList.toggle('active');
            if (sidebar.classList.contains('active')) { overlay.style.display = 'block'; if (icon) icon.className = 'fa-solid fa-xmark'; }
            else { overlay.style.display = 'none'; if (icon) icon.className = 'fa-solid fa-bars'; }
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.sidebar .nav-item').forEach(link => {
                link.addEventListener('click', () => {
                    const sidebar = document.querySelector('.sidebar');
                    if (sidebar.classList.contains('active')) toggleSidebarMenu();
                });
            });
        });
        // Chặn các form có data-confirm để hiển thị modal xác nhận
        document.addEventListener('submit', function (e) {
            const form = e.target;
            const msg = form.getAttribute('data-confirm');
            if (msg) {
                e.preventDefault();
                brutalConfirm(msg, function () { form.removeAttribute('data-confirm'); form.submit(); });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
