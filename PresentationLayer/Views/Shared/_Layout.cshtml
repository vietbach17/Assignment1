@{
    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var roleClass = User.IsInRole("Admin") ? "role-admin" : User.IsInRole("Lecturer") ? "role-lecturer" : "role-student";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduQuest</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/brutal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-body">
    <header class="public-header">
        <div class="public-nav">
            <a href="/" class="brand">
                <img src="https://raw.githubusercontent.com/vietbach17/Assignment1/refs/heads/main/eduquest.png" alt="EduQuest" />
                EduQuest
            </a>

            <button class="public-menu-toggle" type="button" aria-label="Menu" onclick="document.getElementById('publicNavCollapse').classList.toggle('open')">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="public-nav-collapse" id="publicNavCollapse">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="public-menu">
                        <li><a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a></li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                        {
                            <li><a asp-controller="Subjects" asp-action="Index" class="nav-link">Môn học</a></li>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <li><a asp-controller="StudentDocument" asp-action="Subjects" class="nav-link">Tài liệu</a></li>
                        }
                        <li><a asp-controller="Subscription" asp-action="Index" class="nav-link">Hội viên</a></li>
                    </ul>

                    <div class="public-user">
                        <div class="user-meta">
                            <span class="u-name">@User.Identity.Name</span>
                            <span class="role-badge @roleClass">@role</span>
                        </div>
                        <a asp-controller="Auth" asp-action="Logout" class="brutal-btn btn-red sm">Đăng xuất</a>
                    </div>
                }
                else
                {
                    <div class="public-user">
                        <a asp-controller="Auth" asp-action="Login" class="brutal-btn sm">Đăng nhập</a>
                        <a asp-controller="Auth" asp-action="Register" class="brutal-btn btn-pink sm">Đăng ký</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <main class="public-main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <p>EduQuest được phát triển bởi GROUP 1 - PRN222</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
