@model IEnumerable<BussinessLayer.DTOs.DocumentDto>
@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bảng điều khiển";
    ViewBag.ActiveMenu = "AdminDashboard";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">HỆ THỐNG</div>
            <h1 class="page-title">Bảng điều khiển</h1>
            <p class="page-subtitle">Chào mừng Admin! Nơi cấu hình, kiểm soát hệ thống và phân quyền.</p>
        </div>
        <a asp-controller="Auth" asp-action="Register" class="brutal-btn btn-pink"><i class="fa-solid fa-user-plus"></i> Cấp tài khoản mới</a>
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["SuccessMsg"]</div>
    }
    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i> @TempData["ErrorMsg"]</div>
    }

    <!-- Stats -->
    <div class="stat-grid">
        <a asp-controller="Admin" asp-action="Users" class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Người dùng</span>
                <div class="stat-icon" style="background:var(--blue); color:var(--white);"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
            <div class="page-subtitle"><span class="text-green">@ViewBag.ActiveUsers hoạt động</span> · @ViewBag.DisabledUsers bị khóa</div>
        </a>
        <a asp-controller="Subjects" asp-action="Index" class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Môn học</span>
                <div class="stat-icon" style="background:var(--green); color:var(--white);"><i class="fa-solid fa-book"></i></div>
            </div>
            <div class="stat-value">@ViewBag.TotalSubjects</div>
            <div class="page-subtitle">môn đang hoạt động</div>
        </a>
        <a asp-controller="Document" asp-action="Index" class="stat-card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Tài liệu</span>
                <div class="stat-icon" style="background:var(--yellow);"><i class="fa-solid fa-file-lines"></i></div>
            </div>
            <div class="stat-value">@ViewBag.TotalDocuments</div>
            <div class="page-subtitle">file đã tải lên</div>
        </a>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Doanh thu</span>
                <div class="stat-icon" style="background:var(--purple); color:var(--white);"><i class="fa-solid fa-coins"></i></div>
            </div>
            <div class="stat-value text-pink">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</div>
            <div class="page-subtitle"><span class="text-green">@ViewBag.SuccessTransactionCount giao dịch</span> thành công</div>
        </div>
    </div>

    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:25px; margin-bottom:25px;">
        <!-- Roles Table -->
        <div class="brutal-card pad0">
            <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
                <h3 class="card-title">Quản lý Vai trò</h3>
                <a asp-action="CreateRole" class="brutal-btn btn-pink sm"><i class="fa-solid fa-plus"></i> Thêm vai trò</a>
            </div>
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>ID</th><th>Tên vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Roles != null)
                        {
                            foreach (var role in ViewBag.Roles)
                            {
                                bool isDefault = role.RoleName == "Admin" || role.RoleName == "Lecturer" || role.RoleName == "Student";
                                string badge = role.RoleName switch
                                {
                                    "Admin" => "badge-pink",
                                    "Lecturer" => "badge-blue",
                                    "Student" => "badge-green",
                                    _ => "badge-gray"
                                };
                                <tr>
                                    <td>@role.Id</td>
                                    <td>
                                        <span class="badge @badge">@role.RoleName</span>
                                        @if (isDefault)
                                        {
                                            <span class="text-muted" style="font-size:11px; margin-left:6px; font-style:italic;">(Mặc định)</span>
                                        }
                                    </td>
                                    <td><span class="badge badge-green">Hoạt động</span></td>
                                    <td>
                                        @if (!isDefault)
                                        {
                                            <div style="display:flex; gap:6px;">
                                                <a asp-action="EditRole" asp-route-id="@role.Id" class="brutal-btn btn-blue sm"><i class="fa-solid fa-pen"></i> Sửa</a>
                                                <form asp-action="DeleteRole" asp-route-id="@role.Id" method="post" data-confirm="Bạn có chắc chắn muốn xoá vai trò này?" style="margin:0;">
                                                    <button type="submit" class="brutal-btn btn-red sm"><i class="fa-solid fa-trash"></i> Xoá</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size:11px; font-style:italic;">Không thể sửa/xoá</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="brutal-card" style="display:flex; flex-direction:column; gap:14px;">
            <h3 class="card-title">Tác vụ nhanh</h3>
            <a asp-controller="Auth" asp-action="Register" class="brutal-btn btn-pink" style="justify-content:flex-start;"><i class="fa-solid fa-user-plus"></i> Thêm tài khoản</a>
            <a asp-controller="Subjects" asp-action="Create" class="brutal-btn btn-blue" style="justify-content:flex-start;"><i class="fa-solid fa-book-medical"></i> Thêm môn học</a>
            <a asp-controller="Admin" asp-action="SubscriptionPlans" class="brutal-btn btn-yellow" style="justify-content:flex-start;"><i class="fa-solid fa-box-open"></i> Gói subscription</a>
            <a asp-controller="Admin" asp-action="Notify" class="brutal-btn" style="justify-content:flex-start;"><i class="fa-solid fa-bell"></i> Gửi thông báo</a>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:auto; padding-top:12px; border-top:2px dashed #ccc;">
                <div style="border:2px solid var(--black); padding:12px; text-align:center;">
                    <div class="stat-value" style="font-size:22px;">@ViewBag.TotalPlans</div>
                    <div class="page-subtitle">Gói subscription</div>
                </div>
                <div style="border:2px solid var(--black); padding:12px; text-align:center; background:#eafaf0;">
                    <div class="stat-value text-green" style="font-size:20px;">@(((decimal)ViewBag.NetProfit).ToString("N0")) đ</div>
                    <div class="page-subtitle">Lợi nhuận ròng</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions -->
    <div class="brutal-card pad0" style="margin-bottom:25px;">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
            <h3 class="card-title">Lịch sử giao dịch mua gói</h3>
            <span class="badge badge-green">Tổng: @ViewBag.SuccessTransactionCount thành công</span>
        </div>
        @if (ViewBag.Transactions == null || !((List<PaymentTransactionDTO>)ViewBag.Transactions).Any())
        {
            <div style="padding:48px; text-align:center;">
                <i class="fa-solid fa-receipt" style="font-size:40px; color:#ccc;"></i>
                <p class="text-muted" style="margin-top:12px; font-weight:800;">Chưa có giao dịch thanh toán nào.</p>
            </div>
        }
        else
        {
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>Mã GD</th><th>Sinh viên</th><th>Gói cước</th><th>Số tiền</th><th>Thời gian</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in (List<PaymentTransactionDTO>)ViewBag.Transactions)
                        {
                            <tr>
                                <td style="font-family:monospace;">#TX-@tx.Id</td>
                                <td>@(tx.Username ?? "N/A")</td>
                                <td>
                                    @switch (tx.SubscriptionPlanId)
                                    {
                                        case 1: <span>Gói Free</span> break;
                                        case 2: <span class="text-blue">Gói Standard</span> break;
                                        case 3: <span class="text-pink">Gói Premium</span> break;
                                        default: <span>Gói #@tx.SubscriptionPlanId</span> break;
                                    }
                                </td>
                                <td style="font-weight:900;">@tx.Amount.ToString("N0") đ</td>
                                <td class="text-muted">@tx.TransactionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    @if (tx.Status == "Success")
                                    {
                                        <span class="badge badge-green">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-red">Failed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Documents -->
    <div class="brutal-card pad0">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black);">
            <h3 class="card-title">Quản lý tài liệu hệ thống</h3>
        </div>
        @if (!Model.Any())
        {
            <div style="padding:48px; text-align:center;">
                <i class="fa-regular fa-folder-open" style="font-size:40px; color:#ccc;"></i>
                <p class="text-muted" style="margin-top:12px; font-weight:800;">Chưa có tài liệu nào được tải lên.</p>
            </div>
        }
        else
        {
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>Định dạng</th><th>Tiêu đề</th><th>Môn học</th><th>Tác giả</th><th>Ngày tải</th><th>Trạng thái</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    @switch (doc.FileType.ToLower())
                                    {
                                        case "pdf": <span class="badge badge-red">PDF</span> break;
                                        case "docx": <span class="badge badge-blue">DOCX</span> break;
                                        case "pptx": <span class="badge badge-yellow">PPTX</span> break;
                                        default: <span class="badge badge-gray">FILE</span> break;
                                    }
                                </td>
                                <td>
                                    <div style="font-weight:900;">@doc.Title</div>
                                    <div class="page-subtitle">@doc.FileSizeDisplay</div>
                                </td>
                                <td>@doc.SubjectCode</td>
                                <td>@doc.UploadedByUsername</td>
                                <td class="text-muted">@doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (doc.Status)
                                    {
                                        case DocumentStatus.Pending: <span class="badge badge-yellow">Pending</span> break;
                                        case DocumentStatus.Indexed: <span class="badge badge-green">Indexed</span> break;
                                        case DocumentStatus.Failed: <span class="badge badge-red">Failed</span> break;
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Document" asp-action="Details" asp-route-id="@doc.Id" class="brutal-btn sm"><i class="fa-solid fa-eye"></i> Xem</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
