@model BussinessLayer.DTOs.UserDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chi tiết người dùng";
    ViewBag.ActiveMenu = "AdminUsers";
    string badge = Model.RoleName switch
    {
        "Admin" => "badge-pink",
        "Lecturer" => "badge-blue",
        "Student" => "badge-green",
        _ => "badge-gray"
    };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Users" class="text-pink">Người dùng</a> › Chi tiết</div>
            <h1 class="page-title">@Model.Username</h1>
        </div>
        <a asp-action="Users" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card pad0" style="max-width:640px;">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black);">
            <h3 class="card-title">Thông tin cơ bản</h3>
        </div>
        <div style="padding:8px 20px 20px;">
            <div style="display:flex; padding:14px 0; border-bottom:1px dashed #ccc;">
                <span class="text-muted" style="width:35%; font-weight:800;">ID</span>
                <span style="font-weight:900;">@Model.Id</span>
            </div>
            <div style="display:flex; padding:14px 0; border-bottom:1px dashed #ccc;">
                <span class="text-muted" style="width:35%; font-weight:800;">Username</span>
                <span style="font-weight:900;">@Model.Username</span>
            </div>
            <div style="display:flex; padding:14px 0; border-bottom:1px dashed #ccc;">
                <span class="text-muted" style="width:35%; font-weight:800;">Email</span>
                <span style="font-weight:900;">@(Model.Email ?? "-")</span>
            </div>
            <div style="display:flex; padding:14px 0;">
                <span class="text-muted" style="width:35%; font-weight:800;">Vai trò</span>
                <span><span class="badge @badge">@Model.RoleName</span></span>
            </div>
        </div>
    </div>
</div>
