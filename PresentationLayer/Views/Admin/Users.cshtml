@model IEnumerable<BussinessLayer.DTOs.UserDto>
@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quản lý Người dùng";
    ViewBag.ActiveMenu = "AdminUsers";
    var roles = ViewBag.Roles as System.Collections.IEnumerable; // untyped -> tránh phụ thuộc DataAccessLayer trong View
    int totalUsers = Model.Count();
    int activeCount = Model.Count(u => !u.IsDeleted);
    int disabledCount = Model.Count(u => u.IsDeleted);
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">HỆ THỐNG</div>
            <h1 class="page-title">Quản lý người dùng</h1>
            <p class="page-subtitle">Cập nhật thông tin, vô hiệu hóa hoặc khôi phục tài khoản.</p>
        </div>
        <a asp-controller="Auth" asp-action="Register" class="brutal-btn btn-pink"><i class="fa-solid fa-user-plus"></i> Cấp tài khoản mới</a>
    </div>

    @if (TempData["UserSuccessMsg"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["UserSuccessMsg"]</div>
    }
    @if (TempData["UserErrorMsg"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-circle-exclamation"></i> @TempData["UserErrorMsg"]</div>
    }

    <!-- Stats -->
    <div class="stat-grid">
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Tổng tài khoản</span>
                <div class="stat-icon" style="background:var(--black); color:var(--white);"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stat-value">@totalUsers</div>
        </div>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Đang hoạt động</span>
                <div class="stat-icon" style="background:var(--green); color:var(--white);"><i class="fa-solid fa-circle-check"></i></div>
            </div>
            <div class="stat-value text-green">@activeCount</div>
        </div>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Đã vô hiệu hóa</span>
                <div class="stat-icon" style="background:#ff4d4f; color:var(--white);"><i class="fa-solid fa-user-slash"></i></div>
            </div>
            <div class="stat-value" style="color:#ff4d4f;">@disabledCount</div>
        </div>
    </div>

    <!-- Table -->
    <div class="brutal-card pad0">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
            <h3 class="card-title">Danh sách người dùng</h3>
            <span class="badge badge-gray">@totalUsers tài khoản</span>
        </div>
        @if (!Model.Any())
        {
            <div style="padding:48px; text-align:center;">
                <i class="fa-solid fa-users-slash" style="font-size:40px; color:#ccc;"></i>
                <p class="text-muted" style="margin-top:12px; font-weight:800;">Hiện chưa có người dùng nào.</p>
            </div>
        }
        else
        {
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>ID</th><th>Username</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            bool isRoot = u.Id == 1;
                            string jsUsername = u.Username.Replace("\\", "\\\\").Replace("'", "\\'");
                            string jsEmail = (u.Email ?? "").Replace("\\", "\\\\").Replace("'", "\\'");
                            string badge = u.RoleName switch
                            {
                                "Admin" => "badge-pink",
                                "Lecturer" => "badge-blue",
                                "Student" => "badge-green",
                                _ => "badge-gray"
                            };
                            <tr style="@(u.IsDeleted ? "background:#fbeaea;" : "")">
                                <td class="text-muted" style="font-family:monospace;">@u.Id</td>
                                <td>
                                    <span style="font-weight:900;">@u.Username</span>
                                    @if (isRoot)
                                    {
                                        <span class="badge badge-pink" style="margin-left:6px;">Root</span>
                                    }
                                </td>
                                <td>@(u.Email ?? "-")</td>
                                <td><span class="badge @badge">@u.RoleName</span></td>
                                <td>
                                    @if (u.IsDeleted)
                                    {
                                        <span class="badge badge-red"><i class="fa-solid fa-user-slash"></i> Vô hiệu</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-green"><i class="fa-solid fa-circle-check"></i> Hoạt động</span>
                                    }
                                </td>
                                <td>
                                    @if (isRoot)
                                    {
                                        <span class="text-muted" style="font-size:11px; font-style:italic;">Không thể chỉnh sửa</span>
                                    }
                                    else
                                    {
                                        <div style="display:flex; gap:6px;">
                                            @if (!u.IsDeleted)
                                            {
                                                <button type="button" class="brutal-btn btn-blue sm"
                                                        onclick="openEditModal(@u.Id, '@jsUsername', '@jsEmail', @u.RoleId)">
                                                    <i class="fa-solid fa-pen"></i> Sửa
                                                </button>
                                                <form asp-action="DisableUser" asp-controller="Admin" method="post" data-confirm="Vô hiệu hóa tài khoản '@u.Username'?" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="brutal-btn btn-red sm"><i class="fa-solid fa-user-slash"></i> Vô hiệu</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="RestoreUser" asp-controller="Admin" method="post" data-confirm="Khôi phục tài khoản '@u.Username'?" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="brutal-btn btn-yellow sm"><i class="fa-solid fa-rotate-left"></i> Khôi phục</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <button type="button" class="modal-close" onclick="closeModal('editModal')">&times;</button>
        <h2 class="card-title text-blue" style="margin-bottom:20px;"><i class="fa-solid fa-pen"></i> Cập nhật người dùng</h2>
        <form asp-action="UpdateUser" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="edit-id" />
            <div class="form-group">
                <label>Username</label>
                <input id="edit-username" type="text" disabled style="background:#eee; cursor:not-allowed;" />
                <span class="text-muted" style="font-size:11px;">Username không thể thay đổi.</span>
            </div>
            <div class="form-group">
                <label>Email *</label>
                <input id="edit-email" name="Email" type="email" required />
            </div>
            <div class="form-group">
                <label>Vai trò *</label>
                <select id="edit-role" name="RoleId" required>
                    @if (roles != null)
                    {
                        foreach (dynamic role in roles)
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="brutal-btn btn-blue" style="width:100%; margin-top:8px;"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }
        function openEditModal(id, username, email, roleId) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-username').value = username;
            document.getElementById('edit-email').value = email;
            document.getElementById('edit-role').value = roleId;
            document.getElementById('editModal').classList.add('open');
        }
    </script>
}
