@model IEnumerable<BussinessLayer.DTOs.UserDto>
@{
    Layout = null;
    ViewData["Title"] = "Quản lý Người Dùng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-shield-halved text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Admin Portal</p>
            </div>
        </div>

        <div class="px-4 py-2">
            <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
            <ul class="space-y-1">
                <li>
                    <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                        <i class="fa-solid fa-chart-line w-5"></i>
                        <span>Bảng điều khiển</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-users w-5"></i>
                        <span>Người Dùng</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-arrow-left w-5"></i>
                        <span>Môn Học</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Admin" asp-controller="Subscription" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                        <i class="fa-solid fa-box-open w-5"></i>
                        <span>Gói Subscription</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-arrow-left w-5"></i>
                        <span>Về trang chủ</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
            </div>
            
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-purple-100 text-purple-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8">
                <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">
                    Hệ thống
                </p>
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Quản Lý Người Dùng</h2>
                <p class="text-gray-500 text-sm">Xem danh sách toàn bộ người dùng trong hệ thống.</p>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-gray-800">Danh sách Người Dùng</h3>
                    <a asp-controller="Auth" asp-action="Register" class="inline-flex items-center space-x-2 bg-brand-button hover:bg-brand-button/90 text-white px-4 py-2 rounded-lg text-sm font-semibold transition shadow-sm">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Cấp tài khoản mới</span>
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="p-12 text-center">
                        <i class="fa-solid fa-users-slash text-5xl text-gray-300 mb-4 block"></i>
                        <p class="text-gray-500 text-sm">Hiện chưa có người dùng nào trong hệ thống.</p>
                    </div>
                }
                else
                {
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-100 bg-white">
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Username</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var user in Model)
                            {
                                string roleClass = user.RoleName switch {
                                    "Admin" => "bg-purple-100 text-purple-700",
                                    "Lecturer" => "bg-blue-100 text-blue-700",
                                    "Student" => "bg-green-100 text-green-700",
                                    _ => "bg-gray-100 text-gray-700"
                                };
                                
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 text-sm text-gray-600">@user.Id</td>
                                    <td class="px-6 py-4">
                                        <span class="font-bold text-gray-800">@user.Username</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold @roleClass">
                                            @user.RoleName
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <a asp-action="UserDetails" asp-route-id="@user.Id" class="inline-block bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 hover:text-brand-button px-3 py-1.5 rounded-lg text-xs font-medium transition shadow-sm">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </main>
</body>
</html>
