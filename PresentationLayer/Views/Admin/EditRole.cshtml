@model dynamic
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chỉnh sửa vai trò";
    ViewBag.ActiveMenu = "AdminDashboard";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">PHÂN QUYỀN</div>
            <h1 class="page-title">Chỉnh sửa vai trò: @Model.RoleName</h1>
            <p class="page-subtitle">Cập nhật tên cho nhóm quyền hiện tại.</p>
        </div>
        <a asp-action="Dashboard" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:560px;">
        <form asp-action="EditRole" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
            <div class="form-group">
                <label for="roleName">Tên vai trò</label>
                <input type="text" id="roleName" name="roleName" value="@Model.RoleName" required />
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:10px;">
                <a asp-action="Dashboard" class="brutal-btn">Huỷ</a>
                <button type="submit" class="brutal-btn btn-blue"><i class="fa-solid fa-floppy-disk"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>
