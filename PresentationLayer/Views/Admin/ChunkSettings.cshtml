@model BussinessLayer.DTOs.ChunkSettingsDto
@{
    ViewData["Title"] = "Cấu hình AI Chunking";
    Layout = "_DashboardLayout";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <h1 class="page-title"><i class="fa-solid fa-cogs"></i> @ViewData["Title"]</h1>
            <div class="page-subtitle">Thiết lập tham số phân đoạn tài liệu khi AI đọc</div>
        </div>
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMsg"]
        </div>
    }

    <div class="brutal-card" style="max-width: 800px; margin-top: 15px;">
        <h2 class="card-title mb-3" style="margin-bottom: 20px;"><i class="fas fa-info-circle"></i> Lưu ý khi cấu hình</h2>
        <div class="alert alert-warning" style="margin-bottom: 25px;">
            <ul style="margin-left: 15px; margin-top: 5px;">
                <li style="margin-bottom: 5px;"><strong>Max Words:</strong> Số từ tối đa của một khối (chunk) khi AI đọc tài liệu. Độ dài tối ưu là 300 từ. Quá dài có thể làm giảm độ chính xác của ngữ cảnh.</li>
                <li><strong>Overlap Words:</strong> Số từ gối đầu (được copy lại từ cuối chunk trước sang đầu chunk sau) để không bị đứt gãy ý nghĩa đoạn văn. Khuyến nghị 50 từ.</li>
            </ul>
        </div>

        <form asp-action="ChunkSettings" method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                <div class="form-group">
                    <label asp-for="MaxWords"><i class="fas fa-file-word"></i> Số từ tối đa (Max Words)</label>
                    <input asp-for="MaxWords" class="brutal-input" type="number" min="100" max="1000" />
                    <span asp-validation-for="MaxWords" class="text-pink" style="font-size: 12px; font-weight: 700; margin-top: 4px;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OverlapWords"><i class="fas fa-link"></i> Số từ gối đầu (Overlap Words)</label>
                    <input asp-for="OverlapWords" class="brutal-input" type="number" min="10" max="200" />
                    <span asp-validation-for="OverlapWords" class="text-pink" style="font-size: 12px; font-weight: 700; margin-top: 4px;"></span>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" class="brutal-btn btn-blue">
                    <i class="fas fa-save"></i> LƯU CẤU HÌNH
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
