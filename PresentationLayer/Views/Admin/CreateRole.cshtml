@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Thêm vai trò mới";
    ViewBag.ActiveMenu = "AdminDashboard";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">PHÂN QUYỀN</div>
            <h1 class="page-title">Thêm vai trò mới</h1>
            <p class="page-subtitle">Tạo một nhóm quyền mới cho hệ thống.</p>
        </div>
        <a asp-action="Dashboard" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:560px;">
        <form asp-action="CreateRole" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error @(ViewData.ModelState.IsValid ? "" : "")" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
            <div class="form-group">
                <label for="roleName">Tên vai trò mới</label>
                <input type="text" id="roleName" name="roleName" required placeholder="Ví dụ: Moderator, Manager..." />
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:10px;">
                <a asp-action="Dashboard" class="brutal-btn">Huỷ</a>
                <button type="submit" class="brutal-btn btn-pink"><i class="fa-solid fa-floppy-disk"></i> Lưu vai trò</button>
            </div>
        </form>
    </div>
</div>
