@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Gửi thông báo";
    ViewBag.ActiveMenu = "AdminNotify";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">HỆ THỐNG</div>
            <h1 class="page-title"><i class="fa-solid fa-bell"></i> Gửi thông báo</h1>
            <p class="page-subtitle">Thông báo tới sinh viên về cập nhật gói hoặc thông báo hệ thống.</p>
        </div>
        <a asp-action="Dashboard" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i> @TempData["ErrorMsg"]</div>
    }
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["SuccessMsg"]</div>
    }

    <div class="brutal-card" style="max-width:620px; margin:0 auto;">
        <form asp-action="SendNotification" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Tiêu đề</label>
                <input type="text" name="title" required />
            </div>
            <div class="form-group">
                <label>Nội dung</label>
                <textarea name="message" rows="6" required></textarea>
            </div>
            <div class="form-group">
                <label>Đối tượng</label>
                <div style="display:flex; gap:20px; margin-top:4px;">
                    <label style="flex-direction:row; align-items:center; gap:8px;"><input type="radio" name="target" value="all" checked style="width:auto;" /> Tất cả sinh viên</label>
                    <label style="flex-direction:row; align-items:center; gap:8px;"><input type="radio" name="target" value="plan" style="width:auto;" /> Sinh viên theo gói</label>
                </div>
            </div>
            <div class="form-group">
                <label>Chọn gói (nếu chọn "Sinh viên theo gói")</label>
                <select name="planId">
                    <option value="">-- Chọn gói --</option>
                    @if (ViewBag.Plans != null)
                    {
                        foreach (var p in (List<BussinessLayer.DTOs.SubscriptionPlanDTO>)ViewBag.Plans)
                        {
                            <option value="@p.Id">@p.Name - @p.Price.ToString("N0") đ</option>
                        }
                    }
                </select>
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:8px;">
                <a asp-action="Dashboard" class="brutal-btn">Huỷ</a>
                <button type="submit" class="brutal-btn btn-pink"><i class="fa-solid fa-paper-plane"></i> Gửi</button>
            </div>
        </form>
    </div>
</div>
