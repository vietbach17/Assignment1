@using BussinessLayer.DTOs
@model IEnumerable<SubscriptionPlanDTO>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quản lý Gói Subscription";
    ViewBag.ActiveMenu = "AdminPlans";
    const int Unlimited = int.MaxValue;
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">HỆ THỐNG</div>
            <h1 class="page-title">Quản lý gói subscription</h1>
            <p class="page-subtitle">Thêm, sửa, xóa các gói dịch vụ AI cho sinh viên.</p>
        </div>
        <button onclick="openModal('addModal')" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Thêm gói mới</button>
    </div>

    @if (TempData["SubSuccessMsg"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["SubSuccessMsg"]</div>
    }
    @if (TempData["SubErrorMsg"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-circle-exclamation"></i> @TempData["SubErrorMsg"]</div>
    }

    <!-- Stats -->
    <div class="stat-grid">
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Tổng gói</span>
                <div class="stat-icon" style="background:var(--pink); color:var(--white);"><i class="fa-solid fa-box"></i></div>
            </div>
            <div class="stat-value">@Model.Count()</div>
        </div>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Giá thấp nhất</span>
                <div class="stat-icon" style="background:var(--green); color:var(--white);"><i class="fa-solid fa-tag"></i></div>
            </div>
            <div class="stat-value text-green" style="font-size:22px;">@(Model.Any() ? Model.Min(p => p.Price).ToString("N0") + " đ" : "—")</div>
            <div class="page-subtitle">Gói @(Model.Any() ? Model.OrderBy(p => p.Price).First().Name : "—")</div>
        </div>
        <div class="stat-card" style="cursor:default;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="stat-label">Giá cao nhất</span>
                <div class="stat-icon" style="background:var(--purple); color:var(--white);"><i class="fa-solid fa-crown"></i></div>
            </div>
            <div class="stat-value text-pink" style="font-size:22px;">@(Model.Any() ? Model.Max(p => p.Price).ToString("N0") + " đ" : "—")</div>
            <div class="page-subtitle">Gói @(Model.Any() ? Model.OrderByDescending(p => p.Price).First().Name : "—")</div>
        </div>
    </div>

    <!-- Table -->
    <div class="brutal-card pad0">
        <div style="padding:18px 20px; border-bottom:3px solid var(--black); display:flex; justify-content:space-between; align-items:center;">
            <h3 class="card-title">Danh sách gói</h3>
            <span class="badge badge-pink">@Model.Count() gói</span>
        </div>
        @if (!Model.Any())
        {
            <div style="padding:48px; text-align:center;">
                <i class="fa-solid fa-box-open" style="font-size:40px; color:#ccc;"></i>
                <p class="text-muted" style="margin:12px 0; font-weight:800;">Chưa có gói nào.</p>
                <button onclick="openModal('addModal')" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Tạo gói đầu tiên</button>
            </div>
        }
        else
        {
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>Tên gói</th><th>Giá</th><th>Giới hạn câu hỏi</th><th>Mô tả</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model)
                        {
                            bool isUnlimited = plan.QuestionLimit >= Unlimited;
                            string badgeClass = plan.Price == 0 ? "badge-gray" : plan.Price < 100000 ? "badge-blue" : "badge-pink";
                            string jsName = plan.Name.Replace("\\", "\\\\").Replace("'", "\\'");
                            string jsDesc = (plan.Description ?? "").Replace("\\", "\\\\").Replace("'", "\\'").Replace("\r", " ").Replace("\n", " ");
                            <tr>
                                <td><span class="badge @badgeClass">@plan.Name</span></td>
                                <td style="font-weight:900;" class="@(plan.Price == 0 ? "text-muted" : "text-green")">@(plan.Price == 0 ? "Miễn phí" : plan.Price.ToString("N0") + " đ")</td>
                                <td>
                                    @if (isUnlimited)
                                    {
                                        <span class="badge badge-green"><i class="fa-solid fa-infinity"></i> Không giới hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-blue">@plan.QuestionLimit câu/ngày</span>
                                    }
                                </td>
                                <td class="text-muted" style="max-width:260px;">@(string.IsNullOrEmpty(plan.Description) ? "—" : plan.Description)</td>
                                <td>
                                    <div style="display:flex; gap:6px;">
                                        <button class="brutal-btn btn-blue sm" onclick="openEditModal(@plan.Id, '@jsName', @plan.Price, @plan.QuestionLimit, '@jsDesc')"><i class="fa-solid fa-pen"></i> Sửa</button>
                                        <form asp-action="DeleteSubscriptionPlan" asp-controller="Admin" method="post" data-confirm="Xóa gói '@plan.Name'? Sinh viên đang dùng sẽ không bị ảnh hưởng ngay nhưng gói sẽ không còn để mua mới." style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@plan.Id" />
                                            <button type="submit" class="brutal-btn btn-red sm"><i class="fa-solid fa-trash"></i> Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add Modal -->
<div id="addModal" class="modal">
    <div class="modal-content">
        <button type="button" class="modal-close" onclick="closeModal('addModal')">&times;</button>
        <h2 class="card-title text-pink" style="margin-bottom:20px;"><i class="fa-solid fa-plus-circle"></i> Thêm gói mới</h2>
        <form asp-action="CreateSubscriptionPlan" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label>Tên gói *</label><input type="text" name="Name" maxlength="100" required placeholder="Ví dụ: Premium Plan" /></div>
            <div class="form-group"><label>Giá (VNĐ) *</label><input type="number" name="Price" min="0" step="1000" required placeholder="0" /></div>
            <div class="form-group">
                <label style="flex-direction:row; align-items:center; gap:8px;">
                    <input type="checkbox" id="add-unlimited" onchange="toggleAddUnlimited(this.checked)" style="width:auto;" />
                    Không giới hạn câu hỏi <span class="badge badge-green"><i class="fa-solid fa-infinity"></i></span>
                </label>
                <div id="add-limit-wrap"><input type="number" id="add-limit" name="QuestionLimit" min="1" required placeholder="Số câu hỏi / ngày" /></div>
                <input type="number" id="add-limit-hidden" value="" style="display:none;" />
            </div>
            <div class="form-group"><label>Mô tả</label><textarea name="Description" rows="3" maxlength="500" placeholder="Mô tả ngắn về gói dịch vụ..."></textarea></div>
            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit" class="brutal-btn btn-pink" style="flex:1;"><i class="fa-solid fa-plus"></i> Tạo gói</button>
                <button type="button" class="brutal-btn" onclick="closeModal('addModal')">Huỷ</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <button type="button" class="modal-close" onclick="closeModal('editModal')">&times;</button>
        <h2 class="card-title text-blue" style="margin-bottom:20px;"><i class="fa-solid fa-pen"></i> Chỉnh sửa gói</h2>
        <form asp-action="EditSubscriptionPlan" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="edit-id" />
            <div class="form-group"><label>Tên gói *</label><input type="text" name="Name" id="edit-name" maxlength="100" required /></div>
            <div class="form-group"><label>Giá (VNĐ) *</label><input type="number" name="Price" id="edit-price" min="0" step="1000" required /></div>
            <div class="form-group">
                <label style="flex-direction:row; align-items:center; gap:8px;">
                    <input type="checkbox" id="edit-unlimited" onchange="toggleEditUnlimited(this.checked, document.getElementById('edit-limit').value)" style="width:auto;" />
                    Không giới hạn câu hỏi <span class="badge badge-green"><i class="fa-solid fa-infinity"></i></span>
                </label>
                <div id="edit-limit-wrap"><input type="number" id="edit-limit" name="QuestionLimit" min="1" required placeholder="Số câu hỏi / ngày" /></div>
            </div>
            <div class="form-group"><label>Mô tả</label><textarea name="Description" id="edit-desc" rows="3" maxlength="500"></textarea></div>
            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit" class="brutal-btn btn-blue" style="flex:1;"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
                <button type="button" class="brutal-btn" onclick="closeModal('editModal')">Huỷ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const INT_MAX = 2147483647;
        function openModal(id) { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        function toggleAddUnlimited(checked) {
            const wrap = document.getElementById('add-limit-wrap');
            const input = document.getElementById('add-limit');
            const hidden = document.getElementById('add-limit-hidden');
            wrap.style.display = checked ? 'none' : 'block';
            if (checked) {
                input.removeAttribute('name'); input.required = false;
                hidden.setAttribute('name', 'QuestionLimit'); hidden.value = INT_MAX;
            } else {
                input.setAttribute('name', 'QuestionLimit'); input.required = true; input.value = '';
                hidden.removeAttribute('name');
            }
        }

        function openEditModal(id, name, price, limit, desc) {
            const isUnlimited = (limit === INT_MAX);
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-price').value = price;
            document.getElementById('edit-desc').value = desc || '';
            document.getElementById('edit-limit').value = isUnlimited ? '' : limit;
            document.getElementById('edit-unlimited').checked = isUnlimited;
            toggleEditUnlimited(isUnlimited, limit);
            openModal('editModal');
        }

        function toggleEditUnlimited(checked, originalLimit) {
            const wrap = document.getElementById('edit-limit-wrap');
            const input = document.getElementById('edit-limit');
            wrap.style.display = checked ? 'none' : 'block';
            input.value = checked ? INT_MAX : (originalLimit == INT_MAX ? '' : originalLimit);
            input.required = !checked;
        }
    </script>
}
