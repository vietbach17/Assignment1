@using BussinessLayer.DTOs
@model IEnumerable<SubscriptionPlanDTO>
@{
    Layout = null;
    ViewData["Title"] = "Quản lý Gói Subscription";
    const int Unlimited = int.MaxValue;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { dark: '#1e3b31', active: '#2c5344', button: '#376b56', text: '#222222', gray: '#f4f6f8' }
                    }
                }
            }
        }

        const INT_MAX = 2147483647;

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        /* ── ADD modal ── */
        function toggleAddUnlimited(checked) {
            const wrap = document.getElementById('add-limit-wrap');
            const input = document.getElementById('add-limit');
            wrap.classList.toggle('hidden', checked);
            input.value = checked ? INT_MAX : '';
            input.required = !checked;
        }

        /* ── EDIT modal ── */
        function openEditModal(id, name, price, limit, desc) {
            const isUnlimited = (limit === INT_MAX);
            document.getElementById('edit-id').value    = id;
            document.getElementById('edit-name').value  = name;
            document.getElementById('edit-price').value = price;
            document.getElementById('edit-desc').value  = desc || '';

            // Unlimited checkbox
            document.getElementById('edit-unlimited').checked = isUnlimited;
            toggleEditUnlimited(isUnlimited, limit);

            openModal('editModal');
        }

        function toggleEditUnlimited(checked, originalLimit) {
            const wrap  = document.getElementById('edit-limit-wrap');
            const input = document.getElementById('edit-limit');
            wrap.classList.toggle('hidden', checked);
            input.value    = checked ? INT_MAX : (originalLimit === INT_MAX ? '' : originalLimit);
            input.required = !checked;
        }

        /* ── DELETE modal ── */
        function openDeleteModal(id, name) {
            document.getElementById('delete-id').value = id;
            document.getElementById('delete-name').innerText = name;
            openModal('deleteModal');
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <!-- Sidebar -->
    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg"><i class="fa-solid fa-shield-halved text-white"></i></div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Admin Portal</p>
            </div>
        </div>
        <div class="px-4 py-2">
            <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
            <ul class="space-y-1">
                <li><a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition"><i class="fa-solid fa-chart-line w-5"></i><span>Bảng điều khiển</span></a></li>
                <li><a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition"><i class="fa-solid fa-users w-5"></i><span>Người Dùng</span></a></li>
                <li><a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition"><i class="fa-solid fa-book w-5"></i><span>Môn Học</span></a></li>
                <li><a asp-action="SubscriptionPlans" asp-controller="Admin" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium"><i class="fa-solid fa-box-open w-5"></i><span>Gói Subscription</span></a></li>
                <li><a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition"><i class="fa-solid fa-house w-5"></i><span>Về trang chủ</span></a></li>
            </ul>
        </div>
        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition"><i class="fa-solid fa-sign-out-alt w-5"></i><span>Đăng xuất</span></a>
        </div>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div></div>
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 bg-purple-100 text-purple-700 rounded-full flex items-center justify-center font-bold text-sm"><i class="fa-solid fa-user-shield"></i></div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">Admin</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <!-- Page header -->
            <div class="flex justify-between items-end mb-8">
                <div>
                    <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">Hệ thống</p>
                    <h2 class="text-2xl font-bold text-gray-800 mb-1">Quản Lý Gói Subscription</h2>
                    <p class="text-gray-500 text-sm">Thêm, sửa, xóa các gói dịch vụ AI cho sinh viên.</p>
                </div>
                <button onclick="openModal('addModal')" class="bg-brand-button hover:bg-brand-active text-white px-4 py-2.5 rounded-xl text-sm font-medium transition shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i><span>Thêm gói mới</span>
                </button>
            </div>

            <!-- Alerts -->
            @if (TempData["SubSuccessMsg"] != null)
            {
                <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-circle-check"></i><span>@TempData["SubSuccessMsg"]</span>
                </div>
            }
            @if (TempData["SubErrorMsg"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i><span>@TempData["SubErrorMsg"]</span>
                </div>
            }

            <!-- Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Tổng gói</span>
                        <div class="w-9 h-9 bg-brand-button/10 rounded-lg flex items-center justify-center"><i class="fa-solid fa-box text-brand-button text-sm"></i></div>
                    </div>
                    <p class="text-3xl font-bold text-gray-800">@Model.Count()</p>
                    <p class="text-xs text-gray-500 mt-1">Gói đang hoạt động</p>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Giá thấp nhất</span>
                        <div class="w-9 h-9 bg-green-50 rounded-lg flex items-center justify-center"><i class="fa-solid fa-tag text-green-600 text-sm"></i></div>
                    </div>
                    <p class="text-2xl font-bold text-green-600">@(Model.Any() ? Model.Min(p => p.Price).ToString("N0") + " đ" : "—")</p>
                    <p class="text-xs text-gray-500 mt-1">Gói @(Model.Any() ? Model.OrderBy(p => p.Price).First().Name : "—")</p>
                </div>
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Giá cao nhất</span>
                        <div class="w-9 h-9 bg-purple-50 rounded-lg flex items-center justify-center"><i class="fa-solid fa-crown text-purple-600 text-sm"></i></div>
                    </div>
                    <p class="text-2xl font-bold text-purple-700">@(Model.Any() ? Model.Max(p => p.Price).ToString("N0") + " đ" : "—")</p>
                    <p class="text-xs text-gray-500 mt-1">Gói @(Model.Any() ? Model.OrderByDescending(p => p.Price).First().Name : "—")</p>
                </div>
            </div>

            <!-- Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-gray-800">Danh sách Gói Subscription</h3>
                    <span class="text-xs bg-brand-button/10 text-brand-button font-semibold px-3 py-1 rounded-full">@Model.Count() gói</span>
                </div>

                @if (!Model.Any())
                {
                    <div class="p-16 text-center">
                        <i class="fa-solid fa-box-open text-5xl text-gray-300 mb-4 block"></i>
                        <h3 class="text-lg font-bold text-gray-600 mb-2">Chưa có gói nào</h3>
                        <button onclick="openModal('addModal')" class="mt-2 inline-flex items-center gap-2 bg-brand-button hover:bg-brand-active text-white font-medium py-2 px-6 rounded-xl transition shadow-sm">
                            <i class="fa-solid fa-plus"></i> Tạo gói đầu tiên
                        </button>
                    </div>
                }
                else
                {
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-100">
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên Gói</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Giá (VNĐ)</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Giới hạn câu hỏi</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mô tả</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var plan in Model)
                            {
                                bool isUnlimited = plan.QuestionLimit >= Unlimited;
                                string badgeClass = plan.Price == 0 ? "bg-gray-100 text-gray-700"
                                    : plan.Price < 100000 ? "bg-blue-100 text-blue-700"
                                    : "bg-purple-100 text-purple-700";

                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold @badgeClass">@plan.Name</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm font-semibold @(plan.Price == 0 ? "text-gray-500" : "text-green-600")">
                                        @(plan.Price == 0 ? "Miễn phí" : plan.Price.ToString("N0") + " đ")
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        @if (isUnlimited)
                                        {
                                            <span class="bg-emerald-50 text-emerald-700 px-2 py-1 rounded-full text-xs font-bold">
                                                <i class="fa-solid fa-infinity mr-1"></i>Không giới hạn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded-full text-xs font-bold">
                                                @plan.QuestionLimit câu/ngày
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500 max-w-xs">
                                        <span title="@plan.Description">@(string.IsNullOrEmpty(plan.Description) ? "—" : plan.Description)</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <button onclick="openEditModal(@plan.Id, '@Html.Raw(plan.Name.Replace("'","\\'"  ))', @plan.Price, @plan.QuestionLimit, '@Html.Raw((plan.Description ?? "").Replace("'","\\'"))')"
                                                    class="px-3 py-1.5 text-xs font-medium text-blue-600 hover:bg-blue-50 bg-white border border-blue-200 rounded-lg transition">
                                                <i class="fa-solid fa-pen mr-1"></i>Sửa
                                            </button>
                                            <button onclick="openDeleteModal(@plan.Id, '@Html.Raw(plan.Name.Replace("'","\\'"  ))')"
                                                    class="px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 bg-white border border-red-200 rounded-lg transition">
                                                <i class="fa-solid fa-trash mr-1"></i>Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </main>

    <!-- ═══════════════════════════════════════════════
         ADD MODAL
    ═══════════════════════════════════════════════ -->
    <div id="addModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="relative w-full max-w-md mx-4">
            <div class="bg-white rounded-2xl shadow-xl">
                <div class="flex items-center justify-between p-5 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900"><i class="fa-solid fa-plus-circle text-brand-button mr-2"></i>Thêm Gói Mới</h3>
                    <button onclick="closeModal('addModal')" class="text-gray-400 hover:bg-gray-100 rounded-lg w-8 h-8 flex justify-center items-center transition"><i class="fa-solid fa-times"></i></button>
                </div>
                <form asp-action="CreateSubscriptionPlan" asp-controller="Admin" method="post" class="p-5 space-y-4">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Tên gói <span class="text-red-500">*</span></label>
                        <input type="text" name="Name" maxlength="100" required
                               class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-brand-button p-2.5"
                               placeholder="Ví dụ: Premium Plan">
                    </div>

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Giá (VNĐ) <span class="text-red-500">*</span></label>
                        <input type="number" name="Price" min="0" step="1000" required
                               class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-brand-button p-2.5"
                               placeholder="0">
                    </div>

                    <!-- Unlimited toggle -->
                    <div>
                        <label class="flex items-center gap-2 cursor-pointer select-none mb-2">
                            <input type="checkbox" id="add-unlimited" onchange="toggleAddUnlimited(this.checked)"
                                   class="w-4 h-4 accent-brand-button rounded">
                            <span class="text-sm font-medium text-gray-700">Không giới hạn câu hỏi</span>
                            <span class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full"><i class="fa-solid fa-infinity mr-1"></i>∞</span>
                        </label>
                        <div id="add-limit-wrap">
                            <input type="number" id="add-limit" name="QuestionLimit" min="1" required
                                   class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-brand-button p-2.5"
                                   placeholder="Số câu hỏi / ngày">
                        </div>
                        <!-- hidden fallback khi unlimited -->
                        <input type="number" id="add-limit-hidden" name="QuestionLimit" value="" class="hidden">
                    </div>

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Mô tả</label>
                        <textarea name="Description" rows="3" maxlength="500"
                                  class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-brand-button p-2.5 resize-none"
                                  placeholder="Mô tả ngắn về gói dịch vụ..."></textarea>
                    </div>

                    <div class="flex gap-3 pt-1">
                        <button type="submit" class="flex-1 bg-brand-button hover:bg-brand-active text-white font-medium py-2.5 rounded-xl transition shadow-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Tạo gói
                        </button>
                        <button type="button" onclick="closeModal('addModal')" class="px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition">Huỷ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         EDIT MODAL
    ═══════════════════════════════════════════════ -->
    <div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="relative w-full max-w-md mx-4">
            <div class="bg-white rounded-2xl shadow-xl">
                <div class="flex items-center justify-between p-5 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900"><i class="fa-solid fa-pen text-blue-600 mr-2"></i>Chỉnh sửa Gói</h3>
                    <button onclick="closeModal('editModal')" class="text-gray-400 hover:bg-gray-100 rounded-lg w-8 h-8 flex justify-center items-center transition"><i class="fa-solid fa-times"></i></button>
                </div>
                <form asp-action="EditSubscriptionPlan" asp-controller="Admin" method="post" class="p-5 space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="edit-id">

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Tên gói <span class="text-red-500">*</span></label>
                        <input type="text" name="Name" id="edit-name" maxlength="100" required
                               class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-blue-500 p-2.5">
                    </div>

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Giá (VNĐ) <span class="text-red-500">*</span></label>
                        <input type="number" name="Price" id="edit-price" min="0" step="1000" required
                               class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-blue-500 p-2.5">
                    </div>

                    <!-- Unlimited toggle -->
                    <div>
                        <label class="flex items-center gap-2 cursor-pointer select-none mb-2">
                            <input type="checkbox" id="edit-unlimited"
                                   onchange="toggleEditUnlimited(this.checked, document.getElementById('edit-limit').value)"
                                   class="w-4 h-4 accent-blue-600 rounded">
                            <span class="text-sm font-medium text-gray-700">Không giới hạn câu hỏi</span>
                            <span class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full"><i class="fa-solid fa-infinity mr-1"></i>∞</span>
                        </label>
                        <div id="edit-limit-wrap">
                            <input type="number" id="edit-limit" name="QuestionLimit" min="1" required
                                   class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-blue-500 p-2.5"
                                   placeholder="Số câu hỏi / ngày">
                        </div>
                    </div>

                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-700">Mô tả</label>
                        <textarea name="Description" id="edit-desc" rows="3" maxlength="500"
                                  class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg focus:ring-1 focus:ring-blue-500 p-2.5 resize-none"></textarea>
                    </div>

                
                    <div class="flex gap-3 pt-1">
                        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded-xl transition shadow-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
                        </button>
                        <button type="button" onclick="closeModal('editModal')" class="px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition">Huỷ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         DELETE MODAL
    ═══════════════════════════════════════════════ -->
    <div id="deleteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="relative w-full max-w-sm mx-4">
            <div class="bg-white rounded-2xl shadow-xl">
                <button onclick="closeModal('deleteModal')" class="absolute top-3 right-3 text-gray-400 hover:bg-gray-100 rounded-lg w-8 h-8 flex justify-center items-center transition"><i class="fa-solid fa-times"></i></button>
                <div class="p-6 text-center">
                    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-trash text-red-500 text-xl"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-800 mb-2">Xác nhận xóa</h3>
                    <p class="text-sm text-gray-500 mb-1">Bạn có chắc muốn xóa gói</p>
                    <p class="font-bold text-gray-800 mb-4" id="delete-name"></p>
                    <p class="text-xs text-red-500 mb-6">⚠️ Sinh viên đang dùng gói này sẽ không bị ảnh hưởng ngay, nhưng gói sẽ không còn hiển thị để mua mới.</p>
                    <form asp-action="DeleteSubscriptionPlan" asp-controller="Admin" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="delete-id">
                        <div class="flex gap-3 justify-center">
                            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium py-2.5 px-6 rounded-xl transition shadow-sm flex items-center gap-2">
                                <i class="fa-solid fa-trash"></i> Xóa gói
                            </button>
                            <button type="button" onclick="closeModal('deleteModal')" class="py-2.5 px-6 bg-white border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-50 transition">Huỷ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Sync add-unlimited: khi checked thì dùng INT_MAX, ẩn input
        document.getElementById('add-unlimited').addEventListener('change', function () {
            const wrap = document.getElementById('add-limit-wrap');
            const input = document.getElementById('add-limit');
            if (this.checked) {
                wrap.classList.add('hidden');
                input.removeAttribute('name');           // bỏ name để không submit
                // thêm hidden field với INT_MAX
                let hidden = document.getElementById('add-limit-hidden');
                hidden.setAttribute('name', 'QuestionLimit');
                hidden.value = INT_MAX;
            } else {
                wrap.classList.remove('hidden');
                input.setAttribute('name', 'QuestionLimit');
                let hidden = document.getElementById('add-limit-hidden');
                hidden.removeAttribute('name');
            }
        });
    </script>
</body>
