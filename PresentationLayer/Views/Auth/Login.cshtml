@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="login-wrapper">
    <div class="commercial-card login-card">
        <div class="brand-logo">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="logo-icon"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
        </div>
        <h2 class="form-title">Đăng Nhập</h2>
        <p class="form-subtitle">Nhập thông tin tài khoản của bạn để tiếp tục</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Username">Tên đăng nhập</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </span>
                    <input asp-for="Username" class="form-control" placeholder="admin / lecturer / student" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label asp-for="Password">Mật khẩu</label>
                    <a href="#" class="forgot-password">Quên mật khẩu?</a>
                </div>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input type="checkbox" id="remember" class="checkbox-custom" />
                <label for="remember">Ghi nhớ đăng nhập</label>
            </div>

            <button type="submit" class="btn-primary btn-block">
                Đăng Nhập
            </button>
        </form>

        <div class="form-footer">
            Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
        </div>
        
        <!-- Tài khoản dùng thử (Thu gọn) -->
        <div class="demo-accounts">
            <p class="demo-title">Tài khoản dùng thử (Click để điền)</p>
            <div class="demo-badges">
                <span onclick="quickFill('admin', 'admin123')" class="badge admin">Admin</span>
                <span onclick="quickFill('lecturer', 'lecturer123')" class="badge lecturer">Lecturer</span>
                <span onclick="quickFill('student', 'student123')" class="badge student">Student</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function quickFill(user, pass) {
            document.getElementById('Username').value = user;
            document.getElementById('Password').value = pass;
        }
    </script>
}

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 2rem;
    }

    .commercial-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        width: 100%;
        max-width: 440px;
        padding: 2.5rem;
    }

    /* Nếu hệ thống đang dùng dark mode chung, có thể điều chỉnh lại để hợp với theme */
    :root[data-theme="dark"] .commercial-card, 
    body {
        /* Reset về dark mode chuyên nghiệp (SaaS Dark) */
    }

    /* App is using dark mode globally, so we adapt the commercial card to look sleek in dark mode */
    .commercial-card {
        background-color: #1e2532; /* Solid dark color instead of glassmorphism */
        border: 1px solid #334155;
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
    }

    .brand-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }
    
    .logo-icon {
        color: #3b82f6;
    }

    .form-title {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-align: center;
        color: #f8fafc;
    }

    .form-subtitle {
        color: #94a3b8;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-group label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #cbd5e1;
    }

    .forgot-password {
        font-size: 0.8rem;
        color: #3b82f6;
        text-decoration: none;
    }
    
    .forgot-password:hover {
        text-decoration: underline;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        color: #64748b;
        display: flex;
    }

    .form-control {
        width: 100%;
        background-color: #0f172a;
        border: 1px solid #334155;
        color: #f8fafc;
        padding: 0.75rem 1rem 0.75rem 2.75rem;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
    
    .form-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: -0.25rem;
    }
    
    .checkbox-custom {
        width: 1rem;
        height: 1rem;
        accent-color: #3b82f6;
        cursor: pointer;
    }
    
    .form-check label {
        font-size: 0.85rem;
        color: #94a3b8;
        cursor: pointer;
        user-select: none;
    }

    .btn-block {
        width: 100%;
        padding: 0.85rem;
        margin-top: 0.5rem;
        border-radius: 8px;
        background-color: #3b82f6;
        color: white;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    
    .btn-block:hover {
        background-color: #2563eb;
    }

    .validation-summary {
        color: #ef4444;
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .text-danger {
        color: #ef4444;
        font-size: 0.8rem;
    }

    .alert-success {
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.85rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-footer {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.85rem;
        color: #94a3b8;
    }

    .form-footer a {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 500;
    }

    .form-footer a:hover {
        text-decoration: underline;
    }

    /* Demo accounts styling */
    .demo-accounts {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #334155;
        text-align: center;
    }
    
    .demo-title {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
    }
    
    .demo-badges {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
    }
    
    .badge {
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .badge.admin { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }
    .badge.lecturer { background: rgba(59, 130, 246, 0.15); color: #93c5fd; }
    .badge.student { background: rgba(168, 85, 247, 0.15); color: #d8b4fe; }
    
    .badge:hover { filter: brightness(1.2); }
</style>
