@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - EduQuest</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Outfit', sans-serif; background-color: #1f2128; color: #fff; height: 100vh; overflow: hidden; display: flex; }
        .split-layout { display: flex; width: 100%; height: 100%; }
        
        .left-panel {
            flex: 1; padding: 4rem 10%; display: flex; flex-direction: column; background-color: #1c1e26;
            max-width: 55%; overflow-y: auto;
        }
        .right-panel {
            flex: 1; background: linear-gradient(rgba(28, 30, 38, 0.75), rgba(28, 30, 38, 0.95)), url('https://images.unsplash.com/photo-1511497584788-876760111969?q=80&w=2000&auto=format&fit=crop') no-repeat center center;
            background-size: cover; border-top-left-radius: 40px; border-bottom-left-radius: 40px;
            position: relative;
        }
        
        .brand { display: flex; align-items: center; gap: 0.75rem; font-weight: 700; font-size: 1.2rem; margin-bottom: 5rem; text-decoration: none; color: #fff; }
        .brand-dot { width: 24px; height: 24px; background-color: #3b82f6; border-radius: 50%; }
        
        .form-container { max-width: 480px; width: 100%; margin: 0 auto; }
        .subtitle { color: #8e95a3; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; font-weight: 600; }
        .title { font-size: 2.5rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 0.5rem; }
        .title-dot { width: 10px; height: 10px; background-color: #3b82f6; border-radius: 50%; display: inline-block; }
        
        .alt-action { color: #8e95a3; font-size: 0.95rem; margin-bottom: 2.5rem; }
        .alt-action a { color: #3b82f6; text-decoration: none; font-weight: 500; }
        
        .form-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
        .form-row { display: flex; gap: 1rem; }
        .form-row .form-group { flex: 1; }
        
        label { font-size: 0.75rem; color: #8e95a3; padding-left: 0.5rem; }
        
        .form-control {
            width: 100%; background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);
            color: #fff; padding: 1rem 1.25rem; border-radius: 12px; font-size: 0.95rem; font-family: inherit;
            transition: all 0.2s; outline: none;
        }
        .form-control:focus { border-color: #3b82f6; background-color: rgba(255, 255, 255, 0.06); }
        .form-control::placeholder { color: rgba(255,255,255,0.2); }
        
        .btn-group { display: flex; gap: 1rem; margin-top: 2.5rem; }
        .btn { padding: 0.9rem 2rem; border-radius: 99px; font-weight: 600; font-size: 0.95rem; cursor: pointer; border: none; transition: all 0.2s; text-align: center; }
        .btn-primary { background-color: #3b82f6; color: #fff; flex: 1; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3); }
        .btn-primary:hover { background-color: #2563eb; transform: translateY(-1px); }
        .btn-secondary { background-color: rgba(255, 255, 255, 0.1); color: #fff; flex: 1; text-decoration: none; display: flex; align-items: center; justify-content: center; }
        .btn-secondary:hover { background-color: rgba(255, 255, 255, 0.15); }
        
        .validation-summary { margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem; background: rgba(239, 68, 68, 0.1); padding: 1rem; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.2); }
        .text-danger { color: #fca5a5; font-size: 0.8rem; margin-top: 0.25rem; padding-left: 0.5rem; display: block; }
        .alert-success { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #6ee7b7; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: 0.9rem; }
        
        .form-check { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; padding-left: 0.5rem; }
        .form-check label { padding-left: 0; font-size: 0.85rem; cursor: pointer; }
        
        .aw-logo { position: absolute; bottom: 3rem; right: 3rem; font-size: 2.2rem; font-weight: 800; letter-spacing: -2px; color: #fff; display: flex; align-items: baseline; gap: 0.2rem; }
        .aw-logo-dot { width: 7px; height: 7px; background-color: #fff; border-radius: 50%; display: inline-block; }
        
        .demo-accounts { margin-top: 3rem; text-align: center; }
        .demo-title { font-size: 0.75rem; color: #64748b; text-transform: uppercase; margin-bottom: 1rem; }
        .demo-badges { display: flex; justify-content: center; gap: 0.75rem; }
        .badge { padding: 0.35rem 0.75rem; border-radius: 6px; font-size: 0.75rem; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .badge.admin { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }
        .badge.lecturer { background: rgba(59, 130, 246, 0.15); color: #93c5fd; }
        .badge.student { background: rgba(168, 85, 247, 0.15); color: #d8b4fe; }
        .badge:hover { filter: brightness(1.2); }
        
        @@media (max-width: 992px) {
            .left-panel { max-width: 100%; padding: 3rem 5%; }
            .right-panel { display: none; }
        }
    </style>
</head>
<body>
    <div class="split-layout">
        <div class="left-panel">
            <a href="/" class="brand">
                <div class="brand-dot"></div>
                EduQuest app.
            </a>
            
            <div class="form-container">
                <div class="subtitle">CHÀO MỪNG TRỞ LẠI</div>
                <h1 class="title">Đăng nhập<span class="title-dot"></span></h1>
                <p class="alt-action">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success">@TempData["SuccessMessage"]</div>
                }
                
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div asp-validation-summary="ModelOnly" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                    <div class="form-group">
                        <label asp-for="Username">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="remember" name="remember" />
                        <label for="remember">Ghi nhớ phiên đăng nhập</label>
                    </div>

                    <div class="btn-group">
                        <a href="/" class="btn btn-secondary">Về trang chủ</a>
                        <button type="submit" class="btn btn-primary">Đăng nhập</button>
                    </div>
                </form>
                
                <!-- Demo Accounts cho Mentor / Testing -->
                <div class="demo-accounts">
                    <p class="demo-title">Tài khoản dùng thử</p>
                    <div class="demo-badges">
                        <span onclick="quickFill('admin', 'admin123')" class="badge admin">Admin</span>
                        <span onclick="quickFill('lecturer', 'lecturer123')" class="badge lecturer">Lecturer</span>
                        <span onclick="quickFill('student', 'student123')" class="badge student">Student</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="right-panel">
            <div class="aw-logo"><span class="aw-logo-dot"></span>EQ<span class="aw-logo-dot" style="margin-left: 2px;"></span></div>
        </div>
    </div>
    
    <script>
        function quickFill(user, pass) {
            document.getElementById('Username').value = user;
            document.getElementById('Password').value = pass;
        }
    </script>
</body>
</html>
