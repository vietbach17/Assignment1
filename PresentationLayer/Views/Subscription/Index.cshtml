@model IEnumerable<BussinessLayer.DTOs.SubscriptionPlanDTO>
@{
    ViewData["Title"] = "Gói Hội Viên";
    int currentPlanId = ViewBag.CurrentPlanId ?? 0;
    ViewBag.ActiveMenu = "Subscription";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - EduManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap');
        
        :root {
            --pink: #eb2f64; --yellow: #f4cf45; --green: #5cb85c; 
            --blue: #4fa8db; --black: #000; --white: #fff; --bg: #f4f4f6;
            --border: 3px solid var(--black);
            --shadow: 4px 4px 0px 0px var(--black);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Be Vietnam Pro', sans-serif; }
        
        body {
            background-color: var(--bg);
            display: flex; min-height: 100vh; color: var(--black);
            background-image: radial-gradient(#d1d1d1 2px, transparent 2px);
        }

        /* Sidebar */
        .sidebar {
            width: 260px; background: var(--white); border-right: var(--border);
            padding: 30px 20px; display: flex; flex-direction: column; gap: 15px;
            position: sticky; top: 0; height: 100vh;
        }
        .logo { color: var(--pink); font-size: 22px; font-weight: 900; margin-bottom: 20px; }
        .nav-item {
            padding: 12px 15px; font-weight: 800; color: var(--black);
            text-decoration: none; display: flex; align-items: center; gap: 12px;
            border: 3px solid transparent; transition: 0.1s;
        }
        .nav-item.active {
            background: var(--pink); color: var(--white);
            border-color: var(--black); box-shadow: var(--shadow);
        }
        .nav-item:not(.active):hover { border-color: var(--black); transform: translate(-2px, -2px); box-shadow: var(--shadow); }

        /* Main Content */
        .main-content { flex: 1; padding: 40px; }
        .title-page { font-size: 28px; font-weight: 900; margin-bottom: 20px; text-transform: uppercase; }
        .brutal-box { background: var(--white); border: var(--border); box-shadow: 6px 6px 0px 0px var(--black); padding: 25px; }
        .brutal-btn { border: 2px solid var(--black); font-weight: 800; cursor: pointer; box-shadow: 2px 2px 0px 0px var(--black); padding: 8px 15px; }
        .brutal-btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 0 var(--black); }

        /* User Profile */
        .user-profile {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            background-color: var(--white);
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
        }
        .avatar-box {
            width: 36px; height: 36px; background-color: var(--pink);
            border: 2px solid var(--black); display: flex; align-items: center; justify-content: center;
            color: var(--white); font-size: 14px; flex-shrink: 0;
        }
        .user-info { display: flex; flex-direction: column; }
        .user-info .username { font-weight: 800; font-size: 12px; color: var(--black); }
        .user-info .role { font-weight: 700; font-size: 10px; color: #666; text-transform: uppercase; margin-top: 2px; }

        /* Plans Grid */
        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .plan-card {
            background: var(--white);
            border: var(--border);
            box-shadow: 6px 6px 0px 0px var(--black);
            padding: 25px;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .plan-badge {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--yellow);
            border: 2px solid var(--black);
            padding: 5px 12px;
            font-weight: 900;
            font-size: 11px;
            text-transform: uppercase;
            box-shadow: 2px 2px 0px var(--black);
        }

        .plan-badge.current {
            background: var(--green);
            color: var(--white);
        }

        .plan-name {
            font-size: 18px;
            font-weight: 900;
            margin-bottom: 10px;
            margin-top: 15px;
        }

        .plan-description {
            font-size: 13px;
            color: #666;
            margin-bottom: 15px;
        }

        .plan-price {
            font-size: 32px;
            font-weight: 900;
            color: var(--pink);
            margin-bottom: 15px;
        }

        .plan-features {
            list-style: none;
            margin: 15px 0;
            flex-grow: 1;
        }

        .plan-features li {
            font-size: 13px;
            margin-bottom: 10px;
            padding-left: 20px;
            position: relative;
            font-weight: 700;
        }

        .plan-features li::before {
            content: "✓";
            position: absolute;
            left: 0;
            font-weight: 900;
            color: var(--green);
        }

        .plan-action {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

        .btn-plan {
            flex: 1;
            padding: 10px;
            border: 2px solid var(--black);
            background: var(--white);
            color: var(--black);
            font-weight: 800;
            cursor: pointer;
            box-shadow: 2px 2px 0px var(--black);
            text-decoration: none;
            text-align: center;
            transition: 0.1s;
        }

        .btn-plan:active {
            transform: translate(2px, 2px);
            box-shadow: 0 0 0 var(--black);
        }

        .btn-plan.primary {
            background: var(--pink);
            color: var(--white);
        }

        .btn-plan.disabled {
            background: #e5e5e5;
            color: #999;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .alert-box {
            background: var(--yellow);
            border: var(--border);
            box-shadow: 4px 4px 0px var(--black);
            padding: 15px;
            margin-bottom: 20px;
            font-weight: 700;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo"><i class="fa-solid fa-graduation-cap"></i> EduManager</div>
        <a asp-controller="Home" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Overview" ? "active" : "")"><i class="fa-solid fa-border-all"></i> TỔNG QUAN</a>
        <a asp-controller="StudentDocument" asp-action="Subjects" class="nav-item @(ViewBag.ActiveMenu == "Subjects" ? "active" : "")"><i class="fa-solid fa-book-open"></i> MÔN HỌC</a>
        <a asp-controller="StudentDocument" asp-action="Documents" class="nav-item @(ViewBag.ActiveMenu == "Docs" ? "active" : "")"><i class="fa-regular fa-file-lines"></i> TÀI LIỆU</a>
        <a asp-controller="Home" asp-action="Chat" class="nav-item @(ViewBag.ActiveMenu == "AI" ? "active" : "")"><i class="fa-solid fa-robot"></i> CHAT AI</a>
        <a asp-controller="Subscription" asp-action="Index" class="nav-item @(ViewBag.ActiveMenu == "Subscription" ? "active" : "")"><i class="fa-solid fa-crown"></i> GÓI HỘI VIÊN</a>

        <div style="margin-top:auto;">
            <div class="brutal-box" style="display:flex;align-items:center;gap:12px;padding:10px;">
                <div class="avatar-box">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="user-info">
                    <div class="username">@User.Identity?.Name</div>
                    <div class="role">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>
                </div>
            </div>
            <a asp-controller="Auth" asp-action="Logout" class="nav-item" style="border:dashed 2px var(--black);margin-top:10px">Log out</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="title-page">NÂNG CẤP ĐẶC QUYỀN <i class="fa-solid fa-crown" style="color:#666;"></i></h1>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-box" style="background: #ffb3b3; color: #c00;">
                ⚠️ @TempData["ErrorMessage"]
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
        {
            <div style="margin-bottom:20px;">
                <a asp-action="MySubscription" class="brutal-btn" style="background:var(--green);color:var(--white);">💳 Xem Gói Của Tôi</a>
            </div>
        }

        <div class="plans-grid">
            @foreach (var item in Model)
            {
                bool isCurrentPlan = (item.Id == currentPlanId);

                <div class="plan-card">
                    @if (isCurrentPlan)
                    {
                        <div class="plan-badge current">✅ Hiện tại</div>
                    }
                    else if (item.Name == "Basic")
                    {
                        <div class="plan-badge">⭐ Phổ biến</div>
                    }

                    <div class="plan-name">@item.Name</div>
                    <div class="plan-description">@item.Description</div>
                    <div class="plan-price">@item.Price.ToString("#,##0")<span style="font-size:16px;color:#999">đ</span></div>

                    <ul class="plan-features">
                        <li>
                            @if (item.QuestionLimit >= 9999)
                            {
                                <span>Vô hạn câu hỏi</span>
                            }
                            else
                            {
                                <span>@item.QuestionLimit câu hỏi/ngày</span>
                            }
                        </li>
                        <li>Phản hồi ưu tiên</li>
                        <li>Trích dẫn tài liệu PDF/Docx</li>
                        <li>Hỗ trợ 24/7</li>
                    </ul>

                    <div class="plan-action">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                        {
                            @if (isCurrentPlan)
                            {
                                <button class="btn-plan disabled" disabled>✅ Đang dùng</button>
                            }
                            else
                            {
                                <form asp-action="BuyPlan" method="post" style="flex:1;">
                                    <input type="hidden" name="planId" value="@item.Id" />
                                    <button type="submit" class="btn-plan primary" style="width:100%;">
                                        @(item.Price == 0 ? "Sử dụng miễn phí" : "Nâng cấp")
                                    </button>
                                </form>
                            }
                        }
                        else if (!User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn-plan primary">Đăng nhập</a>
                        }
                        else
                        {
                            <button class="btn-plan disabled" disabled>Dành cho Student</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>
