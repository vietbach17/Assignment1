@model IEnumerable<BussinessLayer.DTOs.SubjectDto>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Môn phụ trách";
    ViewBag.ActiveMenu = "MySubjects";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">GIẢNG VIÊN</div>
            <h1 class="page-title">Môn phụ trách</h1>
            <p class="page-subtitle">Danh sách các môn học mà bạn được phân công quản lý và upload tài liệu.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Tạo môn mới</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="brutal-card" style="text-align:center; padding:48px;">
            <i class="fa-solid fa-user-xmark" style="font-size:40px; color:#ccc;"></i>
            <h3 class="card-title" style="margin:12px 0 6px;">Chưa được phân công môn nào</h3>
            <p class="text-muted" style="font-weight:700; margin-bottom:16px;">Hiện tại bạn chưa được phân công quản lý môn học nào. Vui lòng liên hệ Admin.</p>
        </div>
    }
    else
    {
        <div class="brutal-card pad0">
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>Mã môn</th><th>Tên môn</th><th>Mô tả</th><th style="text-align:right;">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model)
                        {
                            <tr>
                                <td><span class="badge badge-green">@subject.SubjectCode</span></td>
                                <td style="font-weight:900;">@subject.SubjectName</td>
                                <td class="text-muted" style="max-width:320px;">
                                    @if (!string.IsNullOrEmpty(subject.Description))
                                    {
                                        @(subject.Description.Length > 80 ? subject.Description.Substring(0, 80) + "..." : subject.Description)
                                    }
                                    else
                                    {
                                        <span style="font-style:italic; opacity:0.6;">Không có mô tả</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:6px; justify-content:flex-end;">
                                        <a asp-action="Details" asp-route-id="@subject.Id" class="brutal-btn btn-blue sm" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                                        {
                                            <a asp-controller="Document" asp-action="Upload" asp-route-subjectId="@subject.Id" class="brutal-btn btn-pink sm" title="Tải tài liệu"><i class="fa-solid fa-cloud-arrow-up"></i></a>
                                            <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@subject.Id" class="brutal-btn btn-green sm" title="Quản lý chương"><i class="fa-solid fa-list"></i></a>
                                        }
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@subject.Id" class="brutal-btn btn-yellow sm" title="Sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                            <a asp-action="Delete" asp-route-id="@subject.Id" class="brutal-btn btn-red sm" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
