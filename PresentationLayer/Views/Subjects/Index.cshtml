@model IEnumerable<BussinessLayer.DTOs.SubjectDto>
@{
    ViewData["Title"] = "Môn Học";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Quản lý nội dung</p>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-chart-line w-5"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-users w-5"></i>
                            <span>Người Dùng</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Admin" asp-controller="Subscription" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-box-open w-5"></i>
                            <span>Gói Subscription</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Về trang chủ</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-border-all w-5"></i>
                            <span>Tổng quan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 bg-brand-active text-white px-4 py-2.5 rounded-lg text-sm font-medium transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-regular fa-file-lines w-5"></i>
                            <span>Tài liệu</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Tìm kiếm môn học..." class="w-full bg-gray-50 border-none rounded-full pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-button">
            </div>
            
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8 flex justify-between items-end">
                <div>
                    <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">Quản lý đào tạo</p>
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">Danh sách Môn học</h2>
                    <p class="text-gray-500 text-sm">Xem và quản lý tất cả các môn học trong hệ thống.</p>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="bg-brand-button hover:bg-brand-active text-white font-medium py-2 px-4 rounded-xl transition shadow-sm inline-flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i>
                        Tạo Môn mới
                    </a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="bg-white p-12 rounded-2xl shadow-sm border border-gray-100 text-center">
                    <i class="fa-solid fa-books text-4xl text-gray-300 mb-4 block"></i>
                    <h3 class="text-lg font-bold text-gray-800 mb-2">Chưa có môn học nào</h3>
                    <p class="text-gray-500 text-sm mb-6">Hiện tại hệ thống chưa có môn học nào được tạo.</p>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="inline-block bg-brand-button hover:bg-brand-active text-white font-medium py-2 px-6 rounded-xl transition">
                            Tạo môn học đầu tiên
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-100">
                                <th class="py-4 px-6 font-semibold">Mã môn</th>
                                <th class="py-4 px-6 font-semibold">Tên môn</th>
                                <th class="py-4 px-6 font-semibold hidden md:table-cell">Mô tả</th>
                                <th class="py-4 px-6 font-semibold text-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subject in Model)
                            {
                                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                    <td class="py-4 px-6">
                                        <span class="font-bold text-brand-active bg-teal-50 px-3 py-1 rounded-full text-xs">@subject.SubjectCode</span>
                                    </td>
                                    <td class="py-4 px-6 font-medium text-gray-800">
                                        @subject.SubjectName
                                    </td>
                                    <td class="py-4 px-6 text-sm text-gray-500 hidden md:table-cell">
                                        @if (!string.IsNullOrEmpty(subject.Description))
                                        {
                                            @(subject.Description.Length > 80 ? subject.Description.Substring(0, 80) + "..." : subject.Description)
                                        }
                                        else
                                        {
                                            <span class="italic opacity-50">Không có mô tả</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <div class="flex justify-end items-center gap-2">
                                            <a asp-action="Details" asp-route-id="@subject.Id" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="Chi tiết">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                                            {
                                                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@subject.Id" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition" title="Quản lý Chương">
                                                    <i class="fa-solid fa-list"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@subject.Id" class="p-2 text-orange-500 hover:bg-orange-50 rounded-lg transition" title="Sửa">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@subject.Id" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Xóa">
                                                    <i class="fa-solid fa-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

</body>
</html>
