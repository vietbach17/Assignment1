@model IEnumerable<BussinessLayer.DTOs.SubjectDto>

@{
    ViewData["Title"] = "Subjects";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .alert {
        padding: 1rem 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        border: 1px solid;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background-color: rgba(16, 185, 129, 0.1);
        border-color: rgba(16, 185, 129, 0.3);
        color: #34d399;
    }

    .alert-danger {
        background-color: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-create {
        background: linear-gradient(135deg, var(--accent-emerald) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }

    .subjects-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .subjects-table thead {
        background-color: rgba(168, 85, 247, 0.1);
    }

    .subjects-table th {
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
    }

    .subjects-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-secondary);
    }

    .subjects-table tbody tr {
        transition: var(--transition-smooth);
    }

    .subjects-table tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.02);
    }

    .subject-code {
        font-weight: 600;
        color: var(--accent-purple);
        font-size: 1rem;
    }

    .subject-name {
        color: var(--text-primary);
        font-weight: 500;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-action {
        padding: 0.4rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: var(--transition-smooth);
        border: 1px solid;
    }

    .btn-details {
        background-color: rgba(59, 130, 246, 0.1);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.3);
    }

    .btn-details:hover {
        background-color: var(--accent-blue);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .btn-edit {
        background-color: rgba(249, 115, 22, 0.1);
        color: #fb923c;
        border-color: rgba(249, 115, 22, 0.3);
    }

    .btn-edit:hover {
        background-color: var(--accent-orange);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    }

    .btn-delete {
        background-color: rgba(239, 68, 68, 0.1);
        color: #fca5a5;
        border-color: rgba(239, 68, 68, 0.3);
    }

    .btn-delete:hover {
        background-color: var(--danger);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-chapters {
        background-color: rgba(16, 185, 129, 0.1);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.3);
    }

    .btn-chapters:hover {
        background-color: var(--accent-emerald);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-secondary);
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Subjects</h1>
    <p class="page-subtitle">Manage all subjects in the system</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <span>✓</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <span>✕</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<div class="action-bar">
    <div></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn-create">
            <span>+</span>
            <span>Create New Subject</span>
        </a>
    }
</div>

@if (Model.Any())
{
    <table class="subjects-table">
        <thead>
            <tr>
                <th style="width: 15%;">Subject Code</th>
                <th style="width: 30%;">Subject Name</th>
                <th style="width: 35%;">Description</th>
                <th style="width: 20%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in Model)
            {
                <tr>
                    <td>
                        <span class="subject-code">@subject.SubjectCode</span>
                    </td>
                    <td>
                        <span class="subject-name">@subject.SubjectName</span>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(subject.Description))
                        {
                            <span>@(subject.Description.Length > 80 ? subject.Description.Substring(0, 80) + "..." : subject.Description)</span>
                        }
                        else
                        {
                            <span style="font-style: italic; opacity: 0.5;">No description</span>
                        }
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a asp-action="Details" asp-route-id="@subject.Id" class="btn-action btn-details">Details</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                            {
                                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@subject.Id" class="btn-action btn-chapters" title="Manage Chapters">Chapters</a>
                                <a asp-action="Edit" asp-route-id="@subject.Id" class="btn-action btn-edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@subject.Id" class="btn-action btn-delete">Delete</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="glass-card empty-state">
        <div class="empty-state-icon">📚</div>
        <h3>No Subjects Yet</h3>
        <p>There are no subjects in the system yet.</p>
        @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
        {
            <p style="margin-top: 1rem;">
                <a asp-action="Create" class="btn-create">Create First Subject</a>
            </p>
        }
    </div>
}
