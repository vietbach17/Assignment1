@model BussinessLayer.DTOs.SubjectDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Xoá môn học";
    ViewBag.ActiveMenu = "Subjects";
    var hasChapters = Model.Chapters != null && Model.Chapters.Any();
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Môn học</a> › Xóa</div>
            <h1 class="page-title" style="color:#d11;">Xóa môn học</h1>
        </div>
        <a asp-action="Index" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:640px; border-color:#d11;">
        <div class="alert alert-error" style="align-items:flex-start;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:20px;"></i>
            <div>
                <div style="font-weight:900;">Cảnh báo: Bạn đang chuẩn bị xóa môn học!</div>
                <div style="font-weight:600;">Hành động này không thể hoàn tác.</div>
            </div>
        </div>

        <div style="border:2px solid var(--black); padding:16px; margin-bottom:16px;">
            <h3 class="card-title">@Model.SubjectName</h3>
            <p class="text-muted" style="font-weight:700; margin-top:4px;">Mã môn: <span style="font-family:monospace;">@Model.SubjectCode</span></p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div style="margin-top:10px; font-weight:600;">@(Model.Description.Length > 150 ? Model.Description.Substring(0, 150) + "..." : Model.Description)</div>
            }
        </div>

        @if (hasChapters)
        {
            <div class="alert alert-warning" style="align-items:flex-start;">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div>
                    <div style="font-weight:900;">Môn học này có chứa các chương</div>
                    <div style="font-weight:600;">Việc xóa môn học sẽ xóa toàn bộ nội dung và tài liệu liên quan bên trong.</div>
                </div>
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div style="display:flex; gap:12px; margin-top:8px;">
                <a asp-action="Index" class="brutal-btn" style="flex:1;">Hủy bỏ, quay lại</a>
                <button type="submit" class="brutal-btn btn-red" style="flex:1;"><i class="fa-solid fa-trash-can"></i> Xác nhận xóa</button>
            </div>
        </form>
    </div>
</div>
