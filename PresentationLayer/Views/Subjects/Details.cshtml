@model BussinessLayer.DTOs.SubjectDto
@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chi tiết môn học";
    ViewBag.ActiveMenu = "Subjects";
    var documents = ViewBag.Documents as IEnumerable<DocumentDto> ?? Enumerable.Empty<DocumentDto>();
    string FileBadge(string ft) => ft switch { "pdf" => "badge-red", "docx" => "badge-blue", "pptx" => "badge-yellow", _ => "badge-gray" };
    string FileIcon(string ft) => ft switch { "pdf" => "fa-file-pdf", "docx" => "fa-file-word", "pptx" => "fa-file-powerpoint", _ => "fa-file" };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Môn học</a> › Chi tiết</div>
            <h1 class="page-title">@Model.SubjectName</h1>
            <p class="page-subtitle">Mã môn: <span style="font-family:monospace; font-weight:900;">@Model.SubjectCode</span></p>
        </div>
        <div style="display:flex; gap:10px;">
            <a asp-action="Index" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="brutal-btn btn-yellow"><i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa</a>
            }
        </div>
    </div>

    <!-- Mô tả -->
    <div class="brutal-card" style="margin-bottom:22px;">
        <h3 class="card-title" style="margin-bottom:12px;">Mô tả</h3>
        <div style="white-space:pre-wrap; font-weight:600; line-height:1.6;">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span class="text-muted" style="font-style:italic;">Không có mô tả cho môn học này.</span>
            }
        </div>
    </div>

    <!-- Chương -->
    <div class="brutal-card" style="margin-bottom:22px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
            <h3 class="card-title">Danh sách chương</h3>
            <span class="badge badge-green">@((Model.Chapters?.Count() ?? 0)) chương</span>
        </div>
        @if (Model.Chapters == null || !Model.Chapters.Any())
        {
            <p class="text-muted" style="font-weight:700;">Môn học này chưa có chương nào.</p>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var chapter in Model.Chapters.OrderBy(c => c.ChapterNumber))
                {
                    <a asp-controller="Chapters" asp-action="Details" asp-route-id="@chapter.Id"
                       style="display:flex; align-items:center; justify-content:space-between; padding:14px; border:2px solid var(--black); text-decoration:none; color:var(--black); background:var(--white);">
                        <div>
                            <div class="text-green" style="font-size:11px; font-weight:900; text-transform:uppercase;">Chương @chapter.ChapterNumber</div>
                            <div style="font-weight:900; margin-top:2px;">@chapter.ChapterTitle</div>
                            @if (!string.IsNullOrEmpty(chapter.Description))
                            {
                                <div class="page-subtitle" style="margin-top:4px;">@(chapter.Description.Length > 120 ? chapter.Description.Substring(0, 120) + "..." : chapter.Description)</div>
                            }
                        </div>
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Tài liệu -->
    <div class="brutal-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
            <div style="display:flex; gap:12px; align-items:center;">
                <h3 class="card-title">Tài liệu của môn</h3>
                <span class="badge badge-blue">@documents.Count() tài liệu</span>
            </div>
            @if (ViewBag.CanManage == true)
            {
                <div style="display:flex; gap:8px;">
                    <a asp-controller="Document" asp-action="ActivityLog" asp-route-subjectId="@Model.Id" class="brutal-btn btn-yellow sm" title="Xem hoạt động thao tác tài liệu"><i class="fa-solid fa-clock-rotate-left"></i> Hoạt động</a>
                    <a asp-controller="Document" asp-action="Upload" asp-route-subjectId="@Model.Id" class="brutal-btn btn-pink sm"><i class="fa-solid fa-cloud-arrow-up"></i> Tải tài liệu</a>
                </div>
            }
        </div>
        @if (!documents.Any())
        {
            <p class="text-muted" style="font-weight:700;">Môn học này chưa có tài liệu nào.</p>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var doc in documents)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px; border:2px solid var(--black); background:var(--white);">
                        <div style="display:flex; align-items:center; gap:12px; min-width:0;">
                            <span class="badge @FileBadge(doc.FileType)"><i class="fa-solid @FileIcon(doc.FileType)"></i></span>
                            <div style="min-width:0;">
                                <div style="font-weight:900;">@doc.Title</div>
                                <div class="page-subtitle">@(string.IsNullOrEmpty(doc.ChapterTitle) ? "Chưa gắn chương" : doc.ChapterTitle) • @doc.FileSizeDisplay • @doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; flex-shrink:0;">
                            <a asp-controller="Document" asp-action="Details" asp-route-id="@doc.Id" class="brutal-btn btn-blue sm"><i class="fa-solid fa-eye"></i> Xem</a>
                            <a asp-controller="Document" asp-action="Download" asp-route-id="@doc.Id" class="brutal-btn btn-green sm"><i class="fa-solid fa-download"></i> Tải</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
