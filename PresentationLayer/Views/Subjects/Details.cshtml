@model BussinessLayer.DTOs.SubjectDto
@{
    ViewData["Title"] = "Chi tiết Môn Học";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Quản lý nội dung</p>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-chart-line w-5"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-users w-5"></i>
                            <span>Người Dùng</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Admin" asp-controller="Subscription" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-box-open w-5"></i>
                            <span>Gói Subscription</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Về trang chủ</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-border-all w-5"></i>
                            <span>Tổng quan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 bg-brand-active text-white px-4 py-2.5 rounded-lg text-sm font-medium transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-regular fa-file-lines w-5"></i>
                            <span>Tài liệu</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="flex items-center gap-4 text-sm text-gray-500">
                <a asp-action="Index" class="hover:text-brand-active transition">Môn học</a>
                <i class="fa-solid fa-chevron-right text-xs"></i>
                <span class="font-semibold text-gray-800">Chi tiết môn học</span>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="max-w-3xl mx-auto">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-brand-active to-brand-button p-8 text-white flex justify-between items-end">
                        <div>
                            <span class="inline-block px-3 py-1 bg-white/20 rounded-full text-xs font-semibold mb-3">Thông tin chi tiết</span>
                            <h2 class="text-3xl font-bold mb-1">@Model.SubjectName</h2>
                            <p class="text-brand-gray/80 text-lg">Mã môn: <span class="font-mono font-bold">@Model.SubjectCode</span></p>
                        </div>
                        <div class="text-right">
                            <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center text-3xl">
                                📚
                            </div>
                        </div>
                    </div>

                    <div class="p-8">
                        <div class="mb-8">
                            <h3 class="text-lg font-semibold text-gray-800 mb-3 border-b border-gray-100 pb-2">Mô tả</h3>
                            <div class="text-gray-600 bg-gray-50 p-4 rounded-xl text-sm leading-relaxed whitespace-pre-wrap">
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    @Model.Description
                                }
                                else
                                {
                                    <span class="italic text-gray-400">Không có mô tả cho môn học này.</span>
                                }
                            </div>
                        </div>

                        <div class="flex justify-between items-center pt-4 border-t border-gray-100">
                            <a asp-action="Index" class="text-gray-500 hover:text-gray-800 font-medium py-2 px-4 transition flex items-center gap-2">
                                <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
                            {
                                <div class="flex gap-3">
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-6 rounded-xl transition shadow-sm">
                                        <i class="fa-solid fa-pen-to-square mr-2"></i> Chỉnh sửa
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>
</html>
