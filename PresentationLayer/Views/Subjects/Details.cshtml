@model BussinessLayer.DTOs.SubjectDto

@{
    ViewData["Title"] = $"Subject Details - {Model.SubjectCode}";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .breadcrumb {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: var(--accent-blue);
        text-decoration: none;
        transition: var(--transition-smooth);
    }

    .breadcrumb a:hover {
        color: var(--accent-purple);
    }

    .breadcrumb-separator {
        color: var(--text-secondary);
    }

    .details-card {
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .detail-row {
        display: flex;
        padding: 1rem 0;
        border-bottom: 1px solid var(--border-color);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: var(--text-primary);
        width: 200px;
        flex-shrink: 0;
    }

    .detail-value {
        color: var(--text-secondary);
        flex: 1;
    }

    .subject-code-badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        margin-top: 2rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .chapters-list {
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .chapter-item {
        padding: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .chapter-item:last-child {
        border-bottom: none;
    }

    .chapter-item:hover {
        background-color: rgba(255, 255, 255, 0.02);
    }

    .chapter-number-badge {
        background-color: rgba(168, 85, 247, 0.15);
        color: var(--accent-purple);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        min-width: 60px;
        text-align: center;
    }

    .chapter-info {
        flex: 1;
    }

    .chapter-title {
        color: var(--text-primary);
        font-weight: 500;
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .chapter-description {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent-purple) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        cursor: pointer;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .btn-secondary {
        background-color: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border-color);
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 500;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-secondary);
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 12px;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .btn-view-chapters {
        background: linear-gradient(135deg, var(--accent-emerald) 0%, var(--accent-blue) 100%);
        color: #ffffff;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-view-chapters:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }
</style>

<div class="breadcrumb">
    <a asp-action="Index">Subjects</a>
    <span class="breadcrumb-separator">›</span>
    <span>@Model.SubjectCode</span>
</div>

<div class="page-header">
    <h1 class="page-title">Subject Details</h1>
    <p class="page-subtitle">View detailed information about this subject</p>
</div>

<div class="details-card">
    <div class="detail-row">
        <div class="detail-label">Subject Code:</div>
        <div class="detail-value">
            <span class="subject-code-badge">@Model.SubjectCode</span>
        </div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Subject Name:</div>
        <div class="detail-value">@Model.SubjectName</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Description:</div>
        <div class="detail-value">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span style="font-style: italic; opacity: 0.5;">No description provided</span>
            }
        </div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Created Date:</div>
        <div class="detail-value">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

<div class="section-header">
    <h2 class="section-title">Chapters (@(Model.Chapters?.Count ?? 0))</h2>
    <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.Id" class="btn-view-chapters">
        <span>📖</span>
        <span>View All Chapters</span>
    </a>
</div>

@if (Model.Chapters != null && Model.Chapters.Any())
{
    <div class="chapters-list">
        @foreach (var chapter in Model.Chapters.OrderBy(c => c.ChapterNumber))
        {
            <div class="chapter-item">
                <div class="chapter-number-badge">Ch @chapter.ChapterNumber</div>
                <div class="chapter-info">
                    <div class="chapter-title">@chapter.ChapterTitle</div>
                    @if (!string.IsNullOrEmpty(chapter.Description))
                    {
                        <div class="chapter-description">
                            @(chapter.Description.Length > 100 ? chapter.Description.Substring(0, 100) + "..." : chapter.Description)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">📚</div>
        <h3>No Chapters Yet</h3>
        <p>This subject doesn't have any chapters yet.</p>
    </div>
}

<div class="action-buttons">
    <a asp-action="Index" class="btn-secondary">
        <span>←</span>
        <span>Back to List</span>
    </a>
    @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary">
            <span>✎</span>
            <span>Edit Subject</span>
        </a>
    }
</div>
