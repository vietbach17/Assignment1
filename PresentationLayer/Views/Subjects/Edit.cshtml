@model BussinessLayer.DTOs.UpdateSubjectDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chỉnh sửa môn học";
    ViewBag.ActiveMenu = "Subjects";
    var assignedLecturerIds = ViewBag.AssignedLecturerIds as List<int> ?? new List<int>();
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Môn học</a> › Cập nhật</div>
            <h1 class="page-title">Cập nhật môn học</h1>
            <p class="page-subtitle">Chỉnh sửa thông tin chi tiết của môn học.</p>
        </div>
        <a asp-action="Index" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:640px; margin:0 auto;">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="SubjectCode">Mã môn học *</label>
                <input asp-for="SubjectCode" />
                <span asp-validation-for="SubjectCode" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="SubjectName">Tên môn học *</label>
                <input asp-for="SubjectName" />
                <span asp-validation-for="SubjectName" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Mô tả chi tiết</label>
                <textarea asp-for="Description" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label for="assignedLecturerId">Giảng viên phụ trách upload tài liệu *</label>
                <select id="assignedLecturerId" name="assignedLecturerId">
                    <option value="">-- Chọn giảng viên --</option>
                    @foreach (var lecturer in ViewBag.Lecturers)
                    {
                        var selected = assignedLecturerIds.Contains(lecturer.Id);
                        <option value="@lecturer.Id" selected="@selected">@lecturer.Username</option>
                    }
                </select>
                @Html.ValidationMessage("assignedLecturerId", "", new { @class = "text-pink", style = "font-size:12px;" })
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:8px;">
                <a asp-action="Index" class="brutal-btn">Hủy bỏ</a>
                <button type="submit" class="brutal-btn btn-yellow"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
