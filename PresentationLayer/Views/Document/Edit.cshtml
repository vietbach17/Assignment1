@model BussinessLayer.DTOs.DocumentEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài liệu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Chỉnh sửa tài liệu</p>
            </div>
        </div>

        <div class="px-4 py-2">
            <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
            <ul class="space-y-1">
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-chart-line w-5"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-border-all w-5"></i>
                            <span>Tổng quan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                }
                <li>
                    <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium">
                        <i class="fa-regular fa-file-lines w-5"></i>
                        <span>Tài liệu</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Tìm kiếm..." class="w-full bg-gray-50 border-none rounded-full pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-button">
            </div>

            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8 flex justify-between items-start">
                <div>
                    <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">Không gian giảng viên</p>
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">Chỉnh sửa Tài liệu</h2>
                    <p class="text-gray-500 text-sm">Cập nhật tiêu đề và chương cho tài liệu đã upload.</p>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center space-x-2 text-gray-600 hover:text-gray-800 bg-white hover:bg-gray-100 border border-gray-200 font-medium py-2.5 px-6 rounded-xl transition">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    <i class="fa-solid fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-4xl">
                <!-- Form chỉnh sửa -->
                <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="SubjectId" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"></div>

                        <!-- Title -->
                        <div class="mb-6">
                            <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-2">
                                Tiêu đề tài liệu <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="Title"
                                   class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-button focus:border-transparent"
                                   placeholder="Ví dụ: Slide Chapter 1 - Introduction"
                                   autocomplete="off" />
                            <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <!-- Chapter -->
                        <div class="mb-6">
                            <label asp-for="ChapterId" class="block text-sm font-medium text-gray-700 mb-2">
                                Chương <span class="text-gray-500 text-xs font-normal">(tuỳ chọn)</span>
                            </label>
                            <select asp-for="ChapterId" id="chapterSelect"
                                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-button focus:border-transparent"
                                    asp-items="ViewBag.ChapterList">
                                <option value="">— Không thuộc chương cụ thể —</option>
                            </select>
                            <span asp-validation-for="ChapterId" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <!-- Actions -->
                        <div class="flex gap-3 pt-2">
                            <button type="submit" class="flex-1 bg-brand-button hover:bg-brand-active text-white font-medium py-2.5 px-6 rounded-xl transition shadow-sm">
                                <i class="fa-solid fa-floppy-disk mr-2"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="px-6 py-2.5 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-medium rounded-xl transition">
                                Huỷ
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Thông tin file (read-only) -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="text-base font-bold text-gray-700 mb-4 pb-3 border-b border-gray-100">
                        <i class="fa-solid fa-file-alt mr-2 text-brand-button"></i>Thông tin file
                    </h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Tên file gốc</p>
                            <p class="text-sm text-gray-800 font-medium break-all">@Model.FileName</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Định dạng</p>
                            @{
                                var iconClass = Model.FileType switch {
                                    "pdf" => "fa-file-pdf text-red-500",
                                    "docx" => "fa-file-word text-blue-500",
                                    "pptx" => "fa-file-powerpoint text-orange-500",
                                    _ => "fa-file text-gray-500"
                                };
                            }
                            <p class="text-sm text-gray-800 font-mono uppercase">
                                <i class="fa-solid @iconClass mr-1"></i>@Model.FileType
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Dung lượng</p>
                            <p class="text-sm text-gray-800">@Model.FileSizeDisplay</p>
                        </div>
                    </div>
                    <div class="mt-5 pt-4 border-t border-gray-100">
                        <p class="text-xs text-gray-400">
                            <i class="fa-solid fa-circle-info mr-1"></i>
                            File đã upload không thể thay đổi. Nếu cần thay file mới, hãy xoá và upload lại.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>
</html>
