@model BussinessLayer.DTOs.DocumentEditViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chỉnh sửa tài liệu";
    ViewBag.ActiveMenu = "Document";
    var iconClass = Model.FileType switch
    {
        "pdf" => "fa-file-pdf text-pink",
        "docx" => "fa-file-word text-blue",
        "pptx" => "fa-file-powerpoint",
        _ => "fa-file"
    };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Tài liệu</a> › Chỉnh sửa</div>
            <h1 class="page-title">Chỉnh sửa tài liệu</h1>
            <p class="page-subtitle">Cập nhật tiêu đề và chương cho tài liệu đã upload.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:22px; max-width:900px;">
        <div class="brutal-card">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="SubjectId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
                <div class="form-group">
                    <label asp-for="Title">Tiêu đề tài liệu *</label>
                    <input asp-for="Title" placeholder="Ví dụ: Slide Chapter 1 - Introduction" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-pink" style="font-size:12px;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ChapterId">Chương <span class="text-muted" style="font-weight:600;">(tuỳ chọn)</span></label>
                    <select asp-for="ChapterId" id="chapterSelect" asp-items="ViewBag.ChapterList">
                        <option value="">— Không thuộc chương cụ thể —</option>
                    </select>
                    <span asp-validation-for="ChapterId" class="text-pink" style="font-size:12px;"></span>
                </div>
                <div style="display:flex; gap:12px; margin-top:8px;">
                    <button type="submit" class="brutal-btn btn-pink" style="flex:1;"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="brutal-btn">Huỷ</a>
                </div>
            </form>
        </div>

        <div class="brutal-card">
            <h3 class="card-title" style="margin-bottom:14px;"><i class="fa-solid fa-file-alt"></i> Thông tin file</h3>
            <div style="display:flex; flex-direction:column; gap:12px;">
                <div>
                    <div class="stat-label">Tên file gốc</div>
                    <div style="font-weight:800; word-break:break-all;">@Model.FileName</div>
                </div>
                <div>
                    <div class="stat-label">Định dạng</div>
                    <div style="font-weight:800; text-transform:uppercase;"><i class="fa-solid @iconClass"></i> @Model.FileType</div>
                </div>
                <div>
                    <div class="stat-label">Dung lượng</div>
                    <div style="font-weight:800;">@Model.FileSizeDisplay</div>
                </div>
            </div>
            <div style="margin-top:14px; padding-top:12px; border-top:2px dashed #ccc;">
                <p class="page-subtitle"><i class="fa-solid fa-circle-info"></i> File đã upload không thể thay đổi. Nếu cần thay file mới, hãy xoá và upload lại.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
