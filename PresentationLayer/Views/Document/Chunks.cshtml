@model BussinessLayer.DTOs.DocumentChunksViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chunks & Embedding - " + Model.Document.Title;
    ViewBag.ActiveMenu = "Document";
    var doc = Model.Document;
    string FileBadge(string ft) => ft switch { "pdf" => "badge-red", "docx" => "badge-blue", "pptx" => "badge-yellow", _ => "badge-gray" };
    string FileIcon(string ft) => ft switch { "pdf" => "fa-file-pdf", "docx" => "fa-file-word", "pptx" => "fa-file-powerpoint", _ => "fa-file" };
}

<div class="page-content">
    <div class="page-header">
        <div style="display:flex; align-items:center; gap:14px;">
            <span class="badge @FileBadge(doc.FileType)" style="font-size:20px; padding:12px 14px;"><i class="fa-solid @FileIcon(doc.FileType)"></i></span>
            <div>
                <h1 class="page-title">@doc.Title</h1>
                <p class="page-subtitle">📎 @doc.FileName</p>
            </div>
        </div>
        <div style="display:flex; gap:8px;">
            <a asp-action="Download" asp-route-id="@doc.Id" class="brutal-btn btn-green"><i class="fa-solid fa-download"></i> Tải về</a>
            <a asp-action="Details" asp-route-id="@doc.Id" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:22px;">
        <div class="brutal-card">
            <h3 class="card-title" style="margin-bottom:14px;">Chunks & Embedding</h3>

            <h4 style="font-weight:900; font-size:13px; margin-bottom:10px;">Danh sách chunk (chỉnh sửa được — tối đa 100)</h4>
            <form id="chunksForm">
                <div style="display:flex; flex-direction:column; gap:12px;">
                    @if (Model.Chunks != null && Model.Chunks.Any())
                    {
                        @for (int i = 0; i < Model.Chunks.Count && i < 100; i++)
                        {
                            <div style="border:2px solid var(--black); padding:12px;">
                                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                                    <span class="badge badge-gray">Chunk @(i + 1)</span>
                                    <span class="text-muted" style="font-size:11px; font-weight:800;">Ký tự: @Model.Chunks[i].Length</span>
                                </div>
                                <textarea name="chunk-@i" data-index="@i" class="brutal-input" style="height:120px; font-family:monospace; font-size:13px;">@Model.Chunks[i]</textarea>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="font-weight:700;">Không có chunk nào được trích xuất.</p>
                    }
                </div>
                <div style="display:flex; align-items:center; gap:12px; margin-top:16px;">
                    <button type="button" id="saveChunksBtn" class="brutal-btn btn-green"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
                    <span id="saveStatus" class="text-muted" style="font-weight:800; font-size:13px;"></span>
                </div>
            </form>

            <h4 style="font-weight:900; font-size:13px; margin:24px 0 10px;">Embedding (preview)</h4>
            @if (Model.Embedding == null || !Model.Embedding.Any())
            {
                <p class="text-muted" style="font-weight:700;">Không có embedding cho chunk đầu tiên.</p>
            }
            else
            {
                <p class="text-muted" style="font-weight:800; margin-bottom:6px;">Kích thước vector: @Model.Embedding.Count</p>
                <div style="overflow-x:auto; border:2px solid var(--black); padding:12px; background:#faf9f7;">
                    <pre style="font-size:12px; margin:0;">@string.Join(", ", Model.Embedding.Take(200))</pre>
                </div>
            }
        </div>

        <div class="brutal-card" style="align-self:flex-start;">
            <h3 class="card-title" style="margin-bottom:14px;">Thông tin tài liệu</h3>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <div style="display:flex; justify-content:space-between; gap:12px; border-bottom:1px dashed #ccc; padding-bottom:8px;"><span class="text-muted" style="font-weight:800;">Tiêu đề</span><span style="font-weight:800; text-align:right;">@doc.Title</span></div>
                <div style="display:flex; justify-content:space-between; gap:12px; border-bottom:1px dashed #ccc; padding-bottom:8px;"><span class="text-muted" style="font-weight:800;">Môn học</span><span style="font-weight:800; text-align:right;"><strong>@doc.SubjectCode</strong> — @doc.SubjectName</span></div>
                <div style="display:flex; justify-content:space-between; gap:12px; border-bottom:1px dashed #ccc; padding-bottom:8px;"><span class="text-muted" style="font-weight:800;">Chương</span><span style="font-weight:800; text-align:right;">@(string.IsNullOrEmpty(doc.ChapterTitle) ? "—" : doc.ChapterTitle)</span></div>
                <div style="display:flex; justify-content:space-between; gap:12px;"><span class="text-muted" style="font-weight:800;">Định dạng</span><span style="font-weight:800; text-transform:uppercase;">@doc.FileType</span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('saveChunksBtn')?.addEventListener('click', async () => {
            const status = document.getElementById('saveStatus');
            status.textContent = 'Đang lưu...';
            const textareas = Array.from(document.querySelectorAll('textarea[data-index]'));
            const chunks = textareas.map(t => t.value);
            const payload = { chunks: chunks, embedding: null };
            try {
                const res = await fetch(`/Document/SaveChunks/@Model.Document.Id`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                status.textContent = json.success ? 'Lưu thành công.' : ('Lỗi: ' + (json.message || 'Không xác định'));
            } catch (err) {
                status.textContent = 'Lỗi khi gọi server: ' + err.message;
            }
            setTimeout(() => { status.textContent = ''; }, 4000);
        });
    </script>
}
