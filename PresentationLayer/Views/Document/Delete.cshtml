@model BussinessLayer.DTOs.DocumentDto
@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Xoá tài liệu";
    ViewBag.ActiveMenu = "Document";
    string FileBadge(string ft) => ft switch { "pdf" => "badge-red", "docx" => "badge-blue", "pptx" => "badge-yellow", _ => "badge-gray" };
    string FileIcon(string ft) => ft switch { "pdf" => "fa-file-pdf", "docx" => "fa-file-word", "pptx" => "fa-file-powerpoint", _ => "fa-file" };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Tài liệu</a> › Xóa</div>
            <h1 class="page-title" style="color:#d11;">Xác nhận xoá tài liệu</h1>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:560px; border-color:#d11;">
        <div class="alert alert-error" style="align-items:flex-start;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:20px;"></i>
            <div style="font-weight:700;">Hành động này <strong>không thể hoàn tác</strong>. File sẽ bị xoá khỏi server.</div>
        </div>

        <div style="border:2px solid var(--black); padding:16px; margin-bottom:16px; display:flex; align-items:center; gap:12px;">
            <span class="badge @FileBadge(Model.FileType)" style="font-size:14px; padding:8px 10px;"><i class="fa-solid @FileIcon(Model.FileType)"></i></span>
            <div>
                <p style="font-weight:900;">@Model.Title</p>
                <p class="page-subtitle">
                    Môn: <strong>@Model.SubjectCode</strong>
                    @if (!string.IsNullOrEmpty(Model.ChapterTitle))
                    {
                        <span>• @Model.ChapterTitle</span>
                    }
                    • @Model.FileSizeDisplay
                </p>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Bạn có chắc chắn muốn xoá tài liệu này? File sẽ bị xoá vĩnh viễn.">
            @Html.AntiForgeryToken()
            <div style="display:flex; gap:12px;">
                <a asp-action="Details" asp-route-id="@Model.Id" class="brutal-btn" style="flex:1;">Huỷ bỏ</a>
                <button type="submit" class="brutal-btn btn-red" style="flex:1;"><i class="fa-solid fa-trash"></i> Xác nhận xoá</button>
            </div>
        </form>
    </div>
</div>
