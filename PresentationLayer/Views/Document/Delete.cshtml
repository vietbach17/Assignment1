@model BussinessLayer.DTOs.DocumentDto
@using BussinessLayer.DTOs
@{
    ViewData["Title"] = "Xoá tài liệu";
}

<div class="delete-container">
    <div class="glass-card delete-card">

        @* Icon cảnh báo *@
        <div class="warning-icon">⚠️</div>
        <h1 class="delete-title">Xác nhận Xoá Tài liệu</h1>
        <p class="delete-subtitle">Hành động này <strong>không thể hoàn tác</strong>. File sẽ bị xoá khỏi server.</p>

        @* Thông tin tài liệu sẽ bị xoá *@
        <div class="doc-summary">
            <div class="doc-summary-row">
                @switch (Model.FileType)
                {
                    case "pdf":  <span class="file-badge pdf">PDF</span>  break;
                    case "docx": <span class="file-badge docx">DOCX</span> break;
                    case "pptx": <span class="file-badge pptx">PPTX</span> break;
                    default:     <span class="file-badge">FILE</span>      break;
                }
                <div class="doc-summary-info">
                    <div class="doc-summary-title">@Model.Title</div>
                    <div class="doc-summary-meta">
                        📁 @Model.SubjectCode •
                        @(string.IsNullOrEmpty(Model.ChapterTitle) ? "" : $"📖 {Model.ChapterTitle} • ")
                        @Model.FileSizeDisplay •
                        @Model.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        </div>

        @* Form xác nhận xoá *@
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-danger-confirm" id="deleteBtn">
                🗑️ Xác nhận Xoá
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel-delete">Huỷ bỏ</a>
        </form>
    </div>
</div>

<style>
    .delete-container {
        display: flex; justify-content: center; align-items: flex-start;
        padding: 2rem 0;
    }
    .delete-card {
        max-width: 540px; width: 100%; padding: 3rem 2.5rem;
        text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
        border-color: rgba(239,68,68,0.2);
    }
    .warning-icon { font-size: 3.5rem; line-height: 1; }
    .delete-title { font-size: 1.6rem; font-weight: 700; color: #f87171; }
    .delete-subtitle { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }
    .delete-subtitle strong { color: #fbbf24; }

    /* Doc summary */
    .doc-summary {
        width: 100%; background: rgba(239,68,68,0.05);
        border: 1px solid rgba(239,68,68,0.2); border-radius: 12px; padding: 1.25rem 1.5rem;
        text-align: left;
    }
    .doc-summary-row { display: flex; align-items: center; gap: 1rem; }
    .doc-summary-info { flex: 1; }
    .doc-summary-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem; }
    .doc-summary-meta { font-size: 0.78rem; color: var(--text-secondary); }

    /* File badges */
    .file-badge { display: inline-block; padding: 0.35rem 0.7rem; border-radius: 6px; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
    .file-badge.pdf  { background: rgba(239,68,68,0.15);  color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
    .file-badge.docx { background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
    .file-badge.pptx { background: rgba(249,115,22,0.15); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }

    /* Form */
    .delete-form { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
    .btn-danger-confirm {
        width: 100%; padding: 0.85rem; border-radius: 10px; font-size: 0.95rem; font-weight: 600;
        background: rgba(239,68,68,0.15); color: #f87171;
        border: 1px solid rgba(239,68,68,0.4); cursor: pointer;
        transition: var(--transition-smooth);
    }
    .btn-danger-confirm:hover { background: #dc2626; color: #fff; border-color: #dc2626; }
    .btn-cancel-delete {
        display: block; width: 100%; padding: 0.75rem; border-radius: 10px;
        font-size: 0.9rem; color: var(--text-secondary); text-decoration: none;
        border: 1px solid var(--border-color); text-align: center;
        transition: var(--transition-smooth);
    }
    .btn-cancel-delete:hover { border-color: rgba(255,255,255,0.2); color: #fff; }
</style>

@section Scripts {
    <script>
        // Confirm thêm lần nữa khi click Delete (double protection)
        document.getElementById('deleteBtn').addEventListener('click', function(e) {
            if (!confirm('Bạn có chắc chắn muốn xoá tài liệu này? File sẽ bị xoá vĩnh viễn.')) {
                e.preventDefault();
            }
        });
    </script>
}
