@model BussinessLayer.DTOs.DocumentDto
@using BussinessLayer.DTOs
@{
    ViewData["Title"] = "Xoá tài liệu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Xoá tài liệu</p>
            </div>
        </div>

        <div class="px-4 py-2">
            <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
            <ul class="space-y-1">
                <li>
                    <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-border-all w-5"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-book w-5"></i>
                        <span>Môn Học</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium">
                        <i class="fa-regular fa-file-lines w-5"></i>
                        <span>Tài liệu</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Tìm kiếm..." class="w-full bg-gray-50 border-none rounded-full pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-button">
            </div>
            
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8 flex items-center justify-center">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-md w-full text-center">
                <div class="mb-4">
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-5xl block mb-4"></i>
                </div>

                <h2 class="text-2xl font-bold text-gray-800 mb-2">Xác nhận Xoá Tài liệu</h2>
                <p class="text-gray-600 text-sm mb-6">
                    Hành động này <strong>không thể hoàn tác</strong>. File sẽ bị xoá khỏi server.
                </p>

                <!-- Document Summary -->
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-left">
                    <div class="flex items-center space-x-3 mb-2">
                        @switch (Model.FileType)
                        {
                            case "pdf":
                                <div class="w-10 h-10 bg-red-100 text-red-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </div>
                                break;
                            case "docx":
                                <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fa-solid fa-file-word"></i>
                                </div>
                                break;
                            case "pptx":
                                <div class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <i class="fa-solid fa-file-powerpoint"></i>
                                </div>
                                break;
                        }
                        <div class="flex-1">
                            <p class="font-semibold text-gray-800">@Model.Title</p>
                            <p class="text-xs text-gray-600 mt-1">
                                Môn: <strong>@Model.SubjectCode</strong>
                                @if (!string.IsNullOrEmpty(Model.ChapterTitle))
                                {
                                    <span>• @Model.ChapterTitle</span>
                                }
                                • @Model.FileSizeDisplay
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-2.5 px-4 rounded-xl transition shadow-sm" id="deleteBtn">
                        <i class="fa-solid fa-trash mr-2"></i>Xác nhận Xoá
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="block w-full px-4 py-2.5 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-medium rounded-xl transition">
                        Huỷ bỏ
                    </a>
                </form>
            </div>
        </div>
    </main>

</body>
</html>

@section Scripts {
    <script>
        document.getElementById('deleteBtn').addEventListener('click', function(e) {
            if (!confirm('Bạn có chắc chắn muốn xoá tài liệu này? File sẽ bị xoá vĩnh viễn.')) {
                e.preventDefault();
            }
        });
    </script>
}
