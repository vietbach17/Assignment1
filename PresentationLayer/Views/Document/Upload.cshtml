@model BussinessLayer.DTOs.DocumentUploadViewModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
}

<div class="upload-container">

    <div class="page-header glass-card">
        <div>
            <h1>Tải lên Tài liệu</h1>
            <p>Hỗ trợ định dạng: PDF, DOCX, PPTX — Tối đa 50 MB</p>
        </div>
        <a asp-action="Index" class="btn-secondary-link">← Quay lại danh sách</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">❌ @TempData["ErrorMessage"]</div>
    }

    <div class="glass-card upload-form-card">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>

            @* Title *@
            <div class="form-group">
                <label asp-for="Title" class="form-label">Tiêu đề tài liệu <span class="required">*</span></label>
                <input asp-for="Title" class="form-input" id="titleInput" placeholder="Ví dụ: Slide Chapter 1 - Introduction" autocomplete="off" />
                <span asp-validation-for="Title" class="validation-error"></span>
            </div>

            @* Subject *@
            <div class="form-group">
                <label asp-for="SubjectId" class="form-label">Môn học <span class="required">*</span></label>
                <select asp-for="SubjectId" id="subjectSelect" class="form-select" asp-items="ViewBag.SubjectList">
                    <option value="">— Chọn môn học —</option>
                </select>
                <span asp-validation-for="SubjectId" class="validation-error"></span>
            </div>

            @* Chapter (dynamic via AJAX) *@
            <div class="form-group">
                <label asp-for="ChapterId" class="form-label">Chương (tuỳ chọn)</label>
                <select asp-for="ChapterId" id="chapterSelect" class="form-select">
                    <option value="">— Chọn chương (tuỳ chọn) —</option>
                </select>
                <span class="form-hint">Chọn môn học trước để load danh sách chương.</span>
            </div>

            @* File Upload Drop Zone *@
            <div class="form-group">
                <label class="form-label">📎 File tài liệu <span class="required">*</span></label>
                <div class="drop-zone" id="dropZone">
                    <div class="drop-zone-icon"></div>
                    <div class="drop-zone-text">
                        <p>Kéo thả file vào đây hoặc <span class="browse-link" onclick="document.getElementById('fileInput').click()">chọn file</span></p>
                        <p class="drop-zone-hint">PDF, DOCX, PPTX — tối đa 50 MB</p>
                    </div>
                    <input asp-for="File" type="file" id="fileInput" accept=".pdf,.docx,.pptx" style="display:none" />
                </div>
                <div id="filePreview" class="file-preview" style="display:none">
                    <span id="fileIcon" class="file-badge">FILE</span>
                    <div>
                        <div id="fileName" class="file-name"></div>
                        <div id="fileSize" class="file-size"></div>
                    </div>
                    <button type="button" class="remove-file" onclick="clearFile()">✕</button>
                </div>
                <span asp-validation-for="File" class="validation-error"></span>
                <div id="fileSizeError" class="validation-error" style="display:none">File vượt quá giới hạn 50 MB.</div>
            </div>

            @* Submit *@
            <div class="form-actions">
                <button type="submit" class="btn-primary btn-submit" id="submitBtn">
                    Tải lên tài liệu
                </button>
                <a asp-action="Index" class="btn-cancel">Huỷ</a>
            </div>
        </form>
    </div>
</div>

<style>
    .upload-container { display: flex; flex-direction: column; gap: 1.5rem; max-width: 760px; margin: 0 auto; }
    .page-header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.3rem; }
    .page-header p  { color: var(--text-secondary); font-size: 0.9rem; }
    .btn-secondary-link { color: var(--text-secondary); font-size: 0.88rem; text-decoration: none; padding: 0.5rem 1rem; border: 1px solid var(--border-color); border-radius: 8px; transition: var(--transition-smooth); white-space: nowrap; }
    .btn-secondary-link:hover { border-color: rgba(255,255,255,0.2); color: #fff; }

    .alert { padding: 0.9rem 1.25rem; border-radius: 10px; font-size: 0.9rem; }
    .alert-danger { background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.3); color: #f87171; }
    .validation-summary-valid { display: none !important; }
    .validation-summary-errors { margin-bottom: 1.5rem; }

    .upload-form-card { padding: 2rem 2.5rem; display: flex; flex-direction: column; gap: 0; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem; }
    .form-label { font-size: 0.9rem; font-weight: 500; color: #e2e8f0; }
    .required { color: #f87171; }
    .form-input, .form-select {
        background: rgba(255,255,255,0.05); border: 1px solid var(--border-color);
        color: #fff; border-radius: 10px; padding: 0.65rem 1rem; font-size: 0.9rem;
        outline: none; transition: border-color 0.2s;
    }
    .form-select option { background-color: #1c1c21; color: #fff; }
    .form-input:focus, .form-select:focus { border-color: var(--accent-orange); box-shadow: 0 0 0 3px rgba(249,115,22,0.1); }
    .form-input::placeholder { color: rgba(255,255,255,0.3); }
    .form-hint { font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.2rem; }
    .validation-error { color: #f87171; font-size: 0.8rem; min-height: 1rem; }

    /* Drop zone */
    .drop-zone {
        border: 2px dashed var(--border-color); border-radius: 14px; padding: 2.5rem;
        text-align: center; cursor: pointer; transition: var(--transition-smooth);
        background: rgba(255,255,255,0.02);
    }
    .drop-zone.drag-over { border-color: var(--accent-orange); background: rgba(249,115,22,0.06); }
    .drop-zone-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
    .drop-zone-text p { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.25rem; }
    .browse-link { color: var(--accent-orange); cursor: pointer; text-decoration: underline; }
    .drop-zone-hint { font-size: 0.78rem !important; color: rgba(255,255,255,0.3) !important; }

    /* File preview */
    .file-preview {
        display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1.2rem;
        background: rgba(255,255,255,0.04); border: 1px solid var(--border-color);
        border-radius: 10px; margin-top: 0.75rem;
    }
    .file-badge { display: inline-block; padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 700; }
    .file-badge.pdf  { background: rgba(239,68,68,0.15);  color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
    .file-badge.docx { background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
    .file-badge.pptx { background: rgba(249,115,22,0.15); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
    .file-name { font-weight: 500; font-size: 0.9rem; }
    .file-size { font-size: 0.78rem; color: var(--text-secondary); }
    .remove-file { margin-left: auto; background: none; border: none; color: var(--text-secondary); cursor: pointer; font-size: 1.1rem; padding: 0.2rem 0.4rem; border-radius: 4px; }
    .remove-file:hover { color: #f87171; }

    /* Actions */
    .form-actions { display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem; }
    .btn-submit { padding: 0.75rem 2rem; font-size: 0.95rem; }
    .btn-cancel { color: var(--text-secondary); font-size: 0.88rem; text-decoration: none; padding: 0.5rem 1rem; }
    .btn-cancel:hover { color: #fff; }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@section Scripts {
    <script>
        const MAX_SIZE_MB = 50;
        const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;

        // ─── File input handler ───
        const fileInput = document.getElementById('fileInput');
        const dropZone  = document.getElementById('dropZone');
        const filePreview = document.getElementById('filePreview');
        const fileSizeError = document.getElementById('fileSizeError');
        const submitBtn = document.getElementById('submitBtn');

        fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

        // ─── Drag & Drop ───
        dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file) {
                // Inject file vào input
                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
                handleFile(file);
            }
        });
        dropZone.addEventListener('click', () => fileInput.click());

        function handleFile(file) {
            if (!file) return;
            const ext = file.name.split('.').pop().toLowerCase();
            fileSizeError.style.display = 'none';

            // Validate kích thước
            if (file.size > MAX_SIZE_BYTES) {
                fileSizeError.style.display = 'block';
                submitBtn.disabled = true;
                return;
            }
            submitBtn.disabled = false;

            // Hiển thị preview
            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = formatSize(file.size);
            const badge = document.getElementById('fileIcon');
            badge.textContent = ext.toUpperCase();
            badge.className = 'file-badge ' + ext;
            filePreview.style.display = 'flex';
            dropZone.style.display = 'none';
        }

        function clearFile() {
            fileInput.value = '';
            filePreview.style.display = 'none';
            dropZone.style.display = 'block';
            fileSizeError.style.display = 'none';
            submitBtn.disabled = false;
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        // ─── Dynamic Chapter dropdown via AJAX ───
        const subjectSelect  = document.getElementById('subjectSelect');
        const chapterSelect  = document.getElementById('chapterSelect');

        subjectSelect.addEventListener('change', async function () {
            const subjectId = this.value;
            chapterSelect.innerHTML = '<option value="">— Chọn chương (tuỳ chọn) —</option>';
            if (!subjectId) return;

            try {
                const res = await fetch(`/Document/GetChaptersBySubject?subjectId=${subjectId}`);
                const data = await res.json();
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.title;
                    chapterSelect.appendChild(opt);
                });
            } catch (e) {
                console.warn('Không thể load chapters:', e);
            }
        });
    </script>
}
