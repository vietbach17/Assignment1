@model BussinessLayer.DTOs.DocumentUploadViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tải lên tài liệu";
    ViewBag.ActiveMenu = "Document";
}

@section Styles {
    <style>
        .hidden { display: none !important; }
        .drop-zone { border: 3px dashed var(--black); padding: 32px; text-align: center; cursor: pointer; transition: 0.1s; background: #faf9f7; }
        .drop-zone.dz-active, .drop-zone:hover { background: #fff0f4; box-shadow: var(--shadow); }
        #terminalLog { background: #0d1117; color: #4ade80; font-family: monospace; font-size: 12px; padding: 14px; height: 200px; overflow-y: auto; border: 3px solid var(--black); }
        #terminalLog .t-green { color: #4ade80; }
        #terminalLog .t-red { color: #f87171; }
        #terminalLog .t-teal { color: #5eead4; font-weight: 700; }
        #terminalLog .t-gray { color: #8b949e; }
        #terminalLog .t-time { color: #6b7280; }
        .progress-track { width: 100%; background: #e5e5e5; border: 2px solid var(--black); height: 18px; overflow: hidden; }
        .progress-fill { background: var(--pink); height: 100%; width: 0%; transition: width 0.3s; }
        .chunk-card { border: 2px solid var(--black); background: #faf9f7; padding: 14px; }
    </style>
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-action="Index" class="text-pink">Tài liệu</a> › Tải lên</div>
            <h1 class="page-title">Tải lên tài liệu mới</h1>
            <p class="page-subtitle">Hỗ trợ PDF, DOCX, PPTX — tối đa 50 MB.</p>
        </div>
        <a asp-action="Index" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="brutal-card" style="max-width:720px; margin: 0 auto;">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

            <!-- Modal Popup for Upload Errors (like duplicate file) -->
            <div class="modal @(ViewBag.UploadError != null ? "open" : "")" id="duplicateErrorModal">
                <div class="modal-content">
                    <button type="button" class="modal-close" onclick="document.getElementById('duplicateErrorModal').classList.remove('open')">&times;</button>
                    <h2 class="card-title text-pink mb-3" style="margin-bottom: 15px;"><i class="fa-solid fa-triangle-exclamation"></i> Cảnh báo Tải lên</h2>
                    <p id="modalErrorMessage" style="font-weight: 700; line-height: 1.5;">@(ViewBag.UploadError ?? "")</p>
                    <div style="display: flex; justify-content: flex-end; margin-top: 25px;">
                        <button type="button" class="brutal-btn btn-dark" onclick="document.getElementById('duplicateErrorModal').classList.remove('open')">Đã hiểu</button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Title">Tiêu đề tài liệu *</label>
                <input asp-for="Title" placeholder="Ví dụ: Slide Chapter 1 - Introduction" autocomplete="off" />
                <span asp-validation-for="Title" class="text-pink" style="font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="SubjectId">Môn học *</label>
                <select asp-for="SubjectId" id="subjectSelect" asp-items="ViewBag.SubjectList">
                    <option value="">— Chọn môn học —</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-pink" style="font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="ChapterId">Chương <span class="text-muted" style="font-weight:600;">(tuỳ chọn)</span></label>
                <select asp-for="ChapterId" id="chapterSelect">
                    <option value="">— Chọn chương (tuỳ chọn) —</option>
                </select>
                <span class="text-muted" style="font-size:11px;">Chọn môn học trước để load danh sách chương.</span>
            </div>

            <div class="form-group">
                <label>📎 File tài liệu *</label>
                <div class="drop-zone" id="dropZone">
                    <i class="fa-solid fa-cloud-arrow-up" style="font-size:36px; color:#999;"></i>
                    <p style="font-weight:800; margin-top:10px;">Kéo thả file vào đây hoặc <span class="text-pink" style="text-decoration:underline; cursor:pointer;" onclick="document.getElementById('fileInput').click()">chọn file</span></p>
                    <p class="text-muted" style="font-weight:700; font-size:13px;">PDF, DOCX, PPTX — tối đa 50 MB</p>
                    <input asp-for="File" type="file" id="fileInput" accept=".pdf,.docx,.pptx" style="display:none" />
                </div>

                <div id="filePreview" class="hidden" style="margin-top:14px; padding:14px; border:2px solid var(--black); display:flex; align-items:center; gap:14px;">
                    <span class="badge badge-gray" style="font-size:18px; padding:10px 12px;"><i id="fileIcon" class="fa-solid fa-file"></i></span>
                    <div style="flex:1;">
                        <div id="fileName" style="font-weight:900;"></div>
                        <div id="fileSize" class="page-subtitle"></div>
                    </div>
                    <button type="button" style="background:none; border:none; cursor:pointer; font-size:20px;" onclick="clearFile()"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <div id="previewControls" class="hidden" style="margin-top:14px; display:flex; align-items:center; gap:12px;">
                    <button id="previewButton" type="button" class="brutal-btn btn-blue"><i class="fa-solid fa-magnifying-glass"></i> Xem trước</button>
                    <span id="previewLoading" class="hidden text-muted" style="font-weight:800; font-size:13px;"><i class="fa-solid fa-spinner fa-spin"></i> Đang tạo preview...</span>
                </div>

                <div id="previewSection" class="hidden" style="margin-top:14px; padding:14px; border:2px solid var(--black);">
                    <h3 class="card-title" style="font-size:15px;">Preview Gemini Chunk / Embedding</h3>
                    <p class="page-subtitle">Xem trước cách tài liệu sẽ được phân đoạn và embedding.</p>
                    <div id="previewMessage" style="font-weight:700; margin:8px 0;"></div>
                    <div id="previewInfo" style="display:grid; gap:6px; font-weight:700; font-size:13px;"></div>
                    <div id="previewChunks" style="display:flex; flex-direction:column; gap:12px; margin-top:12px;"></div>
                </div>

                <span asp-validation-for="File" class="text-pink" style="font-size:12px;"></span>
                <div id="fileSizeError" class="hidden text-pink" style="font-size:12px; font-weight:800;">File vượt quá giới hạn 50 MB.</div>
            </div>

            <div id="uploadProgressSection" class="hidden" style="margin-bottom:18px; display:flex; flex-direction:column; gap:14px;">
                <div>
                    <div style="display:flex; justify-content:space-between; font-weight:800; font-size:13px; margin-bottom:6px;">
                        <span id="progressStatusText">Đang chuẩn bị tải lên...</span>
                        <span id="progressPercentText">0%</span>
                    </div>
                    <div class="progress-track"><div id="progressBarFill" class="progress-fill"></div></div>
                </div>
            </div>

            <div style="display:flex; gap:12px;">
                <button type="submit" class="brutal-btn btn-pink" style="flex:1;" id="submitBtn"><i class="fa-solid fa-upload"></i> Tải lên tài liệu</button>
                <a asp-action="Index" class="brutal-btn">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const MAX_SIZE_BYTES = 50 * 1024 * 1024;
        const fileInput = document.getElementById('fileInput');
        const dropZone = document.getElementById('dropZone');
        const filePreview = document.getElementById('filePreview');
        const fileSizeError = document.getElementById('fileSizeError');
        const previewControls = document.getElementById('previewControls');
        const previewButton = document.getElementById('previewButton');
        const previewLoading = document.getElementById('previewLoading');
        const previewSection = document.getElementById('previewSection');
        const previewInfo = document.getElementById('previewInfo');
        const previewChunks = document.getElementById('previewChunks');
        const previewMessage = document.getElementById('previewMessage');
        const submitBtn = document.getElementById('submitBtn');

        fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));
        dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dz-active'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dz-active'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('dz-active');
            const file = e.dataTransfer.files[0];
            if (file) { const dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; handleFile(file); }
        });
        dropZone.addEventListener('click', () => fileInput.click());

        function handleFile(file) {
            if (!file) return;
            const ext = file.name.split('.').pop().toLowerCase();
            fileSizeError.classList.add('hidden');
            if (file.size > MAX_SIZE_BYTES) {
                fileSizeError.classList.remove('hidden');
                previewControls.classList.add('hidden');
                previewSection.classList.add('hidden');
                submitBtn.disabled = true;
                return;
            }
            submitBtn.disabled = false;
            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = formatSize(file.size);

            const titleInput = document.getElementById('Title');
            if (titleInput && !titleInput.value.trim()) {
                const fileNameWithoutExt = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
                titleInput.value = fileNameWithoutExt;
            }
            const badge = document.getElementById('fileIcon');
            switch (ext) {
                case 'pdf': badge.className = 'fa-solid fa-file-pdf'; break;
                case 'docx': badge.className = 'fa-solid fa-file-word'; break;
                case 'pptx': badge.className = 'fa-solid fa-file-powerpoint'; break;
                default: badge.className = 'fa-solid fa-file';
            }
            filePreview.classList.remove('hidden');
            dropZone.classList.add('hidden');
            previewControls.classList.remove('hidden');
            previewSection.classList.add('hidden');
            previewInfo.innerHTML = '';
            previewChunks.innerHTML = '';
            previewMessage.textContent = '';
        }

        previewButton.addEventListener('click', previewFile);
        async function previewFile() {
            const file = fileInput.files[0];
            if (!file) { previewMessage.textContent = 'Vui lòng chọn file trước khi xem trước.'; return; }
            previewButton.disabled = true;
            previewLoading.classList.remove('hidden');
            previewMessage.textContent = '';
            previewInfo.innerHTML = '';
            previewChunks.innerHTML = '';
            previewSection.classList.add('hidden');
            const formData = new FormData();
            formData.append('file', file);
            try {
                const response = await fetch('/Document/PreviewDocumentChunks', { method: 'POST', body: formData });
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                const result = await response.json();
                if (!result.success) { previewMessage.textContent = result.message || 'Không thể tạo preview cho file.'; return; }
                previewSection.classList.remove('hidden');
                previewInfo.innerHTML = `
                    <div>Số chunk nhận được: <b>${result.chunkCount}</b></div>
                    <div>Embedding khả dụng: <b>${result.embeddingAvailable ? 'Có' : 'Không'}</b></div>
                    <div>Kích thước vector embedding: <b>${result.embeddingCount}</b></div>`;
                (result.chunks || []).forEach(chunk => {
                    const card = document.createElement('div');
                    card.className = 'chunk-card';
                    const header = document.createElement('div');
                    header.style.cssText = 'font-weight:900; font-size:12px; margin-bottom:6px;';
                    header.textContent = `Chunk ${chunk.index}`;
                    const body = document.createElement('pre');
                    body.style.cssText = 'white-space:pre-wrap; font-size:13px; overflow-x:auto; margin:0;';
                    body.textContent = chunk.text;
                    card.appendChild(header); card.appendChild(body);
                    previewChunks.appendChild(card);
                });
            } catch (error) {
                previewMessage.textContent = `Lỗi khi tạo preview: ${error.message}`;
            } finally {
                previewLoading.classList.add('hidden');
                previewButton.disabled = false;
            }
        }

        function clearFile() {
            fileInput.value = '';
            filePreview.classList.add('hidden');
            dropZone.classList.remove('hidden');
            fileSizeError.classList.add('hidden');
            previewControls.classList.add('hidden');
            previewSection.classList.add('hidden');
            previewInfo.innerHTML = '';
            previewChunks.innerHTML = '';
            previewMessage.textContent = '';
            submitBtn.disabled = false;
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        const subjectSelect = document.getElementById('subjectSelect');
        const chapterSelect = document.getElementById('chapterSelect');
        subjectSelect.addEventListener('change', async function () {
            const subjectId = this.value;
            chapterSelect.innerHTML = '<option value="">— Chọn chương (tuỳ chọn) —</option>';
            if (!subjectId) return;
            try {
                const res = await fetch(`/Document/GetChaptersBySubject?subjectId=${subjectId}`);
                const data = await res.json();
                data.forEach(c => { const opt = document.createElement('option'); opt.value = c.id; opt.textContent = c.title; chapterSelect.appendChild(opt); });
            } catch (e) { console.warn('Không thể load chapters:', e); }
        });

        function generateUUID() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        function showErrorModal(message) {
            document.getElementById('modalErrorMessage').textContent = message;
            document.getElementById('duplicateErrorModal').classList.add('open');
        }

        function logToTerminal(message, type = 'info') {
            console.log(`[${type.toUpperCase()}] ${message}`);
        }

        const uploadForm = document.getElementById('uploadForm');
        uploadForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const titleInput = document.getElementById('Title');
            const subjectInput = document.getElementById('subjectSelect');
            const chapterInput = document.getElementById('chapterSelect');
            document.querySelectorAll('[data-valmsg-for]').forEach(span => span.textContent = '');

            let hasError = false;
            if (!titleInput.value.trim()) { const s = document.querySelector('[data-valmsg-for="Title"]'); if (s) s.textContent = 'Vui lòng nhập tiêu đề tài liệu'; hasError = true; }
            if (!subjectInput.value) { const s = document.querySelector('[data-valmsg-for="SubjectId"]'); if (s) s.textContent = 'Vui lòng chọn môn học'; hasError = true; }
            if (!fileInput.files || fileInput.files.length === 0) { const s = document.querySelector('[data-valmsg-for="File"]'); if (s) s.textContent = 'Vui lòng chọn file để tải lên'; hasError = true; }
            if (hasError) return;

            const file = fileInput.files[0];
            const progressSection = document.getElementById('uploadProgressSection');
            const progressStatusText = document.getElementById('progressStatusText');
            const progressPercentText = document.getElementById('progressPercentText');
            const progressBarFill = document.getElementById('progressBarFill');
            progressSection.classList.remove('hidden');

            logToTerminal('Khởi tạo kết nối upload phân đoạn...', 'system');
            logToTerminal(`Thông tin file: ${file.name} (${formatSize(file.size)})`, 'info');

            const CHUNK_SIZE = 2 * 1024 * 1024;
            const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
            const fileGuid = generateUUID();
            logToTerminal(`Cấu hình Chunk Size: 2MB. Tổng số mảnh sẽ cắt: ${totalChunks}`, 'info');

            submitBtn.disabled = true;
            const cancelBtn = submitBtn.nextElementSibling;
            if (cancelBtn) { cancelBtn.style.pointerEvents = 'none'; cancelBtn.style.opacity = '0.5'; }

            for (let i = 0; i < totalChunks; i++) {
                const start = i * CHUNK_SIZE;
                const end = Math.min(start + CHUNK_SIZE, file.size);
                const chunk = file.slice(start, end);
                logToTerminal(`[Cắt file] Tiến hành cắt phân đoạn ${i + 1}/${totalChunks} (Bytes: ${start} - ${end})...`, 'info');

                const formData = new FormData();
                formData.append('file', chunk);
                formData.append('chunkIndex', i);
                formData.append('totalChunks', totalChunks);
                formData.append('fileName', file.name);
                formData.append('fileGuid', fileGuid);
                formData.append('title', titleInput.value.trim());
                formData.append('subjectId', subjectInput.value);
                if (chapterInput.value) formData.append('chapterId', chapterInput.value);

                progressStatusText.textContent = `Đang tải lên phân đoạn ${i + 1}/${totalChunks}...`;
                try {
                    const response = await fetch('/Document/UploadChunk', { method: 'POST', body: formData });
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    const result = await response.json();
                    if (result.success) {
                        const percent = Math.round(((i + 1) / totalChunks) * 100);
                        progressBarFill.style.width = `${percent}%`;
                        progressPercentText.textContent = `${percent}%`;
                        logToTerminal(`[Tải lên] Truyền tải thành công mảnh ${i + 1}/${totalChunks}.`, 'success');
                        if (i === totalChunks - 1) {
                            logToTerminal('[Máy chủ] Đang ghép các phân đoạn thành file hoàn chỉnh...', 'system');
                            logToTerminal('[Máy chủ] Đang tạo mã SHA-256 và kiểm tra trùng lặp...', 'system');
                            if (result.document) {
                                logToTerminal(`[Kiểm tra] Thành công! Không trùng lặp tài liệu nào khác.`, 'success');
                                logToTerminal(`[SHA-256 Hash] ${result.document.fileHash}`, 'success');
                                logToTerminal(`[Cơ sở dữ liệu] Ghi nhận metadata thành công. Document ID: ${result.document.id}`, 'success');
                                progressStatusText.textContent = 'Đang xử lý AI ngầm...';
                                logToTerminal('Tải lên thành công! Hệ thống đang xử lý phân đoạn ngữ cảnh AI ngầm. Bạn có thể chuyển hướng...', 'system');
                                
                                // Show success modal instead of auto redirect
                                const successMsg = 'Tải lên thành công! Sẽ chuyển hướng đến tài liệu trong giây lát...';
                                if (typeof brutalAlert !== 'undefined') {
                                    brutalAlert(successMsg);
                                    const closeBtn = document.querySelector('#brutalAlertModal .btn-dark');
                                    if(closeBtn) {
                                        closeBtn.innerText = "ĐI TỚI TÀI LIỆU";
                                        closeBtn.classList.remove('btn-dark');
                                        closeBtn.classList.add('btn-pink');
                                        closeBtn.onclick = function() {
                                            window.location.href = `/Document/Details/${result.document.id}`;
                                        };
                                    }
                                } else {
                                    alert(successMsg);
                                }
                                setTimeout(() => { window.location.href = `/Document/Details/${result.document.id}`; }, 2000);
                            } else {
                                logToTerminal(`[Lỗi] Phản hồi thành công nhưng thiếu thông tin tài liệu.`, 'error');
                                submitBtn.disabled = false;
                                if (cancelBtn) { cancelBtn.style.pointerEvents = ''; cancelBtn.style.opacity = ''; }
                            }
                        }
                    } else {
                        console.error(`[Thất bại] Lỗi từ máy chủ: ${result.message}`);
                        if (typeof brutalAlert !== 'undefined') {
                            brutalAlert('Tải lên thất bại: ' + result.message);
                            // reset button state
                            const closeBtn = document.querySelector('#brutalAlertModal .btn-pink');
                            if(closeBtn) {
                                closeBtn.innerText = "ĐÓNG";
                                closeBtn.classList.remove('btn-pink');
                                closeBtn.classList.add('btn-dark');
                                closeBtn.onclick = function() {
                                    document.getElementById('brutalAlertModal').style.display='none';
                                };
                            }
                        } else {
                            showErrorModal(result.message);
                        }
                        progressStatusText.textContent = 'Tải lên thất bại.';
                        submitBtn.disabled = false;
                        if (cancelBtn) { cancelBtn.style.pointerEvents = ''; cancelBtn.style.opacity = ''; }
                        return;
                    }
                } catch (error) {
                    console.error(`[Lỗi mạng] Lỗi truyền tải phân đoạn ${i + 1}. Lỗi: ${error.message}`);
                    if (typeof brutalAlert !== 'undefined') {
                        brutalAlert(`Lỗi truyền tải phân đoạn. Chi tiết: ${error.message}`);
                    } else {
                        showErrorModal(`Lỗi truyền tải phân đoạn. Chi tiết: ${error.message}`);
                    }
                    progressStatusText.textContent = 'Lỗi kết nối mạng.';
                    submitBtn.disabled = false;
                    if (cancelBtn) { cancelBtn.style.pointerEvents = ''; cancelBtn.style.opacity = ''; }
                    return;
                }
            }
        });
    </script>
}
