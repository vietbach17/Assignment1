@model BussinessLayer.DTOs.DocumentUploadViewModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Tải tài liệu</p>
            </div>
        </div>

        <div class="px-4 py-2">
            <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
            <ul class="space-y-1">
                <li>
                    <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-border-all w-5"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                        <i class="fa-solid fa-book w-5"></i>
                        <span>Môn Học</span>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium">
                        <i class="fa-regular fa-file-lines w-5"></i>
                        <span>Tài liệu</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Tìm kiếm..." class="w-full bg-gray-50 border-none rounded-full pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-button">
            </div>
            
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8 flex justify-between items-start">
                <div>
                    <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">Không gian giảng viên</p>
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">Tải lên Tài liệu</h2>
                    <p class="text-gray-500 text-sm">Hỗ trợ PDF, DOCX, PPTX — Tối đa 50 MB</p>
                </div>
                <a asp-action="Index" class="inline-flex items-center space-x-2 text-gray-600 hover:text-gray-800 bg-white hover:bg-gray-100 border border-gray-200 font-medium py-2.5 px-6 rounded-xl transition">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Quay lại</span>
                </a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    <i class="fa-solid fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-2xl">
                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"></div>

                    <!-- Title -->
                    <div class="mb-6">
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-2">
                            Tiêu đề tài liệu <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Title" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-button focus:border-transparent" placeholder="Ví dụ: Slide Chapter 1 - Introduction" autocomplete="off" />
                        <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Subject -->
                    <div class="mb-6">
                        <label asp-for="SubjectId" class="block text-sm font-medium text-gray-700 mb-2">
                            Môn học <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="SubjectId" id="subjectSelect" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-button focus:border-transparent" asp-items="ViewBag.SubjectList">
                            <option value="">— Chọn môn học —</option>
                        </select>
                        <span asp-validation-for="SubjectId" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Chapter -->
                    <div class="mb-6">
                        <label asp-for="ChapterId" class="block text-sm font-medium text-gray-700 mb-2">
                            Chương <span class="text-gray-500 text-xs font-normal">(tuỳ chọn)</span>
                        </label>
                        <select asp-for="ChapterId" id="chapterSelect" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-button focus:border-transparent">
                            <option value="">— Chọn chương (tuỳ chọn) —</option>
                        </select>
                        <p class="text-gray-500 text-xs mt-1">Chọn môn học trước để load danh sách chương.</p>
                    </div>

                    <!-- File Upload Drop Zone -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            📎 File tài liệu <span class="text-red-500">*</span>
                        </label>
                        <div class="drop-zone border-2 border-dashed border-gray-300 rounded-xl p-8 text-center cursor-pointer hover:border-brand-button hover:bg-brand-gray transition" id="dropZone">
                            <div class="mb-3">
                                <i class="fa-solid fa-cloud-arrow-up text-gray-400 text-4xl"></i>
                            </div>
                            <p class="text-gray-700 font-medium">Kéo thả file vào đây hoặc <span class="text-brand-button hover:underline cursor-pointer" onclick="document.getElementById('fileInput').click()">chọn file</span></p>
                            <p class="text-gray-500 text-sm mt-1">PDF, DOCX, PPTX — tối đa 50 MB</p>
                            <input asp-for="File" type="file" id="fileInput" accept=".pdf,.docx,.pptx" style="display:none" />
                        </div>
                        <div id="filePreview" class="file-preview hidden mt-4 p-4 bg-gray-50 border border-gray-200 rounded-lg flex items-center space-x-4">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 bg-brand-button/10 rounded-lg flex items-center justify-center">
                                    <i id="fileIcon" class="fa-solid fa-file text-brand-button text-xl"></i>
                                </div>
                            </div>
                            <div class="flex-1">
                                <div id="fileName" class="font-medium text-gray-800"></div>
                                <div id="fileSize" class="text-sm text-gray-500"></div>
                            </div>
                            <button type="button" class="text-gray-400 hover:text-red-500" onclick="clearFile()">
                                <i class="fa-solid fa-xmark text-xl"></i>
                            </button>
                        </div>
                        <span asp-validation-for="File" class="text-red-500 text-xs mt-1 block"></span>
                        <div id="fileSizeError" class="text-red-500 text-xs mt-1 hidden">File vượt quá giới hạn 50 MB.</div>
                    </div>

                    <!-- Progress & Console Logs (Hidden by default) -->
                    <div id="uploadProgressSection" class="hidden mb-6 space-y-4">
                        <!-- Progress Bar -->
                        <div>
                            <div class="flex justify-between text-sm font-semibold text-gray-700 mb-1">
                                <span id="progressStatusText">Đang chuẩn bị tải lên...</span>
                                <span id="progressPercentText">0%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
                                <div id="progressBarFill" class="bg-brand-button h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- Terminal-like Console Log Panel -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                💻 Tiến trình xử lý hệ thống (Real-time Logs)
                            </label>
                            <div id="terminalLog" class="w-full bg-gray-900 text-green-400 font-mono text-[11px] p-4 rounded-xl h-48 overflow-y-auto border border-gray-800 shadow-inner space-y-1 scrollbar-thin scrollbar-thumb-gray-800 scrollbar-track-gray-900">
                                <div class="text-gray-500">[System] Sẵn sàng tải lên tài liệu...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-3">
                        <button type="submit" class="flex-1 bg-brand-button hover:bg-brand-active text-white font-medium py-2.5 px-6 rounded-xl transition shadow-sm" id="submitBtn">
                            <i class="fa-solid fa-upload mr-2"></i>Tải lên tài liệu
                        </button>
                        <a asp-action="Index" class="px-6 py-2.5 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-medium rounded-xl transition">
                            Huỷ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        const MAX_SIZE_MB = 50;
        const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;

        const fileInput = document.getElementById('fileInput');
        const dropZone = document.getElementById('dropZone');
        const filePreview = document.getElementById('filePreview');
        const fileSizeError = document.getElementById('fileSizeError');
        const submitBtn = document.getElementById('submitBtn');

        fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

        dropZone.addEventListener('dragover', e => {
            e.preventDefault();
            dropZone.classList.add('border-brand-button', 'bg-brand-gray');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-brand-button', 'bg-brand-gray');
        });
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('border-brand-button', 'bg-brand-gray');
            const file = e.dataTransfer.files[0];
            if (file) {
                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
                handleFile(file);
            }
        });
        dropZone.addEventListener('click', () => fileInput.click());

        function handleFile(file) {
            if (!file) return;
            const ext = file.name.split('.').pop().toLowerCase();
            fileSizeError.classList.add('hidden');

            if (file.size > MAX_SIZE_BYTES) {
                fileSizeError.classList.remove('hidden');
                submitBtn.disabled = true;
                return;
            }
            submitBtn.disabled = false;

            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = formatSize(file.size);
            
            const badge = document.getElementById('fileIcon');
            switch(ext) {
                case 'pdf': badge.className = 'fa-solid fa-file-pdf text-red-500'; break;
                case 'docx': badge.className = 'fa-solid fa-file-word text-blue-500'; break;
                case 'pptx': badge.className = 'fa-solid fa-file-powerpoint text-orange-500'; break;
                default: badge.className = 'fa-solid fa-file text-gray-500';
            }
            
            filePreview.classList.remove('hidden');
            dropZone.classList.add('hidden');
        }

        function clearFile() {
            fileInput.value = '';
            filePreview.classList.add('hidden');
            dropZone.classList.remove('hidden');
            fileSizeError.classList.add('hidden');
            submitBtn.disabled = false;
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        const subjectSelect = document.getElementById('subjectSelect');
        const chapterSelect = document.getElementById('chapterSelect');

        subjectSelect.addEventListener('change', async function () {
            const subjectId = this.value;
            chapterSelect.innerHTML = '<option value="">— Chọn chương (tuỳ chọn) —</option>';
            if (!subjectId) return;

            try {
                const res = await fetch(`/Document/GetChaptersBySubject?subjectId=${subjectId}`);
                const data = await res.json();
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.title;
                    chapterSelect.appendChild(opt);
                });
            } catch (e) {
                console.warn('Không thể load chapters:', e);
            }
        });

        function generateUUID() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        const uploadForm = document.getElementById('uploadForm');
        uploadForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const titleInput = document.getElementById('Title');
            const subjectInput = document.getElementById('subjectSelect');
            const chapterInput = document.getElementById('chapterSelect');
            
            // Clear validation messages
            document.querySelectorAll('[data-valmsg-for]').forEach(span => span.textContent = '');

            let hasError = false;
            if (!titleInput.value.trim()) {
                const titleErrorSpan = document.querySelector('[data-valmsg-for="Title"]');
                if (titleErrorSpan) titleErrorSpan.textContent = 'Vui lòng nhập tiêu đề tài liệu';
                hasError = true;
            }
            if (!subjectInput.value) {
                const subjectErrorSpan = document.querySelector('[data-valmsg-for="SubjectId"]');
                if (subjectErrorSpan) subjectErrorSpan.textContent = 'Vui lòng chọn môn học';
                hasError = true;
            }
            if (!fileInput.files || fileInput.files.length === 0) {
                const fileErrorSpan = document.querySelector('[data-valmsg-for="File"]');
                if (fileErrorSpan) fileErrorSpan.textContent = 'Vui lòng chọn file để tải lên';
                hasError = true;
            }

            if (hasError) return;

            const file = fileInput.files[0];
            
            // Show progress and console section
            const progressSection = document.getElementById('uploadProgressSection');
            const progressStatusText = document.getElementById('progressStatusText');
            const progressPercentText = document.getElementById('progressPercentText');
            const progressBarFill = document.getElementById('progressBarFill');
            const terminalLog = document.getElementById('terminalLog');
            
            progressSection.classList.remove('hidden');
            terminalLog.innerHTML = '';
            
            function logToTerminal(message, type = 'info') {
                const div = document.createElement('div');
                const timestamp = new Date().toLocaleTimeString();
                let colorClass = 'text-green-400';
                if (type === 'error') colorClass = 'text-red-400';
                if (type === 'success') colorClass = 'text-teal-300 font-semibold';
                if (type === 'system') colorClass = 'text-gray-500';
                
                div.className = `${colorClass} leading-relaxed`;
                div.innerHTML = `<span class="text-gray-600">[${timestamp}]</span> ${message}`;
                terminalLog.appendChild(div);
                terminalLog.scrollTop = terminalLog.scrollHeight;
            }

            logToTerminal('Khởi tạo kết nối upload phân đoạn...', 'system');
            logToTerminal(`Thông tin file: ${file.name} (${formatSize(file.size)})`, 'info');

            // Slicing parameters: 2MB per chunk
            const CHUNK_SIZE = 2 * 1024 * 1024;
            const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
            const fileGuid = generateUUID();
            
            logToTerminal(`Cấu hình Chunk Size: 2MB. Tổng số mảnh sẽ cắt: ${totalChunks}`, 'info');

            // Disable buttons
            submitBtn.disabled = true;
            const cancelBtn = submitBtn.nextElementSibling;
            if (cancelBtn) {
                cancelBtn.classList.add('pointer-events-none', 'opacity-50');
            }

            // Sequential upload
            for (let i = 0; i < totalChunks; i++) {
                const start = i * CHUNK_SIZE;
                const end = Math.min(start + CHUNK_SIZE, file.size);
                const chunk = file.slice(start, end);

                logToTerminal(`[Cắt file] Tiến hành cắt phân đoạn ${i+1}/${totalChunks} (Bytes: ${start} - ${end})...`, 'info');

                const formData = new FormData();
                formData.append('file', chunk);
                formData.append('chunkIndex', i);
                formData.append('totalChunks', totalChunks);
                formData.append('fileName', file.name);
                formData.append('fileGuid', fileGuid);
                formData.append('title', titleInput.value.trim());
                formData.append('subjectId', subjectInput.value);
                if (chapterInput.value) {
                    formData.append('chapterId', chapterInput.value);
                }

                progressStatusText.textContent = `Đang tải lên phân đoạn ${i+1}/${totalChunks}...`;
                
                try {
                    const response = await fetch('/Document/UploadChunk', {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const result = await response.json();
                    
                    if (result.success) {
                        const percent = Math.round(((i + 1) / totalChunks) * 100);
                        progressBarFill.style.width = `${percent}%`;
                        progressPercentText.textContent = `${percent}%`;
                        
                        logToTerminal(`[Tải lên] Truyền tải thành công mảnh ${i+1}/${totalChunks}.`, 'success');
                        
                        if (i === totalChunks - 1) {
                            logToTerminal('[Máy chủ] Đang tiến hành ghép các phân đoạn tệp tin thành file hoàn chỉnh...', 'system');
                            logToTerminal('[Máy chủ] Đang tạo mã SHA-256 và kiểm tra trùng lặp trên CSDL...', 'system');
                            
                            if (result.document) {
                                logToTerminal(`[Kiểm tra] Thành công! Không trùng lặp tài liệu nào khác.`, 'success');
                                logToTerminal(`[SHA-256 Hash] ${result.document.fileHash}`, 'success');
                                logToTerminal(`[Cơ sở dữ liệu] Ghi nhận metadata thành công. Document ID: ${result.document.id}`, 'success');
                                progressStatusText.textContent = 'Tải lên hoàn tất!';
                                logToTerminal('Tải lên thành công! Đang tự động chuyển hướng về trang chi tiết tài liệu...', 'system');
                                setTimeout(() => {
                                    window.location.href = `/Document/Details/${result.document.id}`;
                                }, 2000);
                            } else {
                                logToTerminal(`[Lỗi] Phản hồi thành công nhưng thiếu thông tin chi tiết tài liệu từ máy chủ.`, 'error');
                                submitBtn.disabled = false;
                                if (cancelBtn) cancelBtn.classList.remove('pointer-events-none', 'opacity-50');
                            }
                        }
                    } else {
                        logToTerminal(`[Thất bại] Lỗi từ máy chủ: ${result.message}`, 'error');
                        progressStatusText.textContent = 'Tải lên thất bại.';
                        submitBtn.disabled = false;
                        if (cancelBtn) cancelBtn.classList.remove('pointer-events-none', 'opacity-50');
                        return; // Stop the loop
                    }
                } catch (error) {
                    logToTerminal(`[Lỗi mạng] Không thể kết nối hoặc lỗi truyền tải phân đoạn ${i+1}. Lỗi: ${error.message}`, 'error');
                    progressStatusText.textContent = 'Lỗi kết nối mạng.';
                    submitBtn.disabled = false;
                    if (cancelBtn) cancelBtn.classList.remove('pointer-events-none', 'opacity-50');
                    return; // Stop the loop
                }
            }
        });
    </script>
</body>
</html>
