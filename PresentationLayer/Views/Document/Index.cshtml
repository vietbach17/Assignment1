@model BussinessLayer.DTOs.DocumentListViewModel
@using BussinessLayer.DTOs
@{
    ViewData["Title"] = "Quản lý Tài liệu";
    Layout = null;
    var canUploadDocuments = ViewBag.CanUploadDocuments as bool? ?? false;
    var managedSubjectIds = ViewBag.ManagedSubjectIds as List<int> ?? new List<int>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Quản lý tài liệu</p>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3  bg-brand-active px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-chart-line w-5"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-users w-5"></i>
                            <span>Người Dùng</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Admin" asp-controller="Subscription" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium">
                            <i class="fa-solid fa-box-open w-5"></i>
                            <span>Gói Subscription</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Về trang chủ</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-border-all w-5"></i>
                            <span>Tổng quan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 bg-brand-active text-white px-4 py-2.5 rounded-lg text-sm font-medium transition">
                            <i class="fa-regular fa-file-lines w-5"></i>
                            <span>Tài liệu</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="relative w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Tìm kiếm tài liệu..." class="w-full bg-gray-50 border-none rounded-full pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-button">
            </div>
            
            <div class="flex items-center space-x-5">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="text-gray-400 hover:text-gray-600 relative">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <div class="flex items-center space-x-3 cursor-pointer">
                        <div class="w-9 h-9 bg-teal-100 text-teal-700 rounded-full flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-700 leading-tight">@User.Identity.Name</p>
                            <p class="text-xs text-gray-500">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8">
                <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase mb-1">Không gian giảng viên</p>
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Kho Học Liệu & Tài Liệu</h2>
                <p class="text-gray-500 text-sm">Quản lý tài liệu PDF, DOCX, PPTX theo môn học và chương.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm">
                    <i class="fa-solid fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    <i class="fa-solid fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-6">
                @if (canUploadDocuments)
                {
                <div class="lg:col-span-3 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-lg font-bold text-gray-800">Tải tài liệu mới</h3>
                            <p class="text-sm text-gray-500 mt-1">Hỗ trợ PDF, DOCX, PPTX tối đa 50MB</p>
                        </div>
                        <button class="w-10 h-10 rounded-full bg-brand-gray flex items-center justify-center text-brand-button hover:bg-gray-200 transition">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </button>
                    </div>
                    <a asp-action="Upload" class="w-full bg-brand-button hover:bg-brand-active text-white font-medium py-3 rounded-xl transition shadow-sm inline-block text-center">
                        Tiến hành tải tài liệu
                    </a>
                </div>

                }

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Bộ lọc</h3>
                    <form method="get" asp-action="Index" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Môn học</label>
                            <select name="subjectId" onchange="this.form.submit()" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-brand-button">
                                <option value="">— Tất cả môn học —</option>
                                @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                                {
                                    if (item.Selected)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Trạng thái</label>
                            <select name="status" onchange="this.form.submit()" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-brand-button">
                                <option value="">— Tất cả —</option>
                                @{
                                    var fPending = Model.FilterStatus == DocumentStatus.Pending;
                                    var fIndexed = Model.FilterStatus == DocumentStatus.Indexed;
                                    var fFailed  = Model.FilterStatus == DocumentStatus.Failed;
                                }
                                <option value="0" selected="@fPending">🟡 Pending</option>
                                <option value="1" selected="@fIndexed">🟢 Indexed</option>
                                <option value="2" selected="@fFailed">🔴 Failed</option>
                            </select>
                        </div>
                        <div class="pt-2 text-sm text-gray-600">
                            <strong>@Model.TotalCount</strong> tài liệu
                        </div>
                    </form>
                </div>
            </div>

            @if (!Model.Documents.Any())
            {
                <div class="bg-white p-12 rounded-2xl shadow-sm border border-gray-100 text-center">
                    <i class="fa-regular fa-folder-open text-4xl text-gray-300 mb-4 block"></i>
                    <h3 class="text-lg font-bold text-gray-800 mb-2">Chưa có tài liệu nào</h3>
                    <p class="text-gray-500 text-sm mb-6">Chưa có tài liệu nào phù hợp với bộ lọc hiện tại.</p>
                    @if (canUploadDocuments)
                    {
                        <a asp-action="Upload" class="inline-block bg-brand-button hover:bg-brand-active text-white font-medium py-2 px-6 rounded-xl transition">
                            Tải lên ngay
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-between">
                            <div class="flex items-center space-x-4 flex-1">
                                <div class="flex-shrink-0">
                                    @switch (doc.FileType)
                                    {
                                        case "pdf":
                                            <div class="w-10 h-10 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center">
                                                <i class="fa-solid fa-file-pdf"></i>
                                            </div>
                                            break;
                                        case "docx":
                                            <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">
                                                <i class="fa-solid fa-file-word"></i>
                                            </div>
                                            break;
                                        case "pptx":
                                            <div class="w-10 h-10 bg-red-100 text-red-600 rounded-lg flex items-center justify-center">
                                                <i class="fa-solid fa-file-powerpoint"></i>
                                            </div>
                                            break;
                                        default:
                                            <div class="w-10 h-10 bg-gray-100 text-gray-600 rounded-lg flex items-center justify-center">
                                                <i class="fa-solid fa-file"></i>
                                            </div>
                                            break;
                                    }
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-sm font-semibold text-gray-800">@doc.Title</h4>
                                    <p class="text-xs text-gray-500 mt-1">
                                        Môn: <strong>@doc.SubjectCode</strong>
                                        @if (!string.IsNullOrEmpty(doc.ChapterTitle))
                                        {
                                            <span>• @doc.ChapterTitle</span>
                                        }
                                        <span>• @doc.FileSizeDisplay</span>
                                        <span>• @doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center space-x-3">
                                @switch (doc.Status)
                                {
                                    case DocumentStatus.Pending:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">🟡 Pending</span>
                                        break;
                                    case DocumentStatus.Indexed:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">🟢 Indexed</span>
                                        break;
                                    case DocumentStatus.Failed:
                                        <span class="inline-block px-3 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">🔴 Failed</span>
                                        break;
                                }

                                <div class="flex items-center space-x-2">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="px-3 py-1.5 text-sm text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition">
                                        <i class="fa-solid fa-eye mr-1"></i>Chi tiết
                                    </a>
                                    <a asp-action="Download" asp-route-id="@doc.Id" class="px-3 py-1.5 text-sm text-green-600 hover:text-green-800 hover:bg-green-50 rounded-lg transition">
                                        <i class="fa-solid fa-download mr-1"></i>Tải về
                                    </a>
                                    @if (managedSubjectIds.Contains(doc.SubjectId))
                                    {
                                        <a asp-action="Edit" asp-route-id="@doc.Id" class="px-3 py-1.5 text-sm text-yellow-600 hover:text-yellow-800 hover:bg-yellow-50 rounded-lg transition">
                                            <i class="fa-solid fa-pen mr-1"></i>Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@doc.Id" class="px-3 py-1.5 text-sm text-red-600 hover:text-red-800 hover:bg-red-50 rounded-lg transition">
                                            <i class="fa-solid fa-trash mr-1"></i>Xoá
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </main>

</body>
</html>
