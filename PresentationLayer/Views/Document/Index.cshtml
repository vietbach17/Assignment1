@model BussinessLayer.DTOs.DocumentListViewModel
@using BussinessLayer.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quản lý tài liệu";
    ViewBag.ActiveMenu = "Document";
    var canUploadDocuments = ViewBag.CanUploadDocuments as bool? ?? false;
    var managedSubjectIds = ViewBag.ManagedSubjectIds as List<int> ?? new List<int>();
    string FileBadge(string ft) => ft switch { "pdf" => "badge-red", "docx" => "badge-blue", "pptx" => "badge-yellow", _ => "badge-gray" };
    string FileIcon(string ft) => ft switch { "pdf" => "fa-file-pdf", "docx" => "fa-file-word", "pptx" => "fa-file-powerpoint", _ => "fa-file" };
    string StatusBadge(DocumentStatus s) => s switch { DocumentStatus.Indexed => "badge-green", DocumentStatus.Pending => "badge-yellow", _ => "badge-red" };
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle">KHO HỌC LIỆU</div>
            <h1 class="page-title">Tài liệu học tập</h1>
            <p class="page-subtitle">Quản lý tài liệu PDF, DOCX, PPTX theo môn học và chương.</p>
        </div>
        @if (canUploadDocuments)
        {
            <a asp-action="Upload" class="brutal-btn btn-pink"><i class="fa-solid fa-cloud-arrow-up"></i> Tải tài liệu mới</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <!-- Filter -->
    <div class="brutal-card" style="margin-bottom:22px;">
        <form method="get" asp-action="Index" style="display:flex; gap:16px; align-items:flex-end; flex-wrap:wrap;">
            <div class="form-group" style="margin:0; min-width:220px;">
                <label>Môn học</label>
                <select name="subjectId" onchange="this.form.submit()">
                    <option value="">— Tất cả môn học —</option>
                    @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                    {
                        if (item.Selected)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group" style="margin:0; min-width:180px;">
                <label>Trạng thái</label>
                @{
                    var fPending = Model.FilterStatus == DocumentStatus.Pending;
                    var fIndexed = Model.FilterStatus == DocumentStatus.Indexed;
                    var fFailed = Model.FilterStatus == DocumentStatus.Failed;
                }
                <select name="status" onchange="this.form.submit()">
                    <option value="">— Tất cả —</option>
                    <option value="0" selected="@fPending">Pending</option>
                    <option value="1" selected="@fIndexed">Indexed</option>
                    <option value="2" selected="@fFailed">Failed</option>
                </select>
            </div>
            <div style="font-weight:800; padding-bottom:10px;"><span class="badge badge-pink">@Model.TotalCount</span> tài liệu</div>
        </form>
    </div>

    @if (!Model.Documents.Any())
    {
        <div class="brutal-card" style="text-align:center; padding:48px;">
            <i class="fa-regular fa-folder-open" style="font-size:40px; color:#ccc;"></i>
            <h3 class="card-title" style="margin:12px 0 6px;">Chưa có tài liệu nào</h3>
            <p class="text-muted" style="font-weight:700; margin-bottom:16px;">Chưa có tài liệu nào phù hợp với bộ lọc hiện tại.</p>
            @if (canUploadDocuments)
            {
                <a asp-action="Upload" class="brutal-btn btn-pink"><i class="fa-solid fa-cloud-arrow-up"></i> Tải lên ngay</a>
            }
        </div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var doc in Model.Documents)
            {
                <div class="brutal-card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px; flex-wrap:wrap;">
                    <div style="display:flex; align-items:center; gap:14px; min-width:0; flex:1;">
                        <span class="badge @FileBadge(doc.FileType)" style="font-size:14px; padding:8px 10px;"><i class="fa-solid @FileIcon(doc.FileType)"></i></span>
                        <div style="min-width:0;">
                            <h4 style="font-weight:900;">@doc.Title</h4>
                            <p class="page-subtitle">
                                Môn: <strong>@doc.SubjectCode</strong>
                                @if (!string.IsNullOrEmpty(doc.ChapterTitle))
                                {
                                    <span>• @doc.ChapterTitle</span>
                                }
                                <span>• @doc.FileSizeDisplay</span>
                                <span>• @doc.UploadedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </p>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span class="badge @StatusBadge(doc.Status)">@doc.Status</span>
                        <a asp-action="Details" asp-route-id="@doc.Id" class="brutal-btn btn-blue sm"><i class="fa-solid fa-eye"></i> Chi tiết</a>
                        <a asp-action="Download" asp-route-id="@doc.Id" class="brutal-btn btn-green sm"><i class="fa-solid fa-download"></i> Tải</a>
                        @if (managedSubjectIds.Contains(doc.SubjectId))
                        {
                            <a asp-action="Edit" asp-route-id="@doc.Id" class="brutal-btn btn-yellow sm"><i class="fa-solid fa-pen"></i> Sửa</a>
                            <a asp-action="Delete" asp-route-id="@doc.Id" class="brutal-btn btn-red sm"><i class="fa-solid fa-trash"></i> Xoá</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
