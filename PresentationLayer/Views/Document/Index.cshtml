@{
    ViewData["Title"] = "Thư viện Tài liệu Giảng viên";
}

<div class="document-container">
    <div class="welcome-banner glass-card">
        <div class="banner-text">
            <h1>📚 Kho Học Liệu & Bài Giảng (Lecturer)</h1>
            <p>Xin chào Giảng viên! Nơi đây lưu trữ giáo trình, slide bài giảng, đề thi và các tài liệu chuyên ngành.</p>
        </div>
        <span class="banner-badge role-badge role-lecturer">Giảng Dạy</span>
    </div>

    <div class="library-workspace">
        <!-- Sidebar - Categories -->
        <div class="glass-card library-sidebar">
            <h3 class="sidebar-title">📁 Danh mục tài liệu</h3>
            <ul class="category-list">
                <li class="category-item active">📂 Tất cả tài liệu</li>
                <li class="category-item">📘 Slide Bài giảng</li>
                <li class="category-item">📙 Đề kiểm tra & Đề thi</li>
                <li class="category-item">📗 Giáo trình chính thức</li>
                <li class="category-item">📝 Bài tập lớn (Project)</li>
            </ul>
            <button class="btn-primary upload-btn" onclick="alert('Tính năng tải lên tài liệu mới đang được phát triển!')">➕ Tải lên tài liệu</button>
        </div>

        <!-- Main - Document Grid -->
        <div class="glass-card library-main">
            <div class="main-header">
                <h2 class="card-title">📄 Danh sách tài liệu hiện hành</h2>
                <span class="doc-count">4 tài liệu đã nạp</span>
            </div>

            <div class="doc-grid">
                <!-- Doc 1 -->
                <div class="doc-card">
                    <div class="doc-icon">📘</div>
                    <div class="doc-info">
                        <h4 class="doc-name">Slide_01_Introduction_to_C_Sharp.pptx</h4>
                        <p class="doc-meta">Kích thước: 4.8 MB • Cập nhật: 2 giờ trước</p>
                    </div>
                    <div class="doc-actions">
                        <button class="btn-action" onclick="alert('Đang tải file...')">⬇️ Tải về</button>
                        <button class="btn-action btn-share" onclick="alert('Đã chia sẻ link cho sinh viên!')">🔗 Chia sẻ</button>
                    </div>
                </div>

                <!-- Doc 2 -->
                <div class="doc-card">
                    <div class="doc-icon">📘</div>
                    <div class="doc-info">
                        <h4 class="doc-name">Slide_02_Entity_Framework_Core_PostgreSQL.pptx</h4>
                        <p class="doc-meta">Kích thước: 6.2 MB • Cập nhật: Hôm qua</p>
                    </div>
                    <div class="doc-actions">
                        <button class="btn-action" onclick="alert('Đang tải file...')">⬇️ Tải về</button>
                        <button class="btn-action btn-share" onclick="alert('Đã chia sẻ link cho sinh viên!')">🔗 Chia sẻ</button>
                    </div>
                </div>

                <!-- Doc 3 -->
                <div class="doc-card">
                    <div class="doc-icon">📙</div>
                    <div class="doc-info">
                        <h4 class="doc-name">De_Thi_Giua_Ky_Mon_NET8_MVC.docx</h4>
                        <p class="doc-meta">Kích thước: 1.1 MB • Cập nhật: 3 ngày trước</p>
                    </div>
                    <div class="doc-actions">
                        <button class="btn-action" onclick="alert('Đang tải file...')">⬇️ Tải về</button>
                        <button class="btn-action btn-share" onclick="alert('Đã chia sẻ link cho sinh viên!')">🔗 Chia sẻ</button>
                    </div>
                </div>

                <!-- Doc 4 -->
                <div class="doc-card">
                    <div class="doc-icon">📗</div>
                    <div class="doc-info">
                        <h4 class="doc-name">Giao_Trinh_Kien_Truc_Phan_Mem_3Layers.pdf</h4>
                        <p class="doc-meta">Kích thước: 18.5 MB • Cập nhật: Tuần trước</p>
                    </div>
                    <div class="doc-actions">
                        <button class="btn-action" onclick="alert('Đang tải file...')">⬇️ Tải về</button>
                        <button class="btn-action btn-share" onclick="alert('Đã chia sẻ link cho sinh viên!')">🔗 Chia sẻ</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .document-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .welcome-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2.5rem;
        background: linear-gradient(135deg, rgba(22, 30, 49, 0.7) 0%, rgba(249, 115, 22, 0.1) 100%);
    }

    .banner-text h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .banner-text p {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .banner-badge {
        font-size: 0.9rem;
        padding: 0.4rem 1rem;
    }

    /* Library Workspace */
    .library-workspace {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2rem;
    }

    @@media (max-width: 768px) {
        .library-workspace {
            grid-template-columns: 1fr;
        }
    }

    /* Sidebar */
    .library-sidebar {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        height: fit-content;
    }

    .sidebar-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #ffffff;
    }

    .category-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        list-style: none;
    }

    .category-item {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
        color: var(--text-secondary);
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    .category-item:hover {
        background-color: rgba(255, 255, 255, 0.04);
        color: #ffffff;
    }

    .category-item.active {
        background-color: rgba(249, 115, 22, 0.1);
        color: #fb923c;
        border-left: 3px solid var(--accent-orange);
        font-weight: 500;
    }

    .upload-btn {
        width: 100%;
    }

    /* Library Main */
    .library-main {
        padding: 2rem;
    }

    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1rem;
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: 600;
    }

    .doc-count {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    /* Doc Grid */
    .doc-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .doc-card {
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.25rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1.25rem;
        align-items: center;
        transition: var(--transition-smooth);
    }

    @@media (max-width: 600px) {
        .doc-card {
            grid-template-columns: 1fr;
            text-align: center;
            justify-items: center;
        }
    }

    .doc-card:hover {
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.12);
        transform: translateY(-2px);
    }

    .doc-icon {
        font-size: 2.25rem;
    }

    .doc-info {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .doc-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffffff;
        word-break: break-all;
    }

    .doc-meta {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .doc-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-action {
        background-color: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border-color);
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    .btn-action:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-share {
        background-color: rgba(249, 115, 22, 0.08);
        color: #fb923c;
        border-color: rgba(249, 115, 22, 0.2);
    }

    .btn-share:hover {
        background-color: var(--accent-orange);
        color: #ffffff;
        border-color: var(--accent-orange);
    }
</style>
