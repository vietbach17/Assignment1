@model IEnumerable<BussinessLayer.DTOs.ChapterDto>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Chương - {ViewBag.SubjectCode}";
    ViewBag.ActiveMenu = "Subjects";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-controller="Subjects" asp-action="Index" class="text-pink">Môn học</a> › Các chương</div>
            <h1 class="page-title">Danh sách chương: @ViewBag.SubjectCode</h1>
            <p class="page-subtitle">Xem và quản lý các chương học thuộc môn học này.</p>
        </div>
        @if (ViewBag.CanManageChapters == true)
        {
            <a asp-action="Create" asp-route-subjectId="@ViewBag.SubjectId" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Thêm chương mới</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error"><i class="fa-solid fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="brutal-card" style="text-align:center; padding:48px;">
            <i class="fa-solid fa-list-ul" style="font-size:40px; color:#ccc;"></i>
            <h3 class="card-title" style="margin:12px 0 6px;">Chưa có chương học nào</h3>
            <p class="text-muted" style="font-weight:700; margin-bottom:16px;">Môn học này hiện chưa được tạo cấu trúc chương.</p>
            @if (ViewBag.CanManageChapters == true)
            {
                <a asp-action="Create" asp-route-subjectId="@ViewBag.SubjectId" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Tạo chương đầu tiên</a>
            }
        </div>
    }
    else
    {
        <div class="brutal-card pad0">
            <div style="padding:15px 20px; overflow-x:auto;">
                <table class="brutal-table">
                    <thead>
                        <tr><th>Chương</th><th>Tên chương</th><th>Mô tả</th><th style="text-align:right;">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var chapter in Model)
                        {
                            <tr>
                                <td>
                                    <div style="width:38px; height:38px; border:2px solid var(--black); background:var(--yellow); display:flex; align-items:center; justify-content:center; font-weight:900;">@chapter.ChapterNumber</div>
                                </td>
                                <td style="font-weight:900;">@chapter.ChapterTitle</td>
                                <td class="text-muted" style="max-width:320px;">
                                    @if (!string.IsNullOrEmpty(chapter.Description))
                                    {
                                        @(chapter.Description.Length > 80 ? chapter.Description.Substring(0, 80) + "..." : chapter.Description)
                                    }
                                    else
                                    {
                                        <span style="font-style:italic; opacity:0.6;">Không có mô tả</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:6px; justify-content:flex-end;">
                                        <a asp-action="Details" asp-route-id="@chapter.Id" class="brutal-btn btn-blue sm" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                                        @if (ViewBag.CanManageChapters == true)
                                        {
                                            <a asp-action="Edit" asp-route-id="@chapter.Id" class="brutal-btn btn-yellow sm" title="Sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                            <a asp-action="Delete" asp-route-id="@chapter.Id" class="brutal-btn btn-red sm" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
