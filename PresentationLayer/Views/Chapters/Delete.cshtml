@model BussinessLayer.DTOs.ChapterDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Xóa chương học";
    ViewBag.ActiveMenu = "Subjects";
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-controller="Subjects" asp-action="Index" class="text-pink">Môn học</a> › <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="text-pink">Các chương</a> › Xóa</div>
            <h1 class="page-title" style="color:#d11;">Xóa chương học</h1>
        </div>
        <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:640px; border-color:#d11; margin:0 auto;">
        <div class="alert alert-error" style="align-items:flex-start;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:20px;"></i>
            <div>
                <div style="font-weight:900;">Cảnh báo: Bạn đang chuẩn bị xóa chương học!</div>
                <div style="font-weight:600;">Hành động này không thể hoàn tác và các tài liệu thuộc chương này có thể bị mất.</div>
            </div>
        </div>

        <div style="border:2px solid var(--black); padding:16px; margin-bottom:16px;">
            <div class="text-green" style="font-size:11px; font-weight:900; text-transform:uppercase;">Chương @Model.ChapterNumber</div>
            <h3 class="card-title" style="margin-top:4px;">@Model.ChapterTitle</h3>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div style="margin-top:10px; font-weight:600;">@(Model.Description.Length > 150 ? Model.Description.Substring(0, 150) + "..." : Model.Description)</div>
            }
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SubjectId" />
            <div style="display:flex; gap:12px; margin-top:8px;">
                <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="brutal-btn" style="flex:1;">Hủy bỏ, quay lại</a>
                <button type="submit" class="brutal-btn btn-red" style="flex:1;"><i class="fa-solid fa-trash-can"></i> Xác nhận xóa</button>
            </div>
        </form>
    </div>
</div>
