@model BussinessLayer.DTOs.CreateChapterDto
@{
    ViewData["Title"] = "Thêm Chương Mới";
    Layout = null;
    var subjects = ViewBag.Subjects as IEnumerable<BussinessLayer.DTOs.SubjectDto>;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: '#1e3b31',
                            active: '#2c5344',
                            button: '#376b56',
                            text: '#222222',
                            gray: '#f4f6f8'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-brand-dark text-white flex flex-col">
        <div class="p-6 flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg">
                <i class="fa-solid fa-book-open text-white"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">StudyMind</h1>
                <p class="text-xs text-gray-300">Quản lý nội dung</p>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Dashboard" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-chart-line w-5"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Users" asp-controller="Admin" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-users w-5"></i>
                            <span>Người Dùng</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-arrow-left w-5"></i>
                            <span>Về trang chủ</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <div class="px-4 py-2">
                <p class="text-xs font-semibold text-gray-400 mb-3 uppercase tracking-wider">Menu Chính</p>
                <ul class="space-y-1">
                    <li>
                        <a asp-action="Index" asp-controller="Home" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-border-all w-5"></i>
                            <span>Tổng quan</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Subjects" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-solid fa-book w-5"></i>
                            <span>Môn Học</span>
                        </a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Document" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                            <i class="fa-regular fa-file-lines w-5"></i>
                            <span>Tài liệu</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="px-4 py-6 border-t border-white/5 mt-auto">
            <a asp-action="Logout" asp-controller="Auth" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:bg-brand-active/50 hover:text-white transition">
                <i class="fa-solid fa-sign-out-alt w-5"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen overflow-hidden">
        <header class="h-16 bg-white flex items-center justify-between px-8 border-b border-gray-100">
            <div class="flex items-center gap-4 text-sm text-gray-500">
                <a asp-controller="Subjects" asp-action="Index" class="hover:text-brand-active transition">Môn học</a>
                <i class="fa-solid fa-chevron-right text-xs"></i>
                <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="hover:text-brand-active transition">Các chương</a>
                <i class="fa-solid fa-chevron-right text-xs"></i>
                <span class="font-semibold text-gray-800">Thêm mới</span>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="max-w-2xl mx-auto">
                <div class="mb-8 text-center">
                    <h2 class="text-3xl font-bold text-gray-800 mb-2">Thêm Chương Mới</h2>
                    <p class="text-gray-500">Nhập thông tin chi tiết cho chương học.</p>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
                    <form asp-action="Create" method="post" class="space-y-6">
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>
                        
                        <div>
                            <label asp-for="SubjectId" class="block text-sm font-medium text-gray-700 mb-2">Thuộc Môn học <span class="text-red-500">*</span></label>
                            <select asp-for="SubjectId" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-active focus:bg-white transition cursor-pointer">
                                <option value="">-- Chọn Môn học --</option>
                                @if (subjects != null)
                                {
                                    foreach (var subject in subjects)
                                    {
                                        <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">
                                            @subject.SubjectCode - @subject.SubjectName
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SubjectId" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ChapterNumber" class="block text-sm font-medium text-gray-700 mb-2">Số thứ tự chương <span class="text-red-500">*</span></label>
                            <input asp-for="ChapterNumber" type="number" min="1" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-active focus:bg-white transition" placeholder="Ví dụ: 1, 2, 3..." />
                            <span asp-validation-for="ChapterNumber" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ChapterTitle" class="block text-sm font-medium text-gray-700 mb-2">Tên chương <span class="text-red-500">*</span></label>
                            <input asp-for="ChapterTitle" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-active focus:bg-white transition" placeholder="Nhập tiêu đề chương..." />
                            <span asp-validation-for="ChapterTitle" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">Mô tả chi tiết</label>
                            <textarea asp-for="Description" rows="4" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-active focus:bg-white transition resize-none" placeholder="Nhập mô tả nội dung chương..."></textarea>
                            <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div class="pt-4 flex gap-4">
                            <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-3 rounded-xl transition text-center">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="flex-1 bg-brand-button hover:bg-brand-active text-white font-medium py-3 rounded-xl transition shadow-sm">
                                Tạo Chương
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
