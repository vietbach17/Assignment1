@model BussinessLayer.DTOs.CreateChapterDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Thêm chương mới";
    ViewBag.ActiveMenu = "Subjects";
    var subjects = ViewBag.Subjects as IEnumerable<BussinessLayer.DTOs.SubjectDto>;
}

<div class="page-content">
    <div class="page-header">
        <div>
            <div class="page-subtitle"><a asp-controller="Subjects" asp-action="Index" class="text-pink">Môn học</a> › <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="text-pink">Các chương</a> › Thêm mới</div>
            <h1 class="page-title">Thêm chương mới</h1>
            <p class="page-subtitle">Nhập thông tin chi tiết cho chương học.</p>
        </div>
        <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="brutal-btn"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>

    <div class="brutal-card" style="max-width:640px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
            <div class="form-group">
                <label asp-for="SubjectId">Thuộc môn học *</label>
                <select asp-for="SubjectId">
                    <option value="">-- Chọn môn học --</option>
                    @if (subjects != null)
                    {
                        foreach (var subject in subjects)
                        {
                            <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">@subject.SubjectCode - @subject.SubjectName</option>
                        }
                    }
                </select>
                <span asp-validation-for="SubjectId" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChapterNumber">Số thứ tự chương *</label>
                <input asp-for="ChapterNumber" type="number" min="1" placeholder="Ví dụ: 1, 2, 3..." />
                <span asp-validation-for="ChapterNumber" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChapterTitle">Tên chương *</label>
                <input asp-for="ChapterTitle" placeholder="Nhập tiêu đề chương..." />
                <span asp-validation-for="ChapterTitle" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Mô tả chi tiết</label>
                <textarea asp-for="Description" rows="4" placeholder="Nhập mô tả nội dung chương..."></textarea>
                <span asp-validation-for="Description" class="text-pink" style="font-size:12px;"></span>
            </div>
            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:8px;">
                <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="brutal-btn">Hủy bỏ</a>
                <button type="submit" class="brutal-btn btn-pink"><i class="fa-solid fa-plus"></i> Tạo chương</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
