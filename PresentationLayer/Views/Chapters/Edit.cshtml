@model BussinessLayer.DTOs.UpdateChapterDto

@{
    ViewData["Title"] = "Edit Chapter";
    var subjects = ViewBag.Subjects as IEnumerable<BussinessLayer.DTOs.SubjectDto>;
}

<style>
    .breadcrumb {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: var(--accent-blue);
        text-decoration: none;
        transition: var(--transition-smooth);
    }

    .breadcrumb a:hover {
        color: var(--accent-purple);
    }

    .breadcrumb-separator {
        color: var(--text-secondary);
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .form-card {
        background: var(--bg-card);
        backdrop-filter: var(--glass-blur);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 2rem;
        max-width: 700px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-label .required {
        color: var(--danger);
        margin-left: 0.25rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 0.95rem;
        transition: var(--transition-smooth);
        font-family: 'Outfit', sans-serif;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--accent-purple);
        background-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
    }

    .form-control::placeholder {
        color: var(--text-secondary);
        opacity: 0.6;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    select.form-control {
        cursor: pointer;
    }

    .text-danger {
        color: #fca5a5;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .validation-summary {
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .validation-summary ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .validation-summary li {
        color: #fca5a5;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .btn-submit {
        background: linear-gradient(135deg, var(--accent-orange) 0%, #fb923c 100%);
        color: #ffffff;
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: var(--transition-smooth);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(249, 115, 22, 0.4);
    }

    .btn-cancel {
        background-color: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border-color);
        padding: 0.75rem 2rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 500;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cancel:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .form-hint {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }
</style>

<div class="breadcrumb">
    <a asp-controller="Subjects" asp-action="Index">Subjects</a>
    <span class="breadcrumb-separator">›</span>
    <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Chapters</a>
    <span class="breadcrumb-separator">›</span>
    <span>Edit</span>
</div>

<div class="page-header">
    <h1 class="page-title">Edit Chapter</h1>
    <p class="page-subtitle">Update chapter information</p>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="SubjectId" class="form-label">
                Subject<span class="required">*</span>
            </label>
            <select asp-for="SubjectId" class="form-control">
                <option value="">-- Select Subject --</option>
                @if (subjects != null)
                {
                    foreach (var subject in subjects)
                    {
                        <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">
                            @subject.SubjectCode - @subject.SubjectName
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="SubjectId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ChapterNumber" class="form-label">
                Chapter Number<span class="required">*</span>
            </label>
            <input asp-for="ChapterNumber" type="number" class="form-control" placeholder="Enter chapter number (e.g., 1, 2, 3)" min="1" />
            <span asp-validation-for="ChapterNumber" class="text-danger"></span>
            <div class="form-hint">Must be a positive integer and unique within the subject</div>
        </div>

        <div class="form-group">
            <label asp-for="ChapterTitle" class="form-label">
                Chapter Title<span class="required">*</span>
            </label>
            <input asp-for="ChapterTitle" type="text" class="form-control" placeholder="Enter chapter title" maxlength="200" />
            <span asp-validation-for="ChapterTitle" class="text-danger"></span>
            <div class="form-hint">Maximum 200 characters</div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Description" class="form-control" placeholder="Enter chapter description (optional)" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
            <div class="form-hint">Maximum 1000 characters</div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Save Changes</button>
            <a asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
